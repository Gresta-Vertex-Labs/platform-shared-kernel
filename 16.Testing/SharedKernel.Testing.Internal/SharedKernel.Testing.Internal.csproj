<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Testing</SharedKernelTier>
    <!--
      Repo-internal test infrastructure (WO-086 P-571): never packed. Holds what only this repository's own test
      suites use and what no consuming service should inherit through a published testing package:
        - Containers/   Testcontainers fixtures (PostgreSQL, Redis, RabbitMQ, MinIO, Meilisearch, Elasticsearch,
                        Qdrant) implementing xUnit's IAsyncLifetime;
        - Persistence/  EF Core (SQLite and Npgsql) contexts, data sources and audit-ledger fakes used by the
                        06.Persistence, 13.ServiceDefaults.Persistence and 18.Idempotency test suites;
        - Messaging/    the MassTransit in-memory test-harness factory.
      Consumer-facing doubles live in the packable SharedKernel.*.Testing packages.
    -->
    <IsPackable>false</IsPackable>
    <!-- A test-helper LIBRARY, not a test project: dotnet test must not try to run it. -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Testing\SharedKernel.Testing.csproj" />
    <!-- PostgreSqlContainerFixture wraps PostgresTestServer; FakeAuditActorContext derives from TestRequestContext. -->
    <ProjectReference Include="..\SharedKernel.Persistence.Testing\SharedKernel.Persistence.Testing.csproj" />
    <ProjectReference Include="..\..\06.Persistence\SharedKernel.Persistence.Abstractions\SharedKernel.Persistence.Abstractions.csproj" />
    <ProjectReference Include="..\..\06.Persistence\SharedKernel.Persistence.EfCore\SharedKernel.Persistence.EfCore.csproj" />
    <ProjectReference Include="..\..\06.Persistence\SharedKernel.Persistence.EfCore.Auditing\SharedKernel.Persistence.EfCore.Auditing.csproj" />
    <ProjectReference Include="..\..\07.Messaging\SharedKernel.Messaging.MassTransit\SharedKernel.Messaging.MassTransit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="Testcontainers.Minio" />
    <PackageReference Include="Testcontainers.Elasticsearch" />
    <PackageReference Include="Testcontainers.Qdrant" />
    <!-- IAsyncLifetime for the container fixtures; no test runner. -->
    <PackageReference Include="xunit.core" />
    <PackageReference Include="MassTransit.TestFramework" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- MinioContainerFixture's bucket bootstrap only. -->
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>
</Project>
