    <!--
      DEVOPS RESTORE (DV-005): the centralized DefaultItemExcludes glob in Directory.Build.props is
      "*.Tests\**", which does NOT match "SharedKernel.Testing.SelfTests" (that folder ends in
      ".SelfTests", not ".Tests" - glob suffix matching, not substring). Without this explicit
      exclude, MSBuild compiles SelfTests' .cs files into this parent project too, producing
      duplicate-assembly-attribute errors (CS0579) and missing-reference errors (SelfTests
      references NSubstitute/FusionCache/HotChocolate that this project does not). Restored from
      the pre-centralization source verbatim.
    -->
    <Compile Remove="SharedKernel.Testing.SelfTests\**" />
    <EmbeddedResource Remove="SharedKernel.Testing.SelfTests\**" />
    <None Remove="SharedKernel.Testing.SelfTests\**" />
