<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Narrow exception to the no-nested-.Tests rule (WO-029, P-179): proves standalone
      testing-infrastructure helpers in SharedKernel.Testing that have no owning
      consuming-domain interface to anchor against (fluent builders, assertion-helper
      classes, faker-seeding conventions, recorder/double self-checks).
    -->
    <ProjectReference Include="..\SharedKernel.Testing.csproj" />
    <!--
      T-88/P-438/WO-065: test-only proof dependency on a real production package, mirroring the
      precedent documented at Security/ApiKeyRotationScenarioBuilderTests.cs (T-84) — proves that
      Cryptography/FakeSymmetricEncryptionService genuinely satisfies AddCacheEncryption()'s
      ISymmetricEncryptionService prerequisite. SharedKernel.Testing itself never takes this
      reference; only this SelfTests project does, for this one interop proof.
    -->
    <ProjectReference Include="..\..\..\02.Caching\SharedKernel.Caching.FusionCache\SharedKernel.Caching.FusionCache.csproj" />
    <!--
      P-485/WO-078: test-only proof dependency mirroring the T-88 precedent above — proves
      Localization/CultureScope composes with 01.Core/SharedKernel.Localization's own
      InMemoryLocalizationCatalog with zero code changes on either side (D-235's audit finding:
      that catalog IS the deterministic, seedable test double this phase's first requirement
      describes — 16.Testing does not duplicate it). SharedKernel.Testing itself never takes this
      reference; only this SelfTests project does, for this one interop proof.
    -->
    <ProjectReference Include="..\..\..\01.Core\SharedKernel.Localization\SharedKernel.Localization.csproj" />
    <!--
      P-562: test-only proof dependency mirroring the two precedents above — proves Grpc/TestServerCallContext
      composes with SharedKernel.Presentation.Grpc (GetHttpContext() over the constructed request, and the rich
      status GetValueOrThrow()/ThrowIfFailure() throw from a service method under test). SharedKernel.Testing itself
      dropped its reference to that package in P-562; only this SelfTests project takes it.
    -->
    <ProjectReference Include="..\..\..\14.Presentation\SharedKernel.Presentation.Grpc\SharedKernel.Presentation.Grpc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Standard Test Package Set — direct package references; must never leak into SharedKernel.Testing.csproj itself. -->
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>
</Project>
