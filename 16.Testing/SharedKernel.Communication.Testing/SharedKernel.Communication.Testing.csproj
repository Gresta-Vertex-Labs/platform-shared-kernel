<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Testing</SharedKernelTier>
    <Description>Test helpers for the SharedKernel communication packages, for test projects only. MockServiceEndpointResolver for IServiceEndpointResolver and a gRPC ServerCallContext factory for interceptor tests.</Description>
    <PackageTags>communication;grpc;service-discovery;testing;test-doubles;shared-kernel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A test-helper LIBRARY, not a test project: dotnet test must not try to run it. -->
    <IsTestProject>false</IsTestProject>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\11.Communication\SharedKernel.Communication.Internal\SharedKernel.Communication.Internal.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Core.Testing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
