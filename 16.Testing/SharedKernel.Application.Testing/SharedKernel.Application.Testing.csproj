<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Testing</SharedKernelTier>
    <Description>Test helpers for the SharedKernel application pipeline, for test projects only. ApplicationPipelineTestHarness runs a command or query through the real pipeline behaviors (optionally through the MediatR adapter) with activity and metric capture, and AddFakeApplicationBehaviorServices registers the fake unit of work, request context and idempotency store the behaviors need.</Description>
    <PackageTags>application;pipeline;mediator;testing;test-doubles;shared-kernel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A test-helper LIBRARY, not a test project: dotnet test must not try to run it. -->
    <IsTestProject>false</IsTestProject>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Testing\SharedKernel.Testing.csproj" />
    <ProjectReference Include="..\SharedKernel.Idempotency.Testing\SharedKernel.Idempotency.Testing.csproj" />
    <ProjectReference Include="..\SharedKernel.Persistence.Testing\SharedKernel.Persistence.Testing.csproj" />
    <ProjectReference Include="..\..\05.Application\SharedKernel.Application.Pipeline\SharedKernel.Application.Pipeline.csproj" />
    <ProjectReference Include="..\..\05.Application\SharedKernel.Application.Mediator.MediatR\SharedKernel.Application.Mediator.MediatR.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
