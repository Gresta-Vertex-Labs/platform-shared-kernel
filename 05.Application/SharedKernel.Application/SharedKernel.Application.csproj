<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Version>1.1.0</Version>
    <Description>MediatR-based CQRS vocabulary for Platform.SharedKernel microservices: ICommand, ICommand&lt;TResponse&gt;, IQuery&lt;TResponse&gt;, handler-alias interfaces, the streaming-query vocabulary (IStreamQuery&lt;TResponse&gt;, IStreamQueryHandler&lt;,&gt;), the fire-and-forget command marker (IFireAndForgetCommand), and the domain-event-to-MediatR bridge (IDomainEventHandler, DomainEventNotification, MediatRDomainEventDispatcher with optional parallel dispatch). References only SharedKernel.Primitives, SharedKernel.Core, SharedKernel.Domain, and MediatR.</Description>
    <PackageTags>cqrs;mediatr;application;command;query;streaming;domain-events;shared-kernel</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Layering ceiling for SharedKernel.Application is 01.Core, 03.Domain, 04.Contracts.
      This package never references 06.Persistence, 07.Messaging, 12.Security, or
      SharedKernel.Caching.Abstractions (that reference belongs to .Behaviors only).
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Core\SharedKernel.Core.csproj" />
    <ProjectReference Include="..\..\03.Domain\SharedKernel.Domain\SharedKernel.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      MediatR pinned to 12.4.x — the last MIT-licensed major (v13 introduced a commercial
      license). This is a deliberate platform ceiling; see CLAUDE.md version-pin callout.
    -->
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- IOptions<T>/IOptionsMonitor<T> for MediatRDomainEventDispatcherOptions (WO-038, P-233) -->
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
</Project>
