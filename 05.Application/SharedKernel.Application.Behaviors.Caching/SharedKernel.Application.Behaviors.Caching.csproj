  <ItemGroup>
    <!--
      The only package in 05.Application permitted to reference SharedKernel.Caching.Abstractions —
      SharedKernel.Application and SharedKernel.Application.Behaviors must never take this reference.
    -->
    <ProjectReference Include="..\SharedKernel.Application.Behaviors\SharedKernel.Application.Behaviors.csproj" />
    <ProjectReference Include="..\..\02.Caching\SharedKernel.Caching.Abstractions\SharedKernel.Caching.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same MediatR ceiling as SharedKernel.Application — see that project's version-pin note. -->
    <PackageReference Include="MediatR" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Both behaviors are internal: the public contract of this package is the marker interfaces,
      CacheScope and AddCachingBehaviors(), not the pipeline types the builder registers by
      reflection. The test project constructs them directly, the repo's dominant convention
      (02.Caching.FusionCache, 06.Persistence.EfCore, 07.Messaging.MassTransit and 40 others).
    -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Application.Behaviors.Caching.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
