<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Version>1.1.0</Version>
    <Description>Opt-in MediatR pipeline behaviors for Platform.SharedKernel microservices: Logging, Metrics, Tracing, Validation, Authorization, DualApproval (maker-checker), Caching, Resilience, Idempotency (with opt-in response replay), Transaction, and CacheInvalidation, composed in a fixed canonical order via ApplicationBehaviorsBuilder — plus opt-in fire-and-forget command dispatch infrastructure and opt-in structured request/response payload logging (ILoggableRequest&lt;TResponse&gt;). References SharedKernel.Application, SharedKernel.Caching.Abstractions, MediatR, FluentValidation, and Polly.Core.</Description>
    <PackageTags>cqrs;mediatr;pipeline-behavior;validation;logging;metrics;tracing;caching;resilience;transaction;authorization;dual-approval;idempotency;shared-kernel</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!--
      SharedKernel.Application.Behaviors may reference SharedKernel.Caching.Abstractions
      (the only package in this domain permitted to do so) plus the same 01.Core ceiling
      as SharedKernel.Application. Never 06.Persistence, 07.Messaging, or 12.Security.
    -->
    <ProjectReference Include="..\SharedKernel.Application\SharedKernel.Application.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Core\SharedKernel.Core.csproj" />
    <ProjectReference Include="..\..\02.Caching\SharedKernel.Caching.Abstractions\SharedKernel.Caching.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same MediatR ceiling as SharedKernel.Application — see that project's version-pin note. -->
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!--
      Polly v8 resilience pipeline for ResilienceBehavior<,> (WO-036). Confirmed at Scaffold
      (state-map.md S-09) that no existing reference in this repo brings Polly.Core in
      transitively — this is a fresh, direct NuGet reference. Polly.Core (not the full Polly
      meta-package) is the minimal package: it ships ResiliencePipeline/ResiliencePipelineBuilder/
      ResiliencePipelineProvider with zero further third-party dependencies, matching this
      domain's "minimal fresh reference" mandate. Pinned to 8.7.0, the latest stable Polly v8
      release as of this phase — same major already proven in 11.Communication's typed HTTP
      clients, so no new major-version risk is introduced to the platform.
    -->
    <PackageReference Include="Polly.Core" />
    <!--
      BackgroundService lives in Microsoft.Extensions.Hosting.Abstractions — not available
      transitively through DependencyInjection.Abstractions; must be explicit (WO-038, C-43).
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
</Project>
