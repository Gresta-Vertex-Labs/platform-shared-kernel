  <ItemGroup>
    <!--
      SharedKernel.Application.Behaviors references SharedKernel.Application plus the same 01.Core
      ceiling. Never 06.Persistence, 07.Messaging, 12.Security, or SharedKernel.Caching.Abstractions
      (that reference belongs exclusively to the sibling SharedKernel.Application.Behaviors.Caching).
    -->
    <ProjectReference Include="..\SharedKernel.Application\SharedKernel.Application.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same MediatR ceiling as SharedKernel.Application — see that project's version-pin note. -->
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Concrete AddLogging() DI extension — ApplicationBehaviorsBuilder.Build() calls it unconditionally
         so logger-dependent behaviors (CommandScopeBehavior, IdempotencyBehavior) can always resolve
         ILogger<T>, even against a bare ServiceCollection with no prior AddLogging() call. -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- ValidateDataAnnotations()/ValidateOnStart() for ApplicationLoggingOptions — fails at
         AddSharedKernelApplicationBehaviors().Build()-time host startup, not at the first request.
         A plain Microsoft.Extensions.* NuGet package, never a SharedKernel.Configuration (01.Core)
         project reference. -->
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <!-- IMeterFactory / services.AddMetrics() for MetricsBehavior's ApplicationMetrics singleton. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
