<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- NuGet packaging metadata -->
    <PackageId>SharedKernel.Presentation.SignalR</PackageId>
    <Version>1.0.1</Version>
    <Authors>Gresta-Vertex-Labs</Authors>
    <Company>Gresta-Vertex-Labs</Company>
    <Product>Platform.SharedKernel</Product>
    <Description>Real-time SignalR conventions for SharedKernel microservices: tenant-context hub filter (TenantContextHubFilter), exception-to-HubException mapping filter (HubExceptionMappingFilter), tenant-scoped group naming convention (HubGroupNaming), global filter registration (AddSharedKernelSignalR), and an opt-in Redis-backed scale-out backplane (WithRedisBackplane) isolated from 02.Caching.Redis.Core.</Description>
    <PackageTags>shared-kernel;signalr;realtime;hub-filter;redis;multi-tenant;aspnetcore</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</PackageProjectUrl>
    <Copyright>Copyright © 2026 Gresta-Vertex-Labs</Copyright>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Layering: 14.Presentation may reference 01.Core, 04.Contracts, 12.Security, and
      13.ServiceDefaults only. SharedKernel.Contracts is not needed by this package — hub filters
      operate on Error/SharedKernelException (01.Core) and ITenantProvider (12.Security), never on
      wire DTOs.
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Core\SharedKernel.Core.csproj" />
    <ProjectReference Include="..\..\12.Security\SharedKernel.Security.Abstractions\SharedKernel.Security.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Redis-backed SignalR scale-out backplane, isolated behind WithRedisBackplane — must never
      share an IConnectionMultiplexer with 02.Caching.Redis.Core. See 14.Presentation/CLAUDE.md.
    -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude the nested test project from the main project's compilation -->
    <Compile Remove="SharedKernel.Presentation.SignalR.Tests\**" />
    <EmbeddedResource Remove="SharedKernel.Presentation.SignalR.Tests\**" />
    <None Remove="SharedKernel.Presentation.SignalR.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
