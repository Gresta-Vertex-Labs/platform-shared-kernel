<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Host</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>Real-time SignalR conventions for SharedKernel microservices: tenant-context hub filter (TenantContextHubFilter), exception-to-HubException mapping filter (HubExceptionMappingFilter), per-connection hub-method invocation rate limiting and argument-payload validation (HubInvocationRateLimitFilter, HubInvocationRateLimitOptions), tenant-scoped group naming convention (HubGroupNaming), global filter registration with conservative resource-exhaustion HubOptions defaults (AddSharedKernelSignalR), a startup-time diagnostic flagging hubs mapped without a CORS policy, and an opt-in Redis-backed scale-out backplane (WithRedisBackplane) isolated from 02.Caching.Redis.Core.</Description>
    <PackageTags>shared-kernel;signalr;realtime;hub-filter;rate-limiting;redis;multi-tenant;aspnetcore</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Layering: 14.Presentation may reference 01.Core, 04.Contracts, 12.Security, and
      13.ServiceDefaults only. SharedKernel.Contracts is not needed by this package — hub filters
      operate on Error/SharedKernelException (01.Core) and ITenantProvider (12.Security), never on
      wire DTOs.
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Core\SharedKernel.Core.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Execution\SharedKernel.Execution.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Redis-backed SignalR scale-out backplane, isolated behind WithRedisBackplane — must never
      share an IConnectionMultiplexer with 02.Caching.Redis.Core. See 14.Presentation/CLAUDE.md.
    -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
  </ItemGroup>
</Project>
