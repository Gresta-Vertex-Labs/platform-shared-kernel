<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Host</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>Real-time SignalR conventions for SharedKernel microservices: tenant-context hub filter (TenantContextHubFilter), exception-to-HubException mapping filter (HubExceptionMappingFilter), per-connection hub-method invocation rate limiting and argument-payload validation (HubInvocationRateLimitFilter, HubInvocationRateLimitOptions), tenant-scoped group naming convention (HubGroupNaming), global filter registration with conservative resource-exhaustion HubOptions defaults (AddSharedKernelSignalR), and a startup-time diagnostic flagging hubs mapped without a CORS policy. The Redis scale-out backplane is SharedKernel.Presentation.SignalR.Redis.</Description>
    <PackageTags>shared-kernel;signalr;realtime;hub-filter;rate-limiting;multi-tenant;aspnetcore</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Host tier. SharedKernel.Contracts is not needed by this package — hub filters operate on
      Error/SharedKernelException (Foundation) and IRequestContext / IRequestContextAccessor
      (SharedKernel.Execution), never on wire DTOs. The Redis backplane lives in
      SharedKernel.Presentation.SignalR.Redis (P-570).
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Core\SharedKernel.Core.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Execution\SharedKernel.Execution.csproj" />
  </ItemGroup>
  <!--
    No Redis (P-570): the scale-out backplane (WithRedisBackplane) is SharedKernel.Presentation.SignalR.Redis,
    so a single-replica host does not reference StackExchange.Redis.
  -->
</Project>
