<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Host</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>Redis-backed scale-out backplane for SharedKernel.Presentation.SignalR: WithRedisBackplane(connectionString) on the SignalR server builder, over Microsoft.AspNetCore.SignalR.StackExchangeRedis with its own connection, never shared with 02.Caching's Redis connection. Reference it only in a SignalR host that runs more than one replica.</Description>
    <PackageTags>shared-kernel;signalr;realtime;redis;backplane;scale-out;aspnetcore</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- The SignalR conventions this backplane plugs into (Host to Host). -->
    <ProjectReference Include="..\SharedKernel.Presentation.SignalR\SharedKernel.Presentation.SignalR.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Redis-backed SignalR scale-out backplane, isolated behind WithRedisBackplane — must never
      share an IConnectionMultiplexer with 02.Caching.Redis.Core. See 14.Presentation/CLAUDE.md.
    -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
  </ItemGroup>
</Project>
