<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Description>Server-side gRPC API surface conventions for SharedKernel microservices, the inbound counterpart to SharedKernel.Presentation.WebApi: a GrpcStatusCodeMap (ErrorType to Grpc.Core.StatusCode, a sibling to ErrorTypeStatusCodeMap, never a merge), Result&lt;T&gt; to RpcException-throwing extensions (GrpcResultExtensions), a global exception-to-RpcException mapping interceptor (GrpcExceptionInterceptor, the gRPC counterpart to IExceptionHandler), inbound correlation-id/tenant-id metadata extraction interceptors (GrpcCorrelationInterceptor, GrpcTenantContextInterceptor), declarative role/permission/step-up authorization reused verbatim from SharedKernel.Presentation.WebApi (GrpcAuthorizationInterceptor), and a single AddSharedKernelGrpc DI entry point registering every interceptor globally with a conservative inbound message-size default.</Description>
    <PackageTags>shared-kernel;grpc;rpcexception;statuscode;correlation-id;authorization;aspnetcore</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Layering: 14.Presentation may reference 01.Core, 04.Contracts, 12.Security, and
      13.ServiceDefaults only. This package NEVER references 04.Contracts — a named exception to
      14.Presentation's otherwise-permitted 04.Contracts reference, mirroring
      SharedKernel.Communication.Grpc's existing P-163 rule: protobuf-generated messages are this
      package's only wire-contract surface, not 04.Contracts DTOs (P-468/WO-074, D-78).

      The ProjectReference on SharedKernel.Presentation.WebApi is the one deliberate exception to
      this domain's usual "distinct API surfaces, no cross-references" rule (SignalR still takes
      none) — it exists solely to reuse RequireRoleAttribute/RequirePermissionAttribute/
      RequireFreshAuthenticationAttribute/RequireAuthenticationMethodAttribute verbatim, so the
      platform has ONE declarative authorization dialect across HTTP and gRPC (D-73/D-74). See
      14.Presentation/CLAUDE.md, "Why .Grpc references .WebApi".
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Core\SharedKernel.Core.csproj" />
    <ProjectReference Include="..\..\12.Security\SharedKernel.Security.Abstractions\SharedKernel.Security.Abstractions.csproj" />
    <ProjectReference Include="..\SharedKernel.Presentation.WebApi\SharedKernel.Presentation.WebApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Server-side gRPC hosting (Grpc.Core.Interceptors.Interceptor, ServerCallContext,
      RpcException, Status, StatusCode). Version pinned centrally in Directory.Packages.props;
      confirmed net10.0-compatible via direct NuGet flat-container listing at Scaffold phase.
    -->
    <PackageReference Include="Grpc.AspNetCore" />
  </ItemGroup>
</Project>
