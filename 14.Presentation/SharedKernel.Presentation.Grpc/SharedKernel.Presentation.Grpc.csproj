<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Host</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>Server-side gRPC API surface conventions for SharedKernel microservices, the inbound counterpart to SharedKernel.Presentation.WebApi: Result&lt;T&gt; to RpcException-throwing extensions (GrpcResultExtensions) over GrpcStatusCodeMap, a global exception-to-RpcException mapping interceptor (GrpcExceptionInterceptor, the gRPC counterpart to IExceptionHandler), inbound correlation-id/tenant-id metadata extraction interceptors (GrpcCorrelationInterceptor, GrpcTenantContextInterceptor), declarative role/permission/step-up authorization with the same attributes as the HTTP boundary (GrpcAuthorizationInterceptor), and a single AddSharedKernelGrpc DI entry point registering every interceptor globally with a conservative inbound message-size default. The attributes and GrpcStatusCodeMap come from SharedKernel.Presentation.Core; the HTTP API stack is not referenced.</Description>
    <PackageTags>shared-kernel;grpc;rpcexception;statuscode;correlation-id;authorization;aspnetcore</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Host tier. This package NEVER references SharedKernel.Contracts — a purity rule the tier
      check cannot express (kept in PresentationLayeringRules), mirroring
      SharedKernel.Communication.Grpc's P-163 rule: protobuf-generated messages are this
      package's only wire-contract surface, not 04.Contracts DTOs (P-468/WO-074, D-78).

      No reference to SharedKernel.Presentation.WebApi (P-570): the authorization attributes and the
      ErrorType status maps both boundaries share live in SharedKernel.Presentation.Core, so a gRPC
      host has ONE declarative authorization dialect with HTTP (D-73/D-74) without pulling
      OpenAPI, Scalar and API versioning.
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Execution\SharedKernel.Execution.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Core\SharedKernel.Core.csproj" />
    <ProjectReference Include="..\..\12.Security\SharedKernel.Security.Abstractions\SharedKernel.Security.Abstractions.csproj" />
    <ProjectReference Include="..\SharedKernel.Presentation.Core\SharedKernel.Presentation.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Server-side gRPC hosting (Grpc.Core.Interceptors.Interceptor, ServerCallContext,
      RpcException, Status, StatusCode). Version pinned centrally in Directory.Packages.props;
      confirmed net10.0-compatible via direct NuGet flat-container listing at Scaffold phase.
    -->
    <PackageReference Include="Grpc.AspNetCore" />
  </ItemGroup>
</Project>
