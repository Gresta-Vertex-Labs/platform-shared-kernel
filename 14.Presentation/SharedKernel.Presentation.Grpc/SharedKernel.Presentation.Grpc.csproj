<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Description>gRPC services with the same error contract and authorization as SharedKernel HTTP APIs. One call to set up (AddSharedKernelGrpc, bound from SharedKernel:Presentation:Grpc and validated at startup) registers gRPC with an exception interceptor and the permission, role, fresh-authentication and authentication-method requirements of SharedKernel.Presentation.WebApi as native ASP.NET Core authorization, usable as attributes on a service or method and as MapGrpcService conventions. Every failure becomes a rich google.rpc.Status: a status code mapped from ErrorType (including Unavailable and DeadlineExceeded), a localized message with server errors redacted outside Development, an ErrorInfo detail carrying the error code, the error domain, the trace id and the correlation id, and a BadRequest detail with the field violations, capped so the status always fits the client's header limit. A failed Result ended with SharedKernel.Core's GetValueOrThrow or ThrowIfFailure gets the same status. An RpcException from the service or from a downstream gRPC call keeps its code but never its trailers, so another service's error details and trace ids do not reach the caller. Any exception after the call is cancelled ends as Cancelled without an error log.</Description>
    <PackageTags>shared-kernel;grpc;aspnetcore;rich-status;google-rpc;errorinfo;badrequest;rpcexception;statuscode;authorization;step-up;result</PackageTags>
    <!--
      Set per-project, not inherited: the SDK assigns GenerateDocumentationFile=false before
      Directory.Build.targets' '== empty'-guarded default is evaluated. CS1591 below makes an
      undocumented public member a build error.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API tracking: an addition, removal or signature change fails the build until PublicAPI.*.txt is updated. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Layering: 14.Presentation may reference 01.Core, 04.Contracts and 12.Security. This package NEVER
      references 04.Contracts — a named exception to that permission, mirroring
      SharedKernel.Communication.Grpc's P-163 rule: protobuf messages are a gRPC service's wire contract,
      not 04.Contracts DTOs (GrpcNeverReferencesContracts).

      SharedKernel.Presentation.WebApi is the one SharedKernel reference. gRPC shares the HTTP pipeline, so
      this package takes from the core what every protocol must agree on: ErrorPresentation (status
      category, client message, localization, redaction), AddSharedKernelAuthorization (the policies behind
      RequirePermission and its siblings), GetCorrelationId and the traceId/correlationId member names.
      SharedKernel.Primitives, .Core and .Configuration arrive through it.
    -->
    <ProjectReference Include="..\SharedKernel.Presentation.WebApi\SharedKernel.Presentation.WebApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Server-side gRPC hosting: Interceptor, ServerCallContext, RpcException, StatusCode, GetHttpContext. -->
    <PackageReference Include="Grpc.AspNetCore" />
    <!-- google.rpc.Status carried in the grpc-status-details-bin trailer (ToRpcException, GetRpcStatus). -->
    <PackageReference Include="Grpc.StatusProto" />
    <!--
      Direct reference so the centrally pinned 2.17.0 is used rather than Grpc.StatusProto's 2.16.0 floor:
      2.17.0 is the first version whose google.rpc.BadRequest.FieldViolation has the reason field, which
      carries each field error's code (the gRPC counterpart of the HTTP errorCodes member).
    -->
    <PackageReference Include="Google.Api.CommonProtos" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.Presentation.Grpc.Tests" />
  </ItemGroup>
</Project>
