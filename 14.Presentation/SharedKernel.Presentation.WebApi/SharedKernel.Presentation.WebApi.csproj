<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Description>The HTTP API boundary for SharedKernel services: one call to set up (AddSharedKernelWebApi, UseSharedKernelWebApi with ordered hooks, bound from SharedKernel:Presentation:WebApi and validated) and one RFC 9457 application/problem+json error shape for every error source — Result failures, thrown exceptions, framework responses, MVC model state, minimal-API binding failures, authorization, rate limiting and request limits — with localized messages and server errors redacted outside Development. Typed results for Result and Result&lt;T&gt; (ToOk, ToCreated, ToAccepted, ToOkWithETag, ToNoContent) for minimal APIs and MVC controllers alike, permission, role, fresh-authentication and authentication-method requirements as native ASP.NET Core authorization policies evaluated against IUserContext (with RFC 9470 step-up challenges), correlation ids with caller baggage refused at the edge, required Idempotency-Key and If-Match headers (attributes, conventions or IdempotencyKey and IfMatch&lt;TVersion&gt; parameters) with 412 for stale versions, ETag with 304, security response headers and no-store caching by default, CORS with a WebSocket origin check, request size limits and ErrorType to status mapping including 503 and 504. No third-party dependencies.</Description>
    <PackageTags>shared-kernel;webapi;aspnetcore;problemdetails;rfc9457;typed-results;authorization;step-up;rfc9470;correlation-id;idempotency;etag;if-match;cors;security-headers;rate-limiting</PackageTags>
    <!--
      Set per-project, not inherited: the SDK assigns GenerateDocumentationFile=false before
      Directory.Build.targets' '== empty'-guarded default is evaluated. CS1591 below makes an
      undocumented public member a build error.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API tracking: an addition, removal or signature change fails the build until PublicAPI.*.txt is updated. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
    <!-- RS0026/RS0027 discourage optional parameters on overloads. ToAccepted exists for Result<T> and for
         Task<Result<T>>, and both take the same optional location, so the awaited and the plain form read alike. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Layering: 14.Presentation may reference 01.Core, 04.Contracts and 12.Security. This package
      converts outcomes (Result, Error, exceptions) into HTTP responses; it never produces them,
      so it references no application or infrastructure layer. SharedKernel.Localization supplies
      the optional ILocalizationCatalog used to translate client messages; SharedKernel.Configuration
      binds and validates WebApiOptions.
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Core\SharedKernel.Core.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Localization\SharedKernel.Localization.csproj" />
    <ProjectReference Include="..\..\12.Security\SharedKernel.Security.Abstractions\SharedKernel.Security.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.Presentation.WebApi.Tests" />
  </ItemGroup>
</Project>
