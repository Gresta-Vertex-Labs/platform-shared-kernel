<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Host</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>HTTP API surface conventions for SharedKernel microservices: RFC 9457 ProblemDetails error mapping (ErrorTypeStatusCodeMap, Error.ToProblemDetails) including multi-field validation errors (ValidationProblemDetailsExtensions), global IExceptionHandler (SharedKernelExceptionHandler), Result&lt;T&gt; to IResult/ActionResult HTTP-boundary extensions (ResultHttpExtensions), API versioning (AddSharedKernelApiVersioning) with RFC 8594 Sunset/Deprecation/Link lifecycle headers (ApiVersionLifecycleOptions), native OpenAPI document generation + Scalar interactive UI (AddSharedKernelOpenApi/MapSharedKernelOpenApi) with Bearer/ApiKey/mutualTLS security-scheme registration (OpenApiSecuritySchemesOptions), declarative role/permission and step-up/fresh-authentication endpoint-filter authorization (RequireRoleAttribute, RequirePermissionAttribute, RequireFreshAuthenticationAttribute, RequireAuthenticationMethodAttribute, AuthorizationRequirementEndpointFilter, AddSharedKernelAuthorizationFilters), platform security response headers (UseSharedKernelSecurityHeaders), a deny-by-default CORS policy convention (AddSharedKernelCors), inbound Idempotency-Key HTTP-boundary support (RequireIdempotencyKeyAttribute, AddSharedKernelIdempotencyFilters), ETag/If-Match conditional-request concurrency helpers (RowVersionETag, ConditionalRequestExtensions), a rate-limit-rejection ProblemDetails/429 bridge (RateLimitRejectionProblemDetails), request payload-size and JSON-depth denial-of-service protection (AddSharedKernelPayloadLimits, UseSharedKernelPayloadLimits), file/multipart upload size and content-type validation (AddSharedKernelUploadValidation, RequireValidatedUploadAttribute), and structured security-audit logging across every HTTP-boundary rejection path.</Description>
    <PackageTags>shared-kernel;webapi;problemdetails;rfc9457;api-versioning;openapi;scalar;authorization;security-headers;cors;idempotency;etag;rate-limiting;payload-limits;uploads;aspnetcore</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Layering: 14.Presentation may reference 01.Core, 04.Contracts, 12.Security, and
      13.ServiceDefaults only. References to 05.Application, 06.Persistence, 07.Messaging, or any
      other infrastructure layer are hard violations — this domain converts outcomes (Result<T>,
      Error, exceptions) into HTTP responses; it never produces those outcomes itself.
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Core\SharedKernel.Core.csproj" />
    <!--
      SharedKernel.Localization is a 01.Core abstraction (ILocalizationCatalog), the same layer
      this package already depends on for Result<T>/Error — referencing it does not violate this
      domain's "no concrete-provider reference" posture (P-484/WO-078, D-81). Used exclusively to
      optionally localize Error.ToProblemDetails()'s Detail value; never a hard requirement — see
      Errors/LocalizedDetailResolver.cs.
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Localization\SharedKernel.Localization.csproj" />
    <ProjectReference Include="..\..\12.Security\SharedKernel.Security.Abstractions\SharedKernel.Security.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      API versioning: URL-segment-primary + header-secondary version reader (AddSharedKernelApiVersioning).
      Native OpenAPI document generation (Microsoft.AspNetCore.OpenApi) + Scalar interactive UI.
      Swashbuckle/NSwag are deliberately never referenced — see 14.Presentation/CLAUDE.md.
    -->
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>
</Project>
