<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <!--
    Consumer verification: resolves SharedKernel.Domain from the local NuGet feed (nupkgs/)
    to confirm the published dependency graph is correct.
    Verifies Entity<TId>, AggregateRoot<TId>, ValueObject, ISpecification<T>,
    StronglyTypedId<TValue>, IBusinessRule, and IPolicy<T> are all usable
    without additional package references beyond SharedKernel.Domain.
  -->
  <ItemGroup>
    <PackageReference Include="SharedKernel.Domain" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
