<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Version>1.0.0</Version>
    <Description>K8s-native service discovery for Platform.SharedKernel: IServiceEndpointResolver, KubernetesServiceEndpointResolver (DNS SRV + A-record via Microsoft.Extensions.ServiceDiscovery), StaticServiceEndpointResolver (dev/test only — logs Warning at startup), AddK8sServiceDiscovery and AddStaticServiceDiscovery DI extensions.</Description>
    <PackageTags>service-discovery;kubernetes;k8s;dns;headless;shared-kernel</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Layering: 11.Communication.Internal references 01.Core only.
      No 04.Contracts, 12.Security, 02.Caching, 05.Application, 06.Persistence, or 07.Messaging.
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Microsoft.Extensions.ServiceDiscovery: DNS SRV + A-record resolution for K8s headless services.
      Version 10.7.0 — net10.0 compatible; AOT status: compatible as of 10.7.0.
    -->
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Allow test project to access internal types -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Communication.Internal.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
