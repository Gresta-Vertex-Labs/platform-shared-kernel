<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NuGet packaging metadata -->
    <PackageId>SharedKernel.Communication.Rest</PackageId>
    <Version>1.0.0</Version>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>Gresta-Vertex-Labs</Authors>
    <Company>Gresta-Vertex-Labs</Company>
    <Product>Platform.SharedKernel</Product>
    <Description>Typed HttpClient factory with Polly v8 resilience (StandardResilienceHandler: retry, circuit-breaker, timeout), CorrelationIdDelegatingHandler, TenantIdDelegatingHandler, ProblemDetails deserialization to Error, and fluent IRestCommunicationBuilder DI entry point.</Description>
    <PackageTags>http-client;rest;polly;resilience;correlation-id;tenant-id;problem-details;shared-kernel</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</PackageProjectUrl>
    <Copyright>Copyright © 2026 Gresta-Vertex-Labs</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Layering: 11.Communication may reference 01.Core, 04.Contracts, 12.Security.Abstractions only.
      References to 02.Caching, 05.Application, 06.Persistence, 07.Messaging are hard violations.
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\04.Contracts\SharedKernel.Contracts\SharedKernel.Contracts.csproj" />
    <ProjectReference Include="..\..\12.Security\SharedKernel.Security.Abstractions\SharedKernel.Security.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.Extensions.Http: IHttpClientFactory and HttpClient DI wiring.
      Microsoft.Extensions.Http.Resilience: Polly v8 StandardResilienceHandler.
        Every AddRestClient<TClient> call must attach StandardResilienceHandler — never skip.
      Microsoft.Extensions.Http.Abstractions: IHttpContextAccessor for request-scope TenantId resolution.
    -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
    <!--
      Microsoft.AspNetCore.Http.Abstractions: IHttpContextAccessor used by TenantIdDelegatingHandler
      to resolve IUserContext from the request scope. In net10.0 this is part of the shared framework
      but an explicit reference is needed for net10.0 non-web classlib projects.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Allow test project to access internal types (CorrelationIdDelegatingHandler, TenantIdDelegatingHandler) -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Communication.Rest.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude the nested test project from the main project's compilation -->
    <Compile Remove="SharedKernel.Communication.Rest.Tests\**" />
    <EmbeddedResource Remove="SharedKernel.Communication.Rest.Tests\**" />
    <None Remove="SharedKernel.Communication.Rest.Tests\**" />
  </ItemGroup>

</Project>
