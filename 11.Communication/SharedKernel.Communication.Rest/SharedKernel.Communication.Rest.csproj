<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Adapter</SharedKernelTier>
    <SharedKernelAllowedAdapterReferences>SharedKernel.Communication.Internal</SharedKernelAllowedAdapterReferences>
    <!-- NuGet packaging metadata -->
    <Description>Typed HttpClient factory with Polly v8 resilience (StandardResilienceHandler: retry, circuit-breaker, timeout), a RequestContextDelegatingHandler that forwards the ambient caller's correlation id, tenant, actor and client headers from IRequestContextAccessor (no ASP.NET Core dependency), opt-in Idempotency-Key propagation, ProblemDetails deserialization to Error, and fluent IRestCommunicationBuilder DI entry point.</Description>
    <PackageTags>http-client;rest;polly;resilience;correlation-id;tenant-id;idempotency-key;problem-details;shared-kernel</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Adapter tier: Foundation packages plus the named sibling SharedKernel.Communication.Internal
      (service discovery). The caller comes from SharedKernel.Execution's IRequestContextAccessor, so
      there is deliberately no Microsoft.AspNetCore.Http reference (P-566).
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Execution\SharedKernel.Execution.csproj" />
    <ProjectReference Include="..\SharedKernel.Communication.Internal\SharedKernel.Communication.Internal.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Microsoft.Extensions.Http: IHttpClientFactory and HttpClient DI wiring.
      Microsoft.Extensions.Http.Resilience: Polly v8 StandardResilienceHandler.
        Every AddRestClient<TClient> call must attach StandardResilienceHandler — never skip.
    -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>
  <ItemGroup>
    <!-- Allow test project to access internal types (RequestContextDelegatingHandler, IdempotencyKeyDelegatingHandler) -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Communication.Rest.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
