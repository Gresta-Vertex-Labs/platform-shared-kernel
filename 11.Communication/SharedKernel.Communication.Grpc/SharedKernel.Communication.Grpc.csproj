<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NuGet packaging metadata -->
    <PackageId>SharedKernel.Communication.Grpc</PackageId>
    <Version>1.0.0</Version>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>Gresta-Vertex-Labs</Authors>
    <Company>Gresta-Vertex-Labs</Company>
    <Product>Platform.SharedKernel</Product>
    <Description>gRPC channel factory via Grpc.Net.ClientFactory, CorrelationTracingInterceptor (W3C OTel + x-correlation-id), TenantIdInterceptor (x-tenant-id), MoneyProtoExtensions (Money &lt;-&gt; decimal), TimestampProtoExtensions (Timestamp &lt;-&gt; DateTimeOffset), and fluent IGrpcCommunicationBuilder DI entry point.</Description>
    <PackageTags>grpc;channel-factory;otel;tracing;correlation-id;tenant-id;protobuf;shared-kernel</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</PackageProjectUrl>
    <Copyright>Copyright © 2026 Gresta-Vertex-Labs</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Layering: 11.Communication may reference 01.Core, 04.Contracts, 12.Security.Abstractions only.
      References to 02.Caching, 05.Application, 06.Persistence, 07.Messaging are hard violations.
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\04.Contracts\SharedKernel.Contracts\SharedKernel.Contracts.csproj" />
    <ProjectReference Include="..\..\12.Security\SharedKernel.Security.Abstractions\SharedKernel.Security.Abstractions.csproj" />
    <!--
      Intra-domain reference: .Internal is the foundational service-discovery package within 11.Communication.
      Used for optional IServiceEndpointResolver integration in AddGrpcClient<TClient> (G-09).
    -->
    <ProjectReference Include="..\SharedKernel.Communication.Internal\SharedKernel.Communication.Internal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Grpc.Net.Client 2.80.0: channel and call invoker for .NET gRPC clients.
      Grpc.Net.ClientFactory 2.80.0: IHttpClientFactory-based channel factory (singleton channel caching).
      Google.Protobuf 3.35.1: required for MoneyProtoExtensions and TimestampProtoExtensions well-known types.
        Money and Timestamp are Google Protobuf well-known types — pure static conversion, no reflection.
      OpenTelemetry.Instrumentation.GrpcNetClient 1.15.1-beta.1: OTel gRPC instrumentation.
        Still in beta but the only available option for net10.0; interceptors wrap it in try/catch.
      Microsoft.AspNetCore.Http.Abstractions 2.3.11: IHttpContextAccessor for TenantIdInterceptor
        request-scope IUserContext resolution.
    -->
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.80.0" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <!--
      Google.Api.CommonProtos 2.17.0: provides Google.Type.Money (units + nanos well-known type)
      used by MoneyProtoExtensions. Also transitively provides Timestamp from Google.Protobuf.WellKnownTypes.
    -->
    <PackageReference Include="Google.Api.CommonProtos" Version="2.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.15.1-beta.1" />
    <!--
      Microsoft.AspNetCore.Http: provides IHttpContextAccessor (abstractions) and HttpContextAccessor
      (concrete impl) for TenantIdInterceptor request-scope tenant resolution.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Allow test project to access internal types (CorrelationTracingInterceptor, TenantIdInterceptor) -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Communication.Grpc.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude the nested test project from the main project's compilation -->
    <Compile Remove="SharedKernel.Communication.Grpc.Tests\**" />
    <EmbeddedResource Remove="SharedKernel.Communication.Grpc.Tests\**" />
    <None Remove="SharedKernel.Communication.Grpc.Tests\**" />
  </ItemGroup>

</Project>
