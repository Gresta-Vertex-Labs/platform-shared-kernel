<Project>

  <!--
    Central Package Management — one version per package ID, repo-wide.

    CentralPackageTransitivePinningEnabled is OFF everywhere (not just for shipping projects):
    when a package is transitively pinned and then packed, NuGet promotes the pinned transitive
    into an explicit <dependency> in the emitted .nuspec — one pin would silently rewrite the
    public dependency graph of every package that touches it, the opposite of this repo's layering
    discipline. For a shipping package with a vulnerable transitive, the fix is a deliberate,
    reviewable override instead of a blanket transitive pin — two shapes are used here depending on
    how widely the vulnerable package is pulled in:

      1. System.Security.Cryptography.Xml (via Microsoft.Identity.Web -> Microsoft.AspNetCore.
         DataProtection, reached only through SharedKernel.Security.Oidc's own dependency chain):
         a plain PackageVersion entry below, consumed by one explicit, commented, bare
         <PackageReference> in SharedKernel.Security.Oidc.csproj.

      2. SSH.NET and SQLitePCLRaw.bundle_e_sqlite3 (via Testcontainers.*/EF Core Sqlite, reached
         independently by 8+ different projects across the repo, not through one shared owning
         project): a <GlobalPackageReference> below, which NuGet applies as an implicit direct,
         PrivateAssets="all" reference to every project automatically. This is the only way to
         guarantee the patched version wins in every project's graph without hand-auditing (and
         re-auditing on every future new test project) which ones happen to pull Testcontainers
         directly versus transitively through SharedKernel.Testing.

    NuGet.Config already declares packageSourceMapping with more than one source configured,
    which is exactly the condition NU1507 warns about under CPM — this repo is already compliant.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <!--
      Required by the $(SharedKernelPackageVersion) float below (without it NuGet fails restore with
      NU1011: "the following PackageVersion items cannot specify a floating version"). This switch only
      makes a float *legal* to declare — it floats nothing on its own, and the 100+ third-party pins in
      this file remain exact literals. It does not reopen the per-project override door either; that
      stays shut via CentralPackageVersionOverrideEnabled=false above. The single float it permits is
      confined to SharedKernel.* IDs, which NuGet.Config's packageSourceMapping routes exclusively to
      the local ./nupkgs feed, and CI never exercises it at all (it passes an exact version).
    -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!--
      Version used for every in-repo SharedKernel.* PackageReference (see the block below). Left as a
      floating prerelease-inclusive wildcard for local development; CI passes the exact MinVer-computed
      version with -p:SharedKernelPackageVersion=<ver>.
    -->
    <SharedKernelPackageVersion Condition="'$(SharedKernelPackageVersion)' == ''">*-*</SharedKernelPackageVersion>
  </PropertyGroup>

  <!--
    Repo-wide vulnerable-transitive overrides (DV-005). See the note above for why these two are
    GlobalPackageReference rather than a single owning project's PackageReference.
  -->
  <ItemGroup>
    <!-- GHSA-2m69-gcr7-jv3q / CVE-2025-6965 (SQLite aggregate-terms memory corruption, <= 2.1.11) -->
    <!--
      MinVer (DV-007) — the single source of every SharedKernel package version. Declared as a
      GlobalPackageReference so it applies to all 119 projects with an implicit PrivateAssets="all",
      and therefore never appears as a dependency in any emitted .nuspec. It derives Version from
      the newest reachable `v*` git tag and overwrites whatever a project might set, which is what
      makes repo-wide lockstep structural rather than a convention someone has to remember. Its
      knobs (MinVerTagPrefix / MinVerMinimumMajorMinor / MinVerAutoIncrement) live in
      Directory.Build.props alongside the other build-identity properties.
    -->
    <GlobalPackageReference Include="MinVer" Version="7.0.0" />
    <GlobalPackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <!-- GHSA-q939-rpr3-3284 / CVE-2026-48798 (SSH.NET ScpClient path traversal, <= 2025.1.0) -->
    <GlobalPackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Asp.Versioning.Http" Version="10.0.0" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <!-- Test-only, SharedKernel.Analyzers.Tests (SK0033/WO-079/P-486): fixture compilation proving
         the reflection-based-mapper-usage analyzer fires against the real AutoMapper assembly.
         Never a production PackageReference of any SharedKernel.* package. -->
    <PackageVersion Include="AutoMapper" Version="15.1.1" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.101.1" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Keys" Version="4.7.0" />
    <!--
      SharedKernel.Cryptography.KeyVault.Azure (01.Core/WO-081, P-496): the durable version registry
      stores each key version, and the shared "current version" pointer, as Key Vault Secrets — a
      second Azure SDK family alongside .Keys above. Confined to that one package; a
      .nuspec-inspection test in SharedKernel.Consumer.Tests proves it never leaks onto
      SharedKernel.Cryptography itself.
    -->
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.7.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Bogus" Version="35.6.1" />
    <!--
      SharedKernel.Linter's formatting-enforcement dependency (MIT). CSharpier's own MSBuild
      integration, used in place of a hand-rolled `dotnet tool install` + `Exec` target: it
      resolves the formatter per-RID and per-TFM itself, so the check works on the Linux CI
      runners as well as Windows workstations. This is the one third-party dependency
      SharedKernel.Linter declares; it flows to consumers by design, since the whole point of
      that package is to hand a consuming service a working format check.
    -->
    <PackageVersion Include="CSharpier.MsBuild" Version="1.3.0" />
    <!--
      SharedKernel.Reporting.Spreadsheet (20.Reporting/WO-077, P-479): unconditional MIT, verified
      directly against the published nuspec on nuget.org before pinning (20.Reporting/CLAUDE.md's
      ratified licensing table). No incremental/streaming write path exists in this library — see
      that package's own docs for the accepted, documented memory-model limitation.
    -->
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="Elastic.Clients.Elasticsearch" Version="9.4.2" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="Google.Api.CommonProtos" Version="2.17.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.35.1" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageVersion Include="Grpc.Core.Api" Version="2.80.0" />
    <PackageVersion Include="Grpc.Core.Testing" Version="2.46.6" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.80.0" />
    <PackageVersion Include="HotChocolate.AspNetCore" Version="16.1.4" />
    <PackageVersion Include="HotChocolate.Data" Version="16.1.4" />
    <!--
      SharedKernel.Cryptography.Argon2 (01.Core/WO-081, P-495): pure-managed MIT Argon2id, chosen
      over a libsodium binding specifically to avoid a native/P-Invoke asset that would complicate
      AOT and container builds. Confined to that one package — SharedKernel.Cryptography itself
      stays zero-third-party-dependency, proven by a .nuspec-inspection test in
      SharedKernel.Consumer.Tests.
    -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="MassTransit" Version="9.1.2" />
    <PackageVersion Include="MassTransit.Azure.ServiceBus.Core" Version="9.1.2" />
    <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="9.1.2" />
    <PackageVersion Include="MassTransit.Quartz" Version="9.1.2" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="9.1.2" />
    <PackageVersion Include="MassTransit.TestFramework" Version="9.1.2" />
    <PackageVersion Include="MediatR" Version="12.4.1" />
    <PackageVersion Include="MeiliSearch" Version="0.20.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Certificate" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Http" Version="2.3.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.5" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit" Version="1.1.2" />
    <!-- Build-time only (PrivateAssets=all): tracks each published package's public API in PublicAPI.Shipped.txt /
         PublicAPI.Unshipped.txt, so any change to the public surface is a reviewed diff. SharedKernel.Core first. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <!--
      WO-071/P-457: test-only. SQLite's EF Core provider refuses to translate ORDER BY on a
      DateTimeOffset expression at all (a provider-level LINQ-translation restriction, not a
      SQL-level one — confirmed empirically) — a hard blocker for testing AuditRecord's
      OccurredOn-ordered hash-chain/keyset queries, which SQLite-backed tests elsewhere in this
      package avoid by choosing a `long` sort key instead (see KeysetTestAggregate). AuditRecord's
      OccurredOn is fixed at DateTimeOffset per the shipped design (D-113) — production targets
      PostgreSQL, which orders by timestamptz without issue. Used ONLY by
      SharedKernel.Persistence.EfCore.Tests' Auditing/ test fixtures.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
    <!-- P-482/WO-078: SharedKernel.Localization's sole NuGet dependency (first-party Microsoft package, never a bespoke resx pipeline). -->
    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.11" />
    <!--
      Test-only: SharedKernel.Localization.Tests uses the concrete AddLocalization()/.resx-provider
      package solely to compile-verify its README's StringLocalizerLocalizationCatalog composition-
      root sample end to end. SharedKernel.Localization itself never references this — only .Abstractions.
    -->
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.7.0" />
    <PackageVersion Include="Microsoft.FeatureManagement" Version="4.5.0" />
    <PackageVersion Include="Microsoft.Identity.Web" Version="3.10.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="Microsoft.SemanticKernel" Version="1.78.0" />
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.78.0" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="OpenAI" Version="2.10.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.11.0-beta.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.15.1-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.12.0" />
    <PackageVersion Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <!--
      SharedKernel.Reporting.Pdf (20.Reporting/WO-077, P-480): unconditional MIT, verified directly
      against the published nuspecs on nuget.org before pinning. NOTE — the domain's Design phase
      (D-09/D-10) assumed three separate package IDs ("PdfSharp" + "MigraDoc.DocumentObjectModel" +
      "MigraDoc.Rendering"), reflecting the pre-6.x PDFsharp/MigraDoc package split. That three-way
      split package no longer exists on nuget.org — verified via the NuGet flat-container/search API
      2026-09-04, not assumed. The current, actively-maintained PDFsharp team packages are exactly
      two IDs: "PDFsharp" (core PDF primitives) and "PDFsharp-MigraDoc" (bundles the
      MigraDoc.DocumentObjectModel/MigraDoc.Rendering namespaces this domain's design already
      names, plus a PDFsharp dependency pinned to the identical version) — both MIT, both from the
      same upstream project (docs.pdfsharp.net), so this is a corrected package-ID mapping onto the
      same licence-ratified technology, never a substitution of a different library.
    -->
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageVersion Include="Polly.Core" Version="8.7.0" />
    <PackageVersion Include="Polly.Extensions" Version="8.7.0" />
    <PackageVersion Include="Qdrant.Client" Version="1.18.1" />
    <!--
      Direct pin, not a transitive ride: SharedKernel.Scheduling (19.Scheduling) needs
      Quartz.CronExpression at compile time, independent of 07.Messaging's MassTransit.Quartz
      reference above (which currently resolves this same 3.18.1 transitively). Pinning directly
      means 07.Messaging bumping/dropping MassTransit.Quartz can never silently break this domain's
      build (19.Scheduling/state-map.md D-06, WO-073/P-464).
    -->
    <PackageVersion Include="Quartz" Version="3.18.1" />
    <PackageVersion Include="RedLock.net" Version="2.3.2" />
    <!-- Test-only, SharedKernel.Analyzers.Tests (SK0033/WO-079/P-486): fixture compilation proving
         a Riok.Mapperly [Mapper] partial class does NOT trigger the AutoMapper-scoped analyzer.
         Never a production PackageReference of any SharedKernel.* package. -->
    <PackageVersion Include="Riok.Mapperly" Version="3.6.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.5" />
    <!--
      In-repo SharedKernel packages, consumed by the PackageReference-based consumer-verify
      harnesses and samples/ (never by a shipping package — those use ProjectReference, so
      dotnet pack stamps their dependency versions automatically and none of them appear here).

      Every one of these resolves to $(SharedKernelPackageVersion), never a literal, so this file
      cannot drift from what MinVer actually stamps. Locally that is the floating `*-*`, which
      picks the newest package present in the ./nupkgs feed including prereleases (NuGet.Config
      maps SharedKernel.* exclusively to that local feed, so the float can never reach nuget.org).
      CI overrides it with the exact packed version via -p:SharedKernelPackageVersion=<ver>, so the
      harnesses provably consume the bits produced by that same run rather than whatever happens
      to be newest on disk.
    -->
    <PackageVersion Include="SharedKernel.Analyzers" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Application" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Application.Behaviors" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.ArchitectureTests" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Caching.Abstractions" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Caching.FusionCache" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Caching.Redis" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Caching.Redis.Core" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Caching.Redis.DistributedLocking" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Caching.Redis.HashStore" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Caching.Redis.PubSub" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Compression" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Configuration" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Contracts" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Core" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Cryptography" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Cryptography.Argon2" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Cryptography.KeyVault.Azure" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.DataPrivacy" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Domain" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.FeatureManagement" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Linter" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Localization" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Primitives" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Presentation.WebApi" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.ServiceDefaults" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Validation" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="SharedKernel.Validation.FluentValidation" Version="$(SharedKernelPackageVersion)" />
    <PackageVersion Include="StackExchange.Redis" Version="2.13.1" />
    <PackageVersion Include="System.ClientModel" Version="1.10.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <PackageVersion Include="Temporalio" Version="1.17.0" />
    <PackageVersion Include="Temporalio.Extensions.DiagnosticSource" Version="1.17.0" />
    <PackageVersion Include="Temporalio.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="Temporalio.Extensions.OpenTelemetry" Version="1.17.0" />
    <PackageVersion Include="Testcontainers" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.Elasticsearch" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.Milvus" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.Minio" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.Qdrant" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.13.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.core" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.6.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.6.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.6.0" />
  </ItemGroup>

</Project>
