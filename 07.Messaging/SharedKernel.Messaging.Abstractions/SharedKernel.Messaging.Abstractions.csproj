<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NuGet packaging metadata -->
    <PackageId>SharedKernel.Messaging.Abstractions</PackageId>
    <Version>1.0.0</Version>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>Gresta-Vertex-Labs</Authors>
    <Company>Gresta-Vertex-Labs</Company>
    <Product>Platform.SharedKernel</Product>
    <Description>Transport-agnostic messaging abstractions for Platform.SharedKernel microservices: IMessageBus, IEventPublisher, PublishContext, IMessagingBuilder, MessagingOptions. Zero transport NuGet dependencies — references only Microsoft.Extensions.DependencyInjection.Abstractions. AOT-safe.</Description>
    <PackageTags>messaging;abstractions;message-bus;event-publisher;cloud-events;shared-kernel;masstransit</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</PackageProjectUrl>
    <Copyright>Copyright © 2026 Gresta-Vertex-Labs</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Zero transport NuGet dependencies.
      IMessageBus, IEventPublisher, and IMessagingBuilder are pure interface contracts.
      Only DI.Abstractions is permitted here — any transport NuGet leak is a hard violation.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude the nested test project from the main project's compilation -->
    <Compile Remove="SharedKernel.Messaging.Abstractions.Tests\**" />
    <EmbeddedResource Remove="SharedKernel.Messaging.Abstractions.Tests\**" />
    <None Remove="SharedKernel.Messaging.Abstractions.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embeds README.md into the packed .nupkg (PackageReadmeFile above) — P-349/WO-054 -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
