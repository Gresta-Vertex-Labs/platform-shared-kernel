<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Description>MassTransit 9.x wiring for Platform.SharedKernel microservices: MassTransitMessageBus, MassTransitEventPublisher, ConsumerBase, MessagingBusBuilder, RabbitMQ, Azure Service Bus, configurable retry, and transactional EF Core outbox integration. CloudEvents-compliant envelope publishing.</Description>
    <PackageTags>messaging;masstransit;rabbitmq;azure-service-bus;outbox;cloud-events;consumer-base;shared-kernel</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Project references:
        SharedKernel.Messaging.Abstractions — IMessageBus, IEventPublisher, IMessagingBuilder, MessagingOptions
        SharedKernel.Contracts             — EventEnvelope<TEvent> used by MassTransitEventPublisher
        SharedKernel.Compression           — IPayloadCompressor, used by WithPayloadTransform() (P-346)
        SharedKernel.Cryptography          — ISymmetricEncryptionService, used by WithPayloadTransform() (P-346)
      Both SharedKernel.Compression and SharedKernel.Cryptography are 01.Core packages, already
      permitted by the root layering rule ("07.Messaging may reference 01-04").
      NO reference to any 06.Persistence.* package is permitted.
      The EF Core outbox is wired via generic TDbContext type parameter only.
    -->
    <ProjectReference Include="..\SharedKernel.Messaging.Abstractions\SharedKernel.Messaging.Abstractions.csproj" />
    <ProjectReference Include="..\..\04.Contracts\SharedKernel.Contracts\SharedKernel.Contracts.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Compression\SharedKernel.Compression.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Cryptography\SharedKernel.Cryptography.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- MassTransit 9.x transports and integrations -->
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="MassTransit.Azure.ServiceBus.Core" />
    <!--
      MassTransit.EntityFrameworkCore — EF Core outbox and saga persistence.
      Used via generic TDbContext type parameter in WithEntityFrameworkOutbox<TDbContext>().
      No 06.Persistence.* reference is introduced.
    -->
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <!--
      Microsoft.EntityFrameworkCore — for the TDbContext : DbContext generic constraint in
      WithEntityFrameworkOutbox<TDbContext>(). No 06.Persistence.* reference is introduced.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!--
      MassTransit.Quartz — durable deferred message scheduling via Quartz.NET.
      Used by MessagingBusBuilder.WithQuartzScheduler() (P-127).
      Only loaded at composition root; zero impact on Abstractions package.
    -->
    <PackageReference Include="MassTransit.Quartz" />
    <!--
      Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions — HealthCheckContext/
      HealthCheckResult/HealthStatus/HealthCheckRegistration types only, used by
      MassTransitMessageBusProbe (P-347) to invoke MassTransit's own MassTransit.Monitoring.
      BusHealthCheck. Deliberately the Abstractions-only package, not the full
      Microsoft.Extensions.Diagnostics.HealthChecks package (that package's AddHealthChecks()/
      HealthCheckService/publisher-hosted-service machinery is 13.ServiceDefaults's concern —
      this domain ships no IHealthCheck implementation and no AddHealthChecks() wiring.
    -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Allow test project to access internal types (MassTransitMessageBus, MassTransitEventPublisher) -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Messaging.MassTransit.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
