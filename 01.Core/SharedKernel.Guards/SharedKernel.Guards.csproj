<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- NuGet packaging metadata -->
    <PackageId>SharedKernel.Guards</PackageId>
    <Version>1.0.0</Version>
    <Authors>Gresta-Vertex-Labs</Authors>
    <Company>Gresta-Vertex-Labs</Company>
    <Product>Platform.SharedKernel</Product>
    <Description>Two-path guard system for the SharedKernel: Guard.Against.* (functional, returns Error?) and Guard.Throw.* (imperative, throws DomainException). Zero external dependencies. AOT-compatible. Depends on SharedKernel.Primitives and SharedKernel.Core.</Description>
    <PackageTags>shared-kernel;guard;guard-clause;validation;railway-oriented;aot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</PackageProjectUrl>
    <Copyright>Copyright © 2026 Gresta-Vertex-Labs</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\SharedKernel.Core\SharedKernel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude the nested test project from the main project's compilation -->
    <Compile Remove="SharedKernel.Guards.Tests\**" />
    <EmbeddedResource Remove="SharedKernel.Guards.Tests\**" />
    <None Remove="SharedKernel.Guards.Tests\**" />
  </ItemGroup>

</Project>
