<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Description>Translated error messages and user-facing texts for .NET services. Define a message once with typed arguments (LocalizedMessage.Define&lt;Guid&gt;("order.not_found", "Order {orderId} was not found.", "orderId")) and every call site is checked by the compiler. Translations are loaded from JSON files, embedded JSON resources or .resx files, validated at startup, and filled with named placeholders formatted for the caller's culture. Errors built from a message carry their arguments, so the HTTP boundary can show "3f2a… numaralı sipariş bulunamadı." to a Turkish caller and the original English text to everyone else. A missing or broken translation always falls back to the original message, never to a blank or a raw placeholder.</Description>
    <PackageReleaseNotes>First release.</PackageReleaseNotes>
    <PackageTags>shared-kernel;localization;i18n;translation;message-templates;error-messages;json;resx</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Publish bar: ship XML docs, and fail the build on an undocumented or untracked public member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;RS0016;RS0017;RS0024;RS0025</WarningsAsErrors>
    <!-- The Define overloads and the per-arity Format/ToError overloads are intentional. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
