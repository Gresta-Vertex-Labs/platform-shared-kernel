<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <!--
    Consumer verification: resolves SharedKernel.* packages from the local NuGet feed (nupkgs/)
    to confirm the published dependency graph is correct.
    Primitives → Core → Configuration → FeatureManagement chain verified here.
    Cryptography → Primitives + Configuration transitive chain also verified here.
    Compression → Primitives + Configuration transitive chain also verified here.
  -->
  <ItemGroup>
    <PackageReference Include="SharedKernel.Primitives" />
    <PackageReference Include="SharedKernel.Core" />
    <PackageReference Include="SharedKernel.Configuration" />
    <PackageReference Include="SharedKernel.FeatureManagement" />
    <PackageReference Include="SharedKernel.Guards" />
    <PackageReference Include="SharedKernel.Cryptography" />
    <PackageReference Include="SharedKernel.Compression" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
