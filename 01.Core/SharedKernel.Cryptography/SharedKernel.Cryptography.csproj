<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Version>2.0.0</Version>
    <Description>Dependency-free cryptographic primitives for the SharedKernel: secret-agnostic one-way hashing (PBKDF2-HMACSHA256, suitable for passwords, API keys, recovery codes, and other one-way secrets), AES-256-GCM symmetric encryption, RSA/ECDSA asymmetric signing, HMACSHA256 signing, and cryptographically secure random/token generation. Pure BCL System.Security.Cryptography only — zero third-party NuGet dependencies. AOT-compatible. Decoupled from identity/OIDC concerns so non-web worker services can consume it directly. Depends on SharedKernel.Primitives and SharedKernel.Configuration. v2.0.0: IPasswordHasher renamed to IOneWayHasher (breaking) to remove auth-domain vocabulary from a 01.Core primitive.</Description>
    <PackageTags>shared-kernel;cryptography;one-way-hashing;password-hashing;aes-gcm;encryption;signing;rsa;ecdsa;hmac;secure-random;aot</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
  </ItemGroup>
</Project>
