<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Description>Cryptographic building blocks on the .NET base class library, with no third-party dependencies. AES-256-GCM authenticated encryption behind a key provider (async for a KMS, synchronous for keys already in memory), key rotation helpers, envelope encryption and HKDF subkey derivation. Asymmetric signing where each key carries its algorithm (PS256–PS512, RS256–RS512, ES256–ES512). Password and secret hashing in the PHC string format with PBKDF2-SHA256, an optional pepper, and rehash-on-verify migration between algorithms. HMAC-SHA256, SHA-256 content hashing, fixed-time comparison, secure random values, and RFC 4226/6238 HOTP/TOTP with replay protection and recovery codes.</Description>
    <PackageReleaseNotes>First release.</PackageReleaseNotes>
    <PackageTags>shared-kernel;cryptography;aes-gcm;envelope-encryption;hkdf;signing;rsa;ecdsa;hmac;pbkdf2;password-hashing;totp;hotp</PackageTags>
    <!--
      Set per-project, not inherited: the SDK assigns GenerateDocumentationFile=false before
      Directory.Build.targets' '== empty'-guarded default is evaluated, so the central default
      never applies and the package would ship without its XML docs. CS1591 below makes an
      undocumented public member a build error.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API tracking: an addition, removal or signature change fails the build until PublicAPI.*.txt is updated. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
    <!-- RS0026/RS0027 discourage optional parameters on overloads. Stream and memory overloads, and overloads with an
         explicit timestamp, share the same trailing optional parameters so callers name only what they set. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
