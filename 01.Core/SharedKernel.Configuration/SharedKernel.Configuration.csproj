<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Description>Options-pattern validation helpers for the SharedKernel: AddValidatedOptions&lt;TOptions&gt; DI extension that binds, validates via DataAnnotations, and enforces startup-time validation (ValidateOnStart). Depends on SharedKernel.Primitives.</Description>
    <PackageTags>shared-kernel;options;configuration;validation;dependency-injection;aot</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
