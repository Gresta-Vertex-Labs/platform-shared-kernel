<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Adapter</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>Argon2id (RFC 9106) for SharedKernel.Cryptography's IOneWayHasher. Adds an argon2id hash algorithm that writes standard PHC strings ($argon2id$v=19$m=...,t=...,p=...$salt$hash), so hashes interoperate with other Argon2 libraries. Select it with OneWayHashing:Algorithm; existing PBKDF2 hashes keep verifying and are upgraded as users sign in. Stored costs are bounded before any work is done, so a hash written by an attacker cannot exhaust memory or CPU. Uses Konscious.Security.Cryptography.Argon2, a managed implementation with no native code. Argon2id is not FIPS 140-3 approved; keep PBKDF2 where FIPS compliance is required.</Description>
    <PackageReleaseNotes>First release.</PackageReleaseNotes>
    <PackageTags>shared-kernel;cryptography;argon2;argon2id;password-hashing;phc</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API tracking: an addition, removal or signature change fails the build until PublicAPI.*.txt is updated. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Cryptography\SharedKernel.Cryptography.csproj" />
    <ProjectReference Include="..\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
