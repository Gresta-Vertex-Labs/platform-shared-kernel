<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Abstractions</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>AI / vector-retrieval abstraction contracts for Platform.SharedKernel microservices: IEmbeddingGenerator (text-to-vector, batched, token-usage-accounted), IVectorCollection&lt;TRecord&gt; (upsert/delete/query/get/count/scroll with mandatory model-identity/dimension/tenant-scope validation before any I/O), IVectorCollectionProvisioner (ensure/exists/delete/cutover/probe), IVectorProviderDescriptor and ICompletionProviderDescriptor (ceilings + zero-I/O pre-flight validation), ISemanticKernel (stateless chat/completion orchestration — no tool execution, no retry, no caching), the closed 8-node VectorFilter AST over the closed five-kind VectorValue scalar union, and the Result-valued IntelligenceErrors factory. Zero third-party NuGet dependencies — references only SharedKernel.Primitives. Implemented by SharedKernel.AI.Qdrant, SharedKernel.AI.Milvus, and SharedKernel.AI.SemanticKernel.</Description>
    <PackageTags>ai;vector-database;embeddings;rag;llm;qdrant;milvus;semantic-kernel;shared-kernel</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Zero third-party NuGet dependencies (the seam rule, WO-045/P-279) — the only reference is
      SharedKernel.Primitives (Result<T>/Result/Error/IClock/LoggingEventIdRanges). No vector-DB SDK,
      no model SDK, no Microsoft.Extensions.* package (not even DependencyInjection.Abstractions — no
      DI extension lives here), and no Microsoft.Extensions.AI.Abstractions (explicitly adjudicated and
      declined, see 10.Intelligence/CLAUDE.md). System.Text.Json and System.Security.Cryptography
      (SHA-256 for VectorCollectionDefinition.Fingerprint) are in-box on net10.0.
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Execution\SharedKernel.Execution.csproj" />
  </ItemGroup>
</Project>
