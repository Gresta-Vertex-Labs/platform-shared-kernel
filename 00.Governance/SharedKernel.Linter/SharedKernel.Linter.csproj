<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Content-only package ships no assembly, so a symbol package would be empty and fail NU5017. Overrides Directory.Build.props. -->
    <IncludeSymbols>false</IncludeSymbols>
    <!-- Required: without it this content-only package packs nothing and fails NU5017. -->
    <ContentTargetFolders>content</ContentTargetFolders>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <IsPackable>true</IsPackable>
    <!-- NuGet packaging metadata -->
    <Version>1.0.0</Version>
    <Description>Content-only NuGet package that distributes SharedKernel's .editorconfig, .csharpierrc.json, and MSBuild props/targets for CSharpier formatting enforcement. Reference with PrivateAssets="all". Ships no DLL.</Description>
    <PackageTags>editorconfig;csharpier;linter;sharedkernel;governance;formatting</PackageTags>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="content\.editorconfig" PackagePath="content/.editorconfig" />
    <Content Include="content\.csharpierrc.json" PackagePath="content/.csharpierrc.json" />
    <Content Include="content\build\SharedKernel.Linter.props" PackagePath="content/build/SharedKernel.Linter.props" />
    <Content Include="content\build\SharedKernel.Linter.targets" PackagePath="content/build/SharedKernel.Linter.targets" />
  </ItemGroup>
</Project>
