<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Roslyn analyzers MUST target netstandard2.0 — the compiler will not load any other TFM.
         This deliberately overrides Directory.Build.props' net10.0 default. Do not remove. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- NuGet packaging metadata -->
    <Description>Roslyn diagnostic analyzers enforcing SharedKernel coding standards. Ships no runtime DLL — compiler-only. 44 rules: core standards (SK0001–SK0011, SK0037–SK0039), application and communication (SK0013–SK0019), logging authoring (SK0020–SK0021), cross-cutting concerns (SK0022–SK0036), persistence (SK0201–SK0202), and messaging (SK0703–SK0705, SK0708). Gaps in the numbering are NetArchTest predicates that live in SharedKernel.ArchitectureTests, not analyzers. All rules default to Warning; escalate per rule via .editorconfig.</Description>
    <PackageTags>roslyn;analyzer;sharedkernel;governance</PackageTags>
    <!-- Analyzer packages ship no runtime assembly and are development-only dependencies -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Analyzer ships no runtime assembly, so a symbol package would be empty and fail NU5017. Overrides Directory.Build.props. -->
    <IncludeSymbols>false</IncludeSymbols>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoPackageAnalysis>true</NoPackageAnalysis>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exclude nested test project obj/bin from the parent compile glob -->
    <Compile Remove="SharedKernel.Analyzers.Tests\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
  <!-- Place the compiled analyzer assembly under analyzers/dotnet/cs in the NuGet package -->
  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>
