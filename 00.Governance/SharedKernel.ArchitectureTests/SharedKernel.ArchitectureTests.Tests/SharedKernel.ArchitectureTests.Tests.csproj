<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" PrivateAssets="all" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <!-- Provides NetArchTest.Rules and Mono.Cecil transitively -->
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <!-- Roslyn CSharpCompilation for in-memory fixture assembly generation in T-12 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.ArchitectureTests.csproj" />
    <!-- Required to resolve SharedKernel.Guards.Clauses.IGuardClause in GuardPurityRulesTests -->
    <ProjectReference Include="..\..\..\01.Core\SharedKernel.Guards\SharedKernel.Guards.csproj"
                      PrivateAssets="all" />
    <!-- Required to resolve typeof(IDomainService)/typeof(DomainService) in DomainGoldStandard/DomainLayerPurity tests -->
    <ProjectReference Include="..\..\..\03.Domain\SharedKernel.Domain\SharedKernel.Domain.csproj"
                      PrivateAssets="all" />
    <!-- Required to resolve typeof(IIntegrationEvent) in ContractsPurityRules tests -->
    <ProjectReference Include="..\..\..\04.Contracts\SharedKernel.Contracts\SharedKernel.Contracts.csproj"
                      PrivateAssets="all" />
    <!-- Required to resolve the five-package Redis topology assemblies in RedisTopologyRulesTests -->
    <ProjectReference Include="..\..\..\02.Caching\SharedKernel.Caching.Abstractions\SharedKernel.Caching.Abstractions.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\..\02.Caching\SharedKernel.Caching.Redis.Core\SharedKernel.Caching.Redis.Core.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\..\02.Caching\SharedKernel.Caching.Redis\SharedKernel.Caching.Redis.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\..\02.Caching\SharedKernel.Caching.Redis.DistributedLocking\SharedKernel.Caching.Redis.DistributedLocking.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\..\02.Caching\SharedKernel.Caching.Redis.HashStore\SharedKernel.Caching.Redis.HashStore.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\..\02.Caching\SharedKernel.Caching.Redis.PubSub\SharedKernel.Caching.Redis.PubSub.csproj"
                      PrivateAssets="all" />
    <!-- Required to resolve the messaging assemblies in RedisTopologyRulesTests -->
    <ProjectReference Include="..\..\..\07.Messaging\SharedKernel.Messaging.Abstractions\SharedKernel.Messaging.Abstractions.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\..\07.Messaging\SharedKernel.Messaging.MassTransit\SharedKernel.Messaging.MassTransit.csproj"
                      PrivateAssets="all" />
    <!-- Required to resolve the real SharedKernel.Communication.Grpc assembly in
         CommunicationLayeringRulesTests.GrpcNeverReferencesContracts pass-path test (T-128) -->
    <ProjectReference Include="..\..\..\11.Communication\SharedKernel.Communication.Grpc\SharedKernel.Communication.Grpc.csproj"
                      PrivateAssets="all" />
  </ItemGroup>

</Project>
