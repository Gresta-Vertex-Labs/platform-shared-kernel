<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" PrivateAssets="all" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <!-- Provides NetArchTest.Rules and Mono.Cecil transitively -->
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <!-- Roslyn CSharpCompilation for in-memory fixture assembly generation in T-12 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- MediatR pinned to match 05.Application/SharedKernel.Application.Behaviors's own pin
         (see that project's version-pin note) — needed to reference MediatR.IStreamRequest<>/
         IPipelineBehavior<,> as extraReferences when compiling WO-036 P-225 fixture assemblies
         in ApplicationPipelineRulesTests. NuGet-only; 00.Governance never references
         05.Application (layering: 00.Governance references nothing). -->
    <PackageReference Include="MediatR" Version="12.4.1" />
    <!-- Concrete DI container needed for T-153's IServiceCollection fixture in
         PipelineOrderAssertionTests (BuildServiceProvider is never called, but
         AddTransient/AddScoped extension methods require the concrete package). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <!-- Provides LoggerMessageAttribute for compiling contrived [LoggerMessage] fixture
         assemblies in LoggingEventIdIntegrityAssertionTests (WO-041 P-250). Safe to reference
         directly here (unlike the CSharpAnalyzerTest sandbox in SharedKernel.Analyzers.Tests) —
         fixture assemblies compiled via CompileInMemory run in-process against the current
         runtime's own corelib, so there is no reference-assembly version mismatch. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.ArchitectureTests.csproj" />
    <!-- Required to resolve SharedKernel.Guards.Clauses.IGuardClause in GuardPurityRulesTests -->
    <ProjectReference Include="..\..\..\01.Core\SharedKernel.Guards\SharedKernel.Guards.csproj"
                      PrivateAssets="all" />
    <!-- Required to resolve typeof(IDomainService)/typeof(DomainService) in DomainGoldStandard/DomainLayerPurity tests -->
    <ProjectReference Include="..\..\..\03.Domain\SharedKernel.Domain\SharedKernel.Domain.csproj"
                      PrivateAssets="all" />
    <!-- Required to resolve typeof(IIntegrationEvent) in ContractsPurityRules tests -->
    <ProjectReference Include="..\..\..\04.Contracts\SharedKernel.Contracts\SharedKernel.Contracts.csproj"
                      PrivateAssets="all" />
    <!-- Required to resolve the five-package Redis topology assemblies in RedisTopologyRulesTests -->
    <ProjectReference Include="..\..\..\02.Caching\SharedKernel.Caching.Abstractions\SharedKernel.Caching.Abstractions.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\..\02.Caching\SharedKernel.Caching.Redis.Core\SharedKernel.Caching.Redis.Core.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\..\02.Caching\SharedKernel.Caching.Redis\SharedKernel.Caching.Redis.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\..\02.Caching\SharedKernel.Caching.Redis.DistributedLocking\SharedKernel.Caching.Redis.DistributedLocking.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\..\02.Caching\SharedKernel.Caching.Redis.HashStore\SharedKernel.Caching.Redis.HashStore.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\..\02.Caching\SharedKernel.Caching.Redis.PubSub\SharedKernel.Caching.Redis.PubSub.csproj"
                      PrivateAssets="all" />
    <!-- Required to resolve the messaging assemblies in RedisTopologyRulesTests -->
    <ProjectReference Include="..\..\..\07.Messaging\SharedKernel.Messaging.Abstractions\SharedKernel.Messaging.Abstractions.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\..\07.Messaging\SharedKernel.Messaging.MassTransit\SharedKernel.Messaging.MassTransit.csproj"
                      PrivateAssets="all" />
    <!-- Required to resolve the real SharedKernel.Communication.Grpc assembly in
         CommunicationLayeringRulesTests.GrpcNeverReferencesContracts pass-path test (T-128) -->
    <ProjectReference Include="..\..\..\11.Communication\SharedKernel.Communication.Grpc\SharedKernel.Communication.Grpc.csproj"
                      PrivateAssets="all" />
    <!-- Test-only reference to the REAL compiled SharedKernel.Application assembly, required by
         WO-039 P-240 (SK.00.DomainEventDispatcherReflectionExemption) to point
         ReflectionGuardRules.NoMakeGenericMethodReflection at MediatRDomainEventDispatcher's actual
         compiled IL rather than a contrived fixture. Test-project-only ProjectReference — does not
         violate the "00.Governance references nothing" layering rule (production references only). -->
    <ProjectReference Include="..\..\..\05.Application\SharedKernel.Application\SharedKernel.Application.csproj"
                      PrivateAssets="all" />
    <!-- Required to resolve the real SharedKernel.Storage.Abstractions/.S3/.Obs assemblies in
         StorageTopologyRulesTests (WO-043 P-271) — 08.Storage reached Published (P-265/P-266/
         P-267 all shipped) before this phase's implementation session, so real-assembly
         verification is wired alongside the contrived-fixture proof rather than deferred. -->
    <ProjectReference Include="..\..\..\08.Storage\SharedKernel.Storage.Abstractions\SharedKernel.Storage.Abstractions.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\..\08.Storage\SharedKernel.Storage.S3\SharedKernel.Storage.S3.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\..\08.Storage\SharedKernel.Storage.Obs\SharedKernel.Storage.Obs.csproj"
                      PrivateAssets="all" />
    <!-- Required to resolve the real SharedKernel.Search.Abstractions/.Meilisearch/.ElasticSearch
         assemblies in SearchTopologyRulesTests (WO-044 P-278) — 09.Search reached Published
         (139/139 tasks, P-272/P-273/P-274 all shipped) before this phase's implementation
         session, so real-assembly verification is wired alongside the contrived-fixture proof
         rather than deferred, mirroring the StorageTopologyRulesTests precedent — this phase's
         own acceptance criteria treat real-assembly verification as GATING, not optional. -->
    <ProjectReference Include="..\..\..\09.Search\SharedKernel.Search.Abstractions\SharedKernel.Search.Abstractions.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\..\09.Search\SharedKernel.Search.Meilisearch\SharedKernel.Search.Meilisearch.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\..\09.Search\SharedKernel.Search.ElasticSearch\SharedKernel.Search.ElasticSearch.csproj"
                      PrivateAssets="all" />
  </ItemGroup>

</Project>
