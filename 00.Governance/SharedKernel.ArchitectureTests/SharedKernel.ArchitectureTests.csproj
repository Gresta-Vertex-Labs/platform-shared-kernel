<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- NuGet packaging metadata -->
    <Description>NetArchTest-based base classes and pre-built layering-rule predicates for SharedKernel architecture tests. Reference with PrivateAssets="all" — this package must never become a transitive production dependency.</Description>
    <PackageTags>architecture;netarchtest;sharedkernel;governance;testing</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- Expose internal test-support helpers (Register/Unregister on ReflectionExemptionRegistry)
         to the nested test project so T-115 can exercise the exemption path. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>SharedKernel.ArchitectureTests.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Exclude nested test project from the parent compile glob -->
    <Compile Remove="SharedKernel.ArchitectureTests.Tests\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Mono.Cecil" />
    <!-- Required to resolve IServiceCollection/ServiceDescriptor for PipelineOrderAssertion
         (WO-036 P-225). Abstractions-only package — no concrete DI container dependency. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- SharedKernel.Guards was merged into SharedKernel.Core (WO-082/P-505); the C# namespace
         (SharedKernel.Guards.*) was deliberately preserved. Reference required to resolve
         typeof(IGuardClause) in GuardPurityRules — GuardPurityRules re-scopes its purity check
         to the SharedKernel.Guards namespace specifically (via DoesNotContainThrowIlPredicate),
         since SharedKernel.Core also hosts unrelated types (base exceptions, BCL/railway
         extensions). PrivateAssets="all" prevents transitive leakage to production code. -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Core\SharedKernel.Core.csproj" PrivateAssets="all" />
    <!-- Domain reference required to resolve typeof(IDomainService) and typeof(DomainService) in
         DomainGoldStandardRules and DomainLayerPurityRules.
         PrivateAssets="all" prevents transitive leakage to production code. -->
    <ProjectReference Include="..\..\03.Domain\SharedKernel.Domain\SharedKernel.Domain.csproj" PrivateAssets="all" />
    <!-- Contracts reference required to resolve typeof(IIntegrationEvent) in ContractsPurityRules.
         PrivateAssets="all" prevents transitive leakage to production code. -->
    <ProjectReference Include="..\..\04.Contracts\SharedKernel.Contracts\SharedKernel.Contracts.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
