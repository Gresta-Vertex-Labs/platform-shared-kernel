<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>

    <!-- NuGet packaging metadata -->
    <PackageId>SharedKernel.ArchitectureTests</PackageId>
    <Version>1.0.0</Version>
    <Authors>Gresta-Vertex-Labs</Authors>
    <Description>NetArchTest-based base classes and pre-built layering-rule predicates for SharedKernel architecture tests. Reference with PrivateAssets="all" — this package must never become a transitive production dependency.</Description>
    <PackageTags>architecture;netarchtest;sharedkernel;governance;testing</PackageTags>
    <PackageProjectUrl>https://github.com/gresta-vertex-labs/platform-shared-kernel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gresta-vertex-labs/platform-shared-kernel</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal test-support helpers (Register/Unregister on ReflectionExemptionRegistry)
         to the nested test project so T-115 can exercise the exemption path. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>SharedKernel.ArchitectureTests.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Exclude nested test project from the parent compile glob -->
    <Compile Remove="SharedKernel.ArchitectureTests.Tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <!-- Required to resolve IServiceCollection/ServiceDescriptor for PipelineOrderAssertion
         (WO-036 P-225). Abstractions-only package — no concrete DI container dependency. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Guards reference required to resolve typeof(IGuardClause) in GuardPurityRules.
         PrivateAssets="all" prevents transitive leakage to production code. -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Guards\SharedKernel.Guards.csproj"
                      PrivateAssets="all" />
    <!-- Domain reference required to resolve typeof(IDomainService) and typeof(DomainService) in
         DomainGoldStandardRules and DomainLayerPurityRules.
         PrivateAssets="all" prevents transitive leakage to production code. -->
    <ProjectReference Include="..\..\03.Domain\SharedKernel.Domain\SharedKernel.Domain.csproj"
                      PrivateAssets="all" />
    <!-- Contracts reference required to resolve typeof(IIntegrationEvent) in ContractsPurityRules.
         PrivateAssets="all" prevents transitive leakage to production code. -->
    <ProjectReference Include="..\..\04.Contracts\SharedKernel.Contracts\SharedKernel.Contracts.csproj"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
