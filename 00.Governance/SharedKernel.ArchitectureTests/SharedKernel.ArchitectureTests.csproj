<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- Test-only infrastructure: NuGet marks the package so it never flows transitively
         into a consumer's production dependency graph. This makes the README's
         PrivateAssets="all" guidance structural rather than advisory. -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- Ship the XML documentation alongside the assembly: every rule's purpose, its offending
         and compliant patterns, and its parameters are carried in the doc comments, and that is
         the only form in which they reach a consumer's IntelliSense (or an agent reading the
         package). Set explicitly here rather than relying on the repo-wide default in
         Directory.Build.targets, whose '$(GenerateDocumentationFile)' == '' guard can never
         match — the .NET SDK defaults the property to false earlier in the import chain.
         CS1591 is clean for this project: every public member is documented. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- NuGet packaging metadata -->
    <Description>Pre-built NetArchTest architecture rules for the SharedKernel platform: layering direction, domain purity, provider isolation, forbidden injection patterns, and IL-level secure-default assertions. Assert them from your own test suite with any runner and any assertion library. Test-only development dependency — never flows into a production dependency graph.</Description>
    <PackageTags>architecture;netarchtest;sharedkernel;governance;testing</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- Expose internal test-support helpers (Register/Unregister on ReflectionExemptionRegistry)
         to the nested test project so T-115 can exercise the exemption path. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>SharedKernel.ArchitectureTests.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Exclude nested test project from the parent compile glob -->
    <Compile Remove="SharedKernel.ArchitectureTests.Tests\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="Mono.Cecil" />
    <!-- Required to resolve IServiceCollection/ServiceDescriptor for PipelineOrderAssertion
         (WO-036 P-225). Abstractions-only package — no concrete DI container dependency. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
