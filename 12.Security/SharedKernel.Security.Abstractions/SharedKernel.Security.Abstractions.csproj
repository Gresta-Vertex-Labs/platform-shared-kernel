<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NuGet packaging metadata -->
    <PackageId>SharedKernel.Security.Abstractions</PackageId>
    <Version>3.0.0</Version>
    <Authors>Gresta-Vertex-Labs</Authors>
    <Company>Gresta-Vertex-Labs</Company>
    <Product>Platform.SharedKernel</Product>
    <Description>Zero-dependency security abstractions for SharedKernel: IUserContext, ITenantProvider, IdentityKind, AnonymousUserContext, SystemUserContext, SecurityClaimTypes. References only SharedKernel.Primitives. AOT-safe.</Description>
    <PackageTags>shared-kernel;security;identity;user-context;tenant;abstractions;aot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>3.0.0 (breaking): IUserContext gains six new step-up-authentication members — AuthenticationMethods, AuthContextClassReference, AuthTime, IsSenderConstrained, WasAuthenticatedWith(string), and IsAuthenticationFresherThan(TimeSpan, DateTimeOffset) — every implementer of IUserContext outside this package must be updated to add them. AnonymousUserContext/SystemUserContext updated with sentinel values (empty/null/false). See WO-058 (P-375/P-376). 2.0.0 (breaking): IUserContext gained IdentityKind and Permissions/HasPermission; added the IdentityKind enum and the SystemUserContext sentinel. See WO-057 (P-367/P-368/P-369).</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</PackageProjectUrl>
    <Copyright>Copyright © 2026 Gresta-Vertex-Labs</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude the nested test project from the main project's compilation -->
    <Compile Remove="SharedKernel.Security.Abstractions.Tests\**" />
    <EmbeddedResource Remove="SharedKernel.Security.Abstractions.Tests\**" />
    <None Remove="SharedKernel.Security.Abstractions.Tests\**" />
  </ItemGroup>

</Project>
