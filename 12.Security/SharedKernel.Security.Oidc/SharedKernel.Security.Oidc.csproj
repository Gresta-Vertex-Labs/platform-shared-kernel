<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NuGet packaging metadata -->
    <PackageId>SharedKernel.Security.Oidc</PackageId>
    <Version>3.0.0</Version>
    <Authors>Gresta-Vertex-Labs</Authors>
    <Company>Gresta-Vertex-Labs</Company>
    <Product>Platform.SharedKernel</Product>
    <Description>OIDC/JWT implementation for SharedKernel security: OidcUserContext, OidcTenantProvider, SecurityOptions (AddValidatedOptions) with configurable ClaimMapping, AddSharedKernelSecurity and AddAzureB2CAuthentication DI extensions, opt-in DPoP (RFC 9449) sender-constrained tokens and RFC 7662-shaped token revocation via SecurityAuthenticationBuilder, structured security-audit logging. Depends on SharedKernel.Security.Abstractions and Microsoft.Identity.Web.</Description>
    <PackageTags>shared-kernel;security;oidc;jwt;azure-b2c;identity;dependency-injection;dpop</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>3.0.0 (breaking, tracks SharedKernel.Security.Abstractions 3.0.0): OidcUserContext now resolves the six new step-up-authentication IUserContext members (AuthenticationMethods/AuthContextClassReference/AuthTime from amr/acr/auth_time claims, IsSenderConstrained from a successful DPoP proof validation). Adds SecurityAuthenticationBuilder (returned in place of a bare IServiceCollection, source-compatible) with opt-in .RequireDpop&lt;TReplayCache&gt;() and .WithRevocationCheck&lt;TCheck&gt;() extension points. See WO-058 (P-375/P-376/P-379). 2.0.0 (breaking, tracks SharedKernel.Security.Abstractions 2.0.0): OidcUserContext now resolves IdentityKind (Anonymous/User/ServicePrincipal) and Permissions/HasPermission from the scope/scp claim. Claim-type resolution (Email/Name/Role/Permission) is now configurable per identity provider via SecurityOptions.ClaimMapping, matching modern short-name OIDC defaults instead of legacy ClaimTypes.* URIs. See WO-057 (P-366/P-367/P-368/P-371).</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</PackageProjectUrl>
    <Copyright>Copyright © 2026 Gresta-Vertex-Labs</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Security.Abstractions\SharedKernel.Security.Abstractions.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.AspNetCore.Authentication.JwtBearer: JWT Bearer validation.
      AOT note: JWT token parsing uses internal reflection in some code paths.
      Encapsulated behind IUserContext so the AOT blast radius is limited to the DI registration path.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <!--
      Microsoft.Identity.Web: Azure B2C / Entra External ID authority/audience wiring.
      AOT note: Microsoft.Identity.Web is not fully AOT-safe. Isolated to AddAzureB2CAuthentication
      extension only. A swap to a lighter JWT-only path does not require abstraction changes.
    -->
    <PackageReference Include="Microsoft.Identity.Web" Version="3.10.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude the nested test project from the main project's compilation -->
    <Compile Remove="SharedKernel.Security.Oidc.Tests\**" />
    <EmbeddedResource Remove="SharedKernel.Security.Oidc.Tests\**" />
    <None Remove="SharedKernel.Security.Oidc.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Grants SharedKernel.Security.Oidc.Tests direct access to internal types (DpopProofValidator,
      RevocationCheckRunner, DpopClaimTypes) so the DPoP (RFC 9449) proof-validation algorithm and the
      revocation-check fail-closed contract can be proven directly (WO-058, T-22/T-23/T-27/T-28) —
      mirrors SharedKernel.Security.ApiKey's identical InternalsVisibleTo grant for ConstantTimeKeyComparer.
    -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Security.Oidc.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
