<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Host</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>TOTP second factor and step-up authentication for ASP.NET Core on SharedKernel.Cryptography: enrollment with confirmation of the first code, recovery codes hashed at rest and redeemed once, attempt throttling, and a claims transformation that adds the otp authentication method to the caller's sign-in session for a configurable window, so IUserContext.WasAuthenticatedWith("otp") and step-up authorization attributes see it. A step-up applies to the session it was completed in, never to the user's other sessions or tokens.</Description>
    <PackageReleaseNotes>First release.</PackageReleaseNotes>
    <PackageTags>shared-kernel;security;totp;mfa;two-factor;step-up;recovery-codes;authentication</PackageTags>
    <!--
      Set per-project, not inherited: the SDK assigns GenerateDocumentationFile=false before
      Directory.Build.targets' '== empty'-guarded default is evaluated. CS1591 below makes an
      undocumented public member a build error.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API tracking: an addition, removal or signature change fails the build until PublicAPI.*.txt is updated. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
    <!-- RS0026/RS0027 discourage optional parameters; the service methods share trailing optional parameters. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Security.Abstractions\SharedKernel.Security.Abstractions.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Cryptography\SharedKernel.Cryptography.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.Security.Totp.Tests" />
  </ItemGroup>
</Project>
