<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Security.Totp.csproj" />
    <ProjectReference Include="..\..\..\16.Testing\SharedKernel.Testing\SharedKernel.Testing.csproj" />
    <ProjectReference Include="..\..\..\16.Testing\SharedKernel.Cryptography.Testing\SharedKernel.Cryptography.Testing.csproj" />
    <ProjectReference Include="..\..\..\16.Testing\SharedKernel.Security.Testing\SharedKernel.Security.Testing.csproj" />
    <!--
      T-46 cross-package interop test ONLY: proves a ClaimsPrincipal transformed by
      TotpStepUpClaimsTransformation, fed into .Oidc's REAL OidcUserContext constructor, resolves
