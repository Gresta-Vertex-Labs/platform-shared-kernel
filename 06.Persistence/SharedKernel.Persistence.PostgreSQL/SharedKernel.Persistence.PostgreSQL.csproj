<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>SharedKernel.Persistence.PostgreSQL</PackageId>
    <Description>PostgreSQL-specific EF Core conventions for SharedKernel: SnakeCaseNamingConvention, JSONB column support, pgvector support, NpgsqlConnectionFactory, and AddSharedKernelPostgreSQL DI extension.</Description>
    <Version>1.0.0</Version>
    <Authors>Gresta-Vertex-Labs</Authors>
    <RepositoryUrl>https://github.com/gresta-vertex-labs/platform-shared-kernel</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Persistence.EfCore\SharedKernel.Persistence.EfCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude the nested test project from the main project's compilation -->
    <Compile Remove="SharedKernel.Persistence.PostgreSQL.Tests\**" />
    <EmbeddedResource Remove="SharedKernel.Persistence.PostgreSQL.Tests\**" />
    <None Remove="SharedKernel.Persistence.PostgreSQL.Tests\**" />
  </ItemGroup>

</Project>
