<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>PostgreSQL-specific EF Core conventions for SharedKernel: SnakeCaseNamingConvention, the xmin-backed concurrency-token convention, JSONB column support, pgvector support, and UsePostgreSQL()/AddSharedKernelPostgreSQL() DI extensions built on SharedKernel.Persistence.Npgsql's shared NpgsqlDataSource.</Description>
    <PackageTags>persistence;postgresql;npgsql;jsonb;pgvector;shared-kernel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Persistence.EfCore\SharedKernel.Persistence.EfCore.csproj" />
    <!--
      P-557/W1: NpgsqlConnectionFactory and the shared NpgsqlDataSource registration moved to this
      new sibling package (Npgsql-only, no EF Core reference) — AddSharedKernelPostgreSQL now
      delegates to SharedKernel.Persistence.Npgsql's AddSharedKernelNpgsql() rather than building
      its own NpgsqlDataSource.
    -->
    <ProjectReference Include="..\SharedKernel.Persistence.Npgsql\SharedKernel.Persistence.Npgsql.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <!-- P-557/W4: conventions (SnakeCaseNamingConvention, XminConcurrencyTokenConvention,
         XminRowVersionValueConverter) are internal implementation detail, reached by consumers only
         through UsePostgreSQL() — this grant lets the Tests project exercise them directly. -->
    <InternalsVisibleTo Include="SharedKernel.Persistence.PostgreSQL.Tests" />
  </ItemGroup>
</Project>
