<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Append-only, hash-chained audit-trail EF Core implementation for SharedKernel: AuditRecordEntityConfiguration, AuditRecordImmutabilityInterceptor, EfAuditTrailWriter, and EfAuditQueryService.</Description>
    <PackageTags>persistence;efcore;audit-trail;shared-kernel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!--
      P-557/W1: this capability moved out of SharedKernel.Persistence.EfCore into its own package.
      Contributes back into EfCore's SharedKernelDbContext purely through the
      IPersistenceModelConfigurator extensibility interface and the builder's public
      Services/AddInterceptor surface — never a compile-time reference the other direction.
    -->
    <ProjectReference Include="..\SharedKernel.Persistence.EfCore\SharedKernel.Persistence.EfCore.csproj" />
    <!--
      IContentHasher (hash-chain digest) — the consuming service must additionally call
      01.Core's AddSharedKernelCryptography() for it to resolve.
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Cryptography\SharedKernel.Cryptography.csproj" />
    <!-- AuditChainOptions : ISectionBoundOptions / AddValidatedOptions. -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.Persistence.EfCore.Auditing.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
