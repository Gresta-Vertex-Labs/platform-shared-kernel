<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Npgsql-only (no EF Core) PostgreSQL connection infrastructure for SharedKernel: NpgsqlConnectionFactory and the shared NpgsqlDataSource DI registration consumed by both SharedKernel.Persistence.EfCore and SharedKernel.Persistence.Dapper, plus the reusable PostgresException SQLSTATE classifier.</Description>
    <PackageTags>persistence;postgresql;npgsql;shared-kernel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!--
      P-557/W1: Abstractions-only — no EF Core reference. NpgsqlConnectionFactory implements
      IDbConnectionFactory (SharedKernel.Persistence.Abstractions) directly over a plain Npgsql
      NpgsqlDataSource; nothing here depends on Microsoft.EntityFrameworkCore or
      Npgsql.EntityFrameworkCore.PostgreSQL.
    -->
    <ProjectReference Include="..\SharedKernel.Persistence.Abstractions\SharedKernel.Persistence.Abstractions.csproj" />
    <!-- Options-bound configuration (ISectionBoundOptions/AddValidatedOptions) — 01.Core, within the
         06.Persistence -> 01-05 layering ceiling. -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <!-- P-558/W1b: ADO-level pgvector type mapping on the shared data source (NpgsqlPersistenceOptions.UseVector). -->
    <PackageReference Include="Pgvector" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- P-558/W2-N: the row-level security startup check is an IHostedService; IHostEnvironment relaxes the TLS rule in Development. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <!-- P-557/W7: AdvisoryLockKeyHasher (and other implementation detail) is internal, reached by
         consumers only through NpgsqlAdvisoryMigrationLock/NpgsqlAdvisoryTransactionLock — this grant
         lets the Tests project exercise it directly. -->
    <InternalsVisibleTo Include="SharedKernel.Persistence.Npgsql.Tests" />
    <InternalsVisibleTo Include="SharedKernel.Persistence.Dapper.Tests" />
  </ItemGroup>
</Project>
