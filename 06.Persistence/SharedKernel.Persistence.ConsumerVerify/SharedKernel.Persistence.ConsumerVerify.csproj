<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <!--
    Consumer verification: resolves all seven 06.Persistence packages as packages, never as
    projects, to confirm the packed dependency graph, the SKPKG003 README requirement, and the
    public API work for a real consumer. Point restore at the feed under test (defaults to the
    local nupkgs/ feed NuGet.Config already maps every SharedKernel.* id to), and pin the version
    with -p:SharedKernelPackageVersion=<version>.

    Deliberately no Testcontainers/real PostgreSQL here — that is the job of each package's own
    nested .Tests project. This project proves the PACKED artifacts compose and the DI surface
    wires up correctly; SQLite in-memory stands in for the EF Core proof, and the PostgreSQL/Npgsql
    -specific registrations are proven by successful DI construction only (NpgsqlDataSource/
    connection-factory construction is lazy and never opens a connection until first use).
  -->
  <ItemGroup>
    <PackageReference Include="SharedKernel.Persistence.Abstractions" />
    <PackageReference Include="SharedKernel.Persistence.EfCore" />
    <PackageReference Include="SharedKernel.Persistence.EfCore.Auditing" />
    <PackageReference Include="SharedKernel.Persistence.EfCore.Encryption" />
    <PackageReference Include="SharedKernel.Persistence.Dapper" />
    <PackageReference Include="SharedKernel.Persistence.Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharedKernel.Cryptography" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
