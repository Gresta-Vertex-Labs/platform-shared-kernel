<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <!--
    Consumer verification: resolves the 06.Persistence packages as packages, never as projects, to confirm
    the packed dependency graph, the SKPKG003 README requirement, and the public API work for a real
    consumer. Point restore at the feed under test (defaults to the local nupkgs/ feed NuGet.Config already
    maps every SharedKernel.* id to), and pin the version with -p:SharedKernelPackageVersion=<version>.

    Registration tests never open a connection (NpgsqlDataSource and context construction are lazy). The one
    composed scenario test runs against a Testcontainers PostgreSQL and exercises the one-line entry point with
    multi-tenancy + row-level security + audit trail + field encryption + retry together.
  -->
  <ItemGroup>
    <PackageReference Include="SharedKernel.Persistence.Abstractions" />
    <PackageReference Include="SharedKernel.Persistence.EfCore" />
    <PackageReference Include="SharedKernel.Persistence.EfCore.Auditing" />
    <PackageReference Include="SharedKernel.Persistence.EfCore.Encryption" />
    <PackageReference Include="SharedKernel.Persistence.Dapper" />
    <PackageReference Include="SharedKernel.Persistence.Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharedKernel.Cryptography" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
