<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Persistence.EfCore.csproj" />
    <ProjectReference Include="..\..\..\16.Testing\SharedKernel.Testing\SharedKernel.Testing.csproj" />
    <!-- P-557/W1: the former P-228 05.Application.Behaviors dual-interface IUnitOfWork bridge (and
         its EfUnitOfWorkDualInterfaceTests.cs proof) moved to
         13.ServiceDefaults/SharedKernel.ServiceDefaults.Persistence, which is legally positioned to
         reference both this package and 05.Application.Behaviors — this project no longer needs
         that reference. -->
    <!--
      P-557/W2 (coordinator follow-up): the Postgres/ folder is a genuine integration-test suite
      proving EfCore data-path fixes against REAL PostgreSQL (Testcontainers) rather than SQLite —
      SharedKernel.Persistence.EfCore itself still never references Npgsql (that hard rule is about
      PRODUCTION code); this TEST project referencing the PostgreSQL provider package is the same
      pattern SharedKernel.Persistence.PostgreSQL.Tests already uses, just from the EfCore side, so
      xmin-bound concurrency tokens (UsePostgreSQL()) are genuinely exercised, not merely a raw
      bytea column that never changes on UPDATE.
    -->
    <ProjectReference Include="..\..\SharedKernel.Persistence.PostgreSQL\SharedKernel.Persistence.PostgreSQL.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!--
      WO-071/P-457: audit-trail tests only — see Directory.Packages.props for why SQLite cannot
      be used to test AuditRecord's DateTimeOffset-ordered hash-chain/keyset queries.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>
</Project>
