<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>EF Core 10 implementation of SharedKernel persistence abstractions: repositories, unit of work, interceptors (Audit, SoftDelete, Concurrency), specification evaluator, TenantedDbContext, field-level encryption, DbContext pooling, and EfCorePersistenceBuilder.</Description>
    <Version>1.0.0</Version>
    <PackageTags>persistence;efcore;entity-framework;repository;unit-of-work;shared-kernel</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Persistence.Abstractions\SharedKernel.Persistence.Abstractions.csproj" />
    <ProjectReference Include="..\..\03.Domain\SharedKernel.Domain\SharedKernel.Domain.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Core\SharedKernel.Core.csproj" />
    <!--
      Deliberate layering exception (P-078): SharedKernel.Security.Abstractions is a
      zero-dependency interface library (no ORM, no infrastructure). The reference is
      required for IUserContext (AuditInterceptor, SoftDeleteInterceptor) and
      ITenantProvider (TenantedDbContext). Maintaining local interface copies would
      create divergence risk. All other 12.Security.* packages are forbidden here.
    -->
    <ProjectReference Include="..\..\12.Security\SharedKernel.Security.Abstractions\SharedKernel.Security.Abstractions.csproj" />
    <!--
      P-227: EncryptedValueConverter delegates all AES-256-GCM cryptographic operations to
      ISymmetricEncryptionService from 01.Core/SharedKernel.Cryptography. Legal under existing
      layering rules (06.Persistence may reference 01-05). No layering exception needed.
      BCL-only, zero transitive NuGet dependencies introduced.
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Cryptography\SharedKernel.Cryptography.csproj" />
    <!--
      P-228: EfUnitOfWork implements SharedKernel.Application.Behaviors.IUnitOfWork in addition
      to SharedKernel.Persistence.Abstractions.IUnitOfWork, enabling TransactionBehavior to
      resolve a working unit-of-work without a hand-written composition-root adapter.
      Legal under existing layering rules (06.Persistence may reference 01-05).
    -->
    <ProjectReference Include="..\..\05.Application\SharedKernel.Application.Behaviors\SharedKernel.Application.Behaviors.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!--
      P-333: direct reference required to use the [LoggerMessage] source-generator attribute
      (Microsoft.Extensions.Logging.Abstractions.LoggerMessageAttribute). Previously only
      transitively available via Microsoft.EntityFrameworkCore. Version aligned with the pinned
      EF Core 10.0.5 / Microsoft.Extensions.DependencyInjection.Abstractions 10.0.5 family.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!--
      P-334: provides OptionsBuilder<TOptions>.Bind(IConfiguration), the fluent extension the
      .WithEncryption(IConfiguration,...)/.WithServiceName(IConfiguration) overloads depend on.
      Microsoft.Extensions.Options itself is already available transitively (via the existing
      IOptionsMonitor<EncryptionOptions> usage) — .ConfigurationExtensions is a separate package.
    -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <!--
      P-338: the CONCRETE Microsoft.Extensions.DependencyInjection package (not merely
      .Abstractions) — provides ActivatorUtilities.CreateInstance<T>, used to construct the
      read-replica TContext instance while reusing scope-ambient DI-resolved interceptor
      instances (EfCorePersistenceBuilder.WithReadReplica / IReadReplicaContextAccessor<TContext>).
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <!-- Allows the nested test project to access internal members (e.g.,
         SharedKernelDbContext.CurrentEncryptionVersionOverride) for diagnostics
         and white-box testing without expanding the public API surface. -->
    <InternalsVisibleTo Include="SharedKernel.Persistence.EfCore.Tests" />
  </ItemGroup>
</Project>
