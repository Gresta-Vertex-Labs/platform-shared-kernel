<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>EF Core 10 on PostgreSQL for SharedKernel services, registered with one call: builder.AddSharedKernelPostgres&lt;TContext&gt;("name"). Reads ConnectionStrings:{name}; snake_case naming, retry on transient failures, xmin optimistic concurrency on every aggregate root, SQLSTATE classification, strongly-typed id and Money conventions, audit/soft-delete/tenant columns by convention, one save interceptor (audit, soft delete, aggregate touch, tenant write guard), domain events on every save, unit of work per context, JSONB and pgvector helpers. Field encryption and the audit trail ship as sibling packages.</Description>
    <PackageTags>persistence;efcore;entity-framework;postgresql;npgsql;jsonb;pgvector;repository;unit-of-work;shared-kernel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!--
      P-557/W1: EfCore no longer references SharedKernel.Security.Abstractions,
      SharedKernel.Application.Behaviors, or SharedKernel.Cryptography — see
      SharedKernel.Persistence.Abstractions.Context (IAuditActorContext/ICrossTenantScope) for the
      local seams that replace the former direct Security.Abstractions dependency; see
      13.ServiceDefaults/SharedKernel.ServiceDefaults.Persistence for the Application.Behaviors
      bridge and the real IUserContext/ITenantProvider bridge; see
      SharedKernel.Persistence.EfCore.Encryption for the former Cryptography-dependent surface.
      06 must now reference only 01–05, and in practice only 01.Core (Domain/Core) + Abstractions.
    -->
    <ProjectReference Include="..\SharedKernel.Persistence.Abstractions\SharedKernel.Persistence.Abstractions.csproj" />
    <ProjectReference Include="..\..\03.Domain\SharedKernel.Domain\SharedKernel.Domain.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Core\SharedKernel.Core.csproj" />
    <!-- P-557/W2: PersistenceServiceOptions implements ISectionBoundOptions. -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
    <!-- P-558/W1b: PostgreSQL-only. The former SharedKernel.Persistence.PostgreSQL package merged into
         this one; the shared NpgsqlDataSource and the reusable PostgresException classifier live in
         SharedKernel.Persistence.Npgsql (EF-Core-free, also used by Dapper). -->
    <ProjectReference Include="..\SharedKernel.Persistence.Npgsql\SharedKernel.Persistence.Npgsql.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!--
      P-333: direct reference required to use the [LoggerMessage] source-generator attribute
      (Microsoft.Extensions.Logging.Abstractions.LoggerMessageAttribute). Previously only
      transitively available via Microsoft.EntityFrameworkCore. Version aligned with the pinned
      EF Core 10.0.5 / Microsoft.Extensions.DependencyInjection.Abstractions 10.0.5 family.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!--
      P-558/W2: AddSharedKernelPostgres reads ConnectionStrings:{name} and binds SharedKernel:Persistence sections.
    -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Allows the nested test project to access internal members for diagnostics and white-box
         testing without expanding the public API surface. -->
    <InternalsVisibleTo Include="SharedKernel.Persistence.EfCore.Tests" />
    <InternalsVisibleTo Include="SharedKernel.Persistence.EfCore.Integration.Tests" />
    <!--
      P-558/W3a: the sibling capability packages plug into the context through internal extension points
      (model-convention factories, options extensions, the encryption annotation names, the builder's service
      collection, the service-name options) that no consuming service implements. They are internal so the
      public surface is only what a microservice names. Both siblings pin this package to their own exact
      version in their nuspec (see their csproj), so the internal contract can never be mixed across versions.
    -->
    <InternalsVisibleTo Include="SharedKernel.Persistence.EfCore.Encryption" />
    <InternalsVisibleTo Include="SharedKernel.Persistence.EfCore.Auditing" />
    <!-- A test interceptor that must run after the encryption interceptor plugs in the same way. -->
    <InternalsVisibleTo Include="SharedKernel.Persistence.EfCore.Encryption.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
