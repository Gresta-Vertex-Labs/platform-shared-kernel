<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>SharedKernel.Persistence.EfCore</PackageId>
    <Description>EF Core 10 implementation of SharedKernel persistence abstractions: repositories, unit of work, interceptors (Audit, SoftDelete, Concurrency), specification evaluator, TenantedDbContext, and EfCorePersistenceBuilder.</Description>
    <Version>1.0.0</Version>
    <Authors>Gresta-Vertex-Labs</Authors>
    <RepositoryUrl>https://github.com/gresta-vertex-labs/platform-shared-kernel</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Persistence.Abstractions\SharedKernel.Persistence.Abstractions.csproj" />
    <ProjectReference Include="..\..\03.Domain\SharedKernel.Domain\SharedKernel.Domain.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Core\SharedKernel.Core.csproj" />
    <!--
      Deliberate layering exception (P-078): SharedKernel.Security.Abstractions is a
      zero-dependency interface library (no ORM, no infrastructure). The reference is
      required for IUserContext (AuditInterceptor, SoftDeleteInterceptor) and
      ITenantProvider (TenantedDbContext). Maintaining local interface copies would
      create divergence risk. All other 12.Security.* packages are forbidden here.
    -->
    <ProjectReference Include="..\..\12.Security\SharedKernel.Security.Abstractions\SharedKernel.Security.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude the nested test project from the main project's compilation -->
    <Compile Remove="SharedKernel.Persistence.EfCore.Tests\**" />
    <EmbeddedResource Remove="SharedKernel.Persistence.EfCore.Tests\**" />
    <None Remove="SharedKernel.Persistence.EfCore.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Allows the nested test project to access internal members (e.g.,
         SharedKernelDbContext.CurrentEncryptionVersionOverride) for diagnostics
         and white-box testing without expanding the public API surface. -->
    <InternalsVisibleTo Include="SharedKernel.Persistence.EfCore.Tests" />
  </ItemGroup>

</Project>
