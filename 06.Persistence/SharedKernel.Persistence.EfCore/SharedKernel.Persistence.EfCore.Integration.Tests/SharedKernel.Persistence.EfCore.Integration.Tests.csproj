<Project Sdk="Microsoft.NET.Sdk">
  <!--
    P-558/W1b: the container-backed half of SharedKernel.Persistence.EfCore's tests (real PostgreSQL via
    Testcontainers), split out so SharedKernel.Persistence.EfCore.Tests stays Docker-free and in the unit
    lane (Platform.SharedKernel.Unit.slnf). This project runs in the integration lane
    (Platform.SharedKernel.Integration.slnf). It absorbed the former SharedKernel.Persistence.PostgreSQL.Tests
    (PostgreSql/) and EfCore.Tests' Postgres/ folder.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Persistence.EfCore.csproj" />
    <ProjectReference Include="..\..\..\16.Testing\SharedKernel.Testing\SharedKernel.Testing.csproj" />
    <ProjectReference Include="..\..\..\16.Testing\SharedKernel.Testing.Internal\SharedKernel.Testing.Internal.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>
</Project>
