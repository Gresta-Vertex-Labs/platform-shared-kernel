    <Version>1.0.0</Version>
    <PackageTags>persistence;dapper;micro-orm;read-model;shared-kernel</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- References Abstractions for IDbConnectionFactory; PostgreSQL for NpgsqlConnectionFactory -->
