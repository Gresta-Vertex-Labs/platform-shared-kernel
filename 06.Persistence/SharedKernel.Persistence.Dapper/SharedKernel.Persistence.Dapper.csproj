<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Dapper on PostgreSQL for SharedKernel: IDbSessionFactory (connection + transaction enlisted in the unit of work, tenant bound for row-level security, read-only and cross-tenant data sources), generic type handlers (SmartEnum, StronglyTypedId, jsonb via JsonTypeInfo, pgvector) and AddSharedKernelDapper.</Description>
    <PackageTags>persistence;dapper;micro-orm;postgresql;shared-kernel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!--
      P-558/W2-N: references SharedKernel.Persistence.Npgsql (keyed read-only/cross-tenant data sources,
      the row-level security options, the tenant binder and PostgresErrorMapping) and, through it,
      SharedKernel.Persistence.Abstractions. Never references SharedKernel.Persistence.EfCore.
    -->
    <ProjectReference Include="..\SharedKernel.Persistence.Npgsql\SharedKernel.Persistence.Npgsql.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.Persistence.Dapper.Tests" />
  </ItemGroup>
</Project>
