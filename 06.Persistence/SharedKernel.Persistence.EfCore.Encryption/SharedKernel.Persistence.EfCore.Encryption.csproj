<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Field-level AES-256-GCM encryption for SharedKernel.Persistence.EfCore on PostgreSQL: .Encrypt()/.WithBlindIndex() on entity and nested complex-type properties, per-column derived keys, versioned blind indexes with WhereEncryptedEquals, a query guard, KMS key-ring bridging, a maintenance job (re-encrypt, recompute blind indexes, encrypt plaintext, verify) and per-tenant crypto-shredding.</Description>
    <PackageTags>persistence;efcore;encryption;aes-gcm;shared-kernel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Persistence.EfCore\SharedKernel.Persistence.EfCore.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Cryptography\SharedKernel.Cryptography.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.Persistence.EfCore.Encryption.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <!--
    P-558/W3a: this package uses SharedKernel.Persistence.EfCore internals (InternalsVisibleTo), so its nuspec
    pins that dependency to exactly this build's version ([x.y.z]) instead of NuGet's default minimum (>= x.y.z):
    a newer EfCore with changed internals can never be combined with this package.
  -->
  <Target Name="PinEfCoreDependencyToExactVersion" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'SharedKernel.Persistence.EfCore'">
        <ProjectVersion>[%(ProjectVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>
</Project>
