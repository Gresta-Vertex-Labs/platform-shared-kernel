<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Field-level AES-256-GCM transparent encryption for SharedKernel.Persistence.EfCore: row-bound associated-data binding (purpose + primary key + tenant id), the .Encrypt()/.WithBlindIndex() PropertyBuilder extensions, KMS/HSM-backed key-ring bridging, and resumable key-rotation infrastructure.</Description>
    <PackageTags>persistence;efcore;encryption;aes-gcm;shared-kernel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!--
      P-557/W1: this capability moved out of SharedKernel.Persistence.EfCore into its own package —
      EfCore itself no longer references SharedKernel.Cryptography at all. This package contributes
      back into EfCore's SharedKernelDbContext purely through the extensibility interfaces in
      SharedKernel.Persistence.EfCore.Extensibility (IPersistenceModelConventionFactory,
      IPersistenceOptionsExtension) and the builder's public Services/AddInterceptor/AddBuildAction/
      RequireDbContextFactory surface — never a compile-time reference the other direction.
    -->
    <ProjectReference Include="..\SharedKernel.Persistence.EfCore\SharedKernel.Persistence.EfCore.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Cryptography\SharedKernel.Cryptography.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.Persistence.EfCore.Encryption.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
