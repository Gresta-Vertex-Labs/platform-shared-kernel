<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>SharedKernel.Persistence.Abstractions</PackageId>
    <Description>Zero-ORM persistence abstractions: IRepository, IReadRepository, IUnitOfWork, ITransactionalUnitOfWork, IDbConnectionFactory, ISpecificationEvaluator. References only SharedKernel.Primitives, SharedKernel.Domain, and SharedKernel.Contracts (for PagedList&lt;T&gt;). Implemented by SharedKernel.Persistence.EfCore.</Description>
    <Version>1.0.0</Version>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>Gresta-Vertex-Labs</Authors>
    <Company>Gresta-Vertex-Labs</Company>
    <Product>Platform.SharedKernel</Product>
    <PackageTags>persistence;repository;unit-of-work;specification;shared-kernel</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</PackageProjectUrl>
    <Copyright>Copyright © 2026 Gresta-Vertex-Labs</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\03.Domain\SharedKernel.Domain\SharedKernel.Domain.csproj" />
    <!--
      Deliberate design decision (P-080, Cap 3): SharedKernel.Contracts (04.Contracts) is
      referenced to expose PagedList<T> as the return type of IReadRepository.ListPagedAsync.
      This is within root layering rules (06.Persistence may reference 01–05). It widens
      the Abstractions dependency surface from [Primitives, Domain] to [Primitives, Domain,
      Contracts]. No ORM NuGet references are introduced by this change.
    -->
    <ProjectReference Include="..\..\04.Contracts\SharedKernel.Contracts\SharedKernel.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude the nested test project from the main project's compilation -->
    <Compile Remove="SharedKernel.Persistence.Abstractions.Tests\**" />
    <EmbeddedResource Remove="SharedKernel.Persistence.Abstractions.Tests\**" />
    <None Remove="SharedKernel.Persistence.Abstractions.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
