<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Zero-ORM persistence abstractions: IRepository, IReadRepository, IDbConnectionFactory, ISpecificationEvaluator, the audit-ledger read contracts and the ADO.NET coordination seams. The unit of work (IUnitOfWork), the caller (IRequestContext) and the audit writer (IAuditTrailWriter) are shared with the application pipeline through SharedKernel.Application.Abstractions. Implemented by SharedKernel.Persistence.EfCore.</Description>
    <PackageTags>persistence;repository;unit-of-work;specification;shared-kernel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\03.Domain\SharedKernel.Domain\SharedKernel.Domain.csproj" />
    <!--
      Deliberate design decision (P-080, Cap 3): SharedKernel.Contracts (04.Contracts) is
      referenced to expose PagedList<T> as the return type of IReadRepository.ListPagedAsync.
      This is within root layering rules (06.Persistence may reference 01–05). It widens
      the Abstractions dependency surface from [Primitives, Domain] to [Primitives, Domain,
      Contracts]. No ORM NuGet references are introduced by this change.
    -->
    <ProjectReference Include="..\..\04.Contracts\SharedKernel.Contracts\SharedKernel.Contracts.csproj" />
    <!--
      P-558: the single copy of IUnitOfWork, IRequestContext and IAuditTrailWriter/AuditEntry/AuditOutcome.
      MediatR-free by design; the ONLY 05.Application package 06.Persistence may reference (never
      SharedKernel.Application, .Behaviors or MediatR — locked by 00.Governance).
    -->
    <ProjectReference Include="..\..\05.Application\SharedKernel.Application.Abstractions\SharedKernel.Application.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
