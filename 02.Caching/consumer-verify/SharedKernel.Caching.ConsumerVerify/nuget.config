<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local feed for Platform.SharedKernel packages built from source -->
    <add key="local-shared-kernel" value="c:\Github\platform-shared-kernel\nupkgs" />
    <!-- Public NuGet feed for all other dependencies -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-shared-kernel">
      <package pattern="SharedKernel.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
