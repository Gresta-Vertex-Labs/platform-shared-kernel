<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Adapter</SharedKernelTier>
    <SharedKernelAllowedAdapterReferences>SharedKernel.Caching.Redis.Core</SharedKernelAllowedAdapterReferences>
    <!-- NuGet packaging metadata -->
    <Description>Redis distributed layer and backplane for SharedKernel.Caching.FusionCache: entries are shared by every instance of a service, and removals, expirations, tag evictions and clears reach all of them. Uses the shared connection from SharedKernel.Caching.Redis.Core, so its TLS and timeout settings apply, with FusionCache circuit breakers that keep an unreachable Redis from slowing every request. Configuration binding validated at startup.</Description>
    <PackageReleaseNotes>First release.</PackageReleaseNotes>
    <PackageTags>shared-kernel;caching;redis;fusioncache;distributed-cache;backplane</PackageTags>
    <!--
      Set per-project, not inherited: the SDK assigns GenerateDocumentationFile=false before
      Directory.Build.targets' '== empty'-guarded default is evaluated. CS1591 below makes an
      undocumented public member a build error.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API tracking: an addition, removal or signature change fails the build until PublicAPI.*.txt is updated. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
    <!-- RS0026/RS0027: the two AddRedisL2 overloads (configuration or delegate) share the optional configure parameter. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- IServiceCollection extension signatures -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="ZiggyCreatures.FusionCache" />
    <PackageReference Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <!-- ICachingBuilder -->
    <ProjectReference Include="..\SharedKernel.Caching.Abstractions\SharedKernel.Caching.Abstractions.csproj" />
    <!-- The shared IConnectionMultiplexer -->
    <ProjectReference Include="..\SharedKernel.Caching.Redis.Core\SharedKernel.Caching.Redis.Core.csproj" />
    <!-- AddValidatedOptions and ISectionBoundOptions for configuration binding -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Caching.Redis.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
