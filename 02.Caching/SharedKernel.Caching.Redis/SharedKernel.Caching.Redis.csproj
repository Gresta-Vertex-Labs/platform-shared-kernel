<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Description>Redis L2 distributed backplane for SharedKernel.Caching. Adds Redis-backed ICacheService (FusionCache L2 via StackExchange.Redis). Requires SharedKernel.Caching. AOT-compatible.</Description>
    <PackageTags>shared-kernel;caching;redis;fusioncache;l2-cache;aot</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- DI abstractions — required for IServiceCollection extension signatures -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Redis client — L2 distributed cache backing -->
    <PackageReference Include="StackExchange.Redis" />
    <!-- IDistributedCache implementation over StackExchange.Redis for FusionCache L2 -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <!-- FusionCache core — required for AddFusionCache() and FusionCacheBuilder extensions -->
    <PackageReference Include="ZiggyCreatures.FusionCache" />
    <!-- FusionCache Redis L2 distributed backplane -->
    <PackageReference Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" />
    <!-- Caching abstractions — ICachingBuilder, ICacheService, CachingCoreOptions -->
    <ProjectReference Include="..\SharedKernel.Caching.Abstractions\SharedKernel.Caching.Abstractions.csproj" />
    <!-- Redis connection core — AddRedisConnection (IConnectionMultiplexer registration) and AddRedisCircuitBreaker (Polly v8 ResiliencePipeline) -->
    <ProjectReference Include="..\SharedKernel.Caching.Redis.Core\SharedKernel.Caching.Redis.Core.csproj" />
  </ItemGroup>
</Project>
