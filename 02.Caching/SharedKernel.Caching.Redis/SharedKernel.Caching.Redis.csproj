<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NuGet packaging metadata -->
    <PackageId>SharedKernel.Caching.Redis</PackageId>
    <Version>1.0.0</Version>
    <Authors>Gresta-Vertex-Labs</Authors>
    <Company>Gresta-Vertex-Labs</Company>
    <Product>Platform.SharedKernel</Product>
    <Description>Redis L2 distributed backplane for SharedKernel.Caching. Adds Redis-backed ICacheService (FusionCache L2 via StackExchange.Redis). Requires SharedKernel.Caching. AOT-compatible.</Description>
    <PackageTags>shared-kernel;caching;redis;fusioncache;l2-cache;aot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</PackageProjectUrl>
    <Copyright>Copyright © 2026 Gresta-Vertex-Labs</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- DI abstractions — required for IServiceCollection extension signatures -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1" />
    <!-- Redis client — L2 distributed cache backing -->
    <PackageReference Include="StackExchange.Redis" Version="2.13.1" />
    <!-- IDistributedCache implementation over StackExchange.Redis for FusionCache L2 -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.0" />
    <!-- FusionCache core — required for AddFusionCache() and FusionCacheBuilder extensions -->
    <PackageReference Include="ZiggyCreatures.FusionCache" Version="2.6.0" />
    <!-- FusionCache Redis L2 distributed backplane -->
    <PackageReference Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.6.0" />
    <!-- Caching abstractions — ICachingBuilder, ICacheService, CachingCoreOptions -->
    <ProjectReference Include="..\SharedKernel.Caching.Abstractions\SharedKernel.Caching.Abstractions.csproj" />
    <!-- Redis connection core — AddRedisConnection (IConnectionMultiplexer registration) and AddRedisCircuitBreaker (Polly v8 ResiliencePipeline) -->
    <ProjectReference Include="..\SharedKernel.Caching.Redis.Core\SharedKernel.Caching.Redis.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude nested test project from main project compilation -->
    <Compile Remove="SharedKernel.Caching.Redis.Tests\**" />
    <EmbeddedResource Remove="SharedKernel.Caching.Redis.Tests\**" />
    <None Remove="SharedKernel.Caching.Redis.Tests\**" />
  </ItemGroup>

</Project>
