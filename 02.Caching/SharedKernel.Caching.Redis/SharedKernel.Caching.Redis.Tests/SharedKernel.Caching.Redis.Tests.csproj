<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <!-- Version floor raised to match SharedKernel.Testing -> SharedKernel.Application.Behaviors's transitive minimum (NU1605 downgrade guard) -->
    <PackageReference Include="Polly.Core" Version="8.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <!-- Testcontainers Redis for integration tests -->
    <PackageReference Include="Testcontainers.Redis" Version="4.13.0" />
    <!-- DI host for integration-style DI registration tests -->
    <!-- Version floor raised to match SharedKernel.Testing's transitive minimum (NU1605 downgrade guard) -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <!-- Logging null provider for tests -->
    <!-- Version floor raised to match SharedKernel.Testing -> Microsoft.Extensions.Http's transitive minimum (NU1605 downgrade guard) -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <!-- StackExchange.Redis — required for IConnectionMultiplexer in test assertions -->
    <PackageReference Include="StackExchange.Redis" Version="2.13.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Caching.Redis.csproj" />
    <!-- SharedKernel.Caching.FusionCache needed for L1FallbackTests and RedisL2IntegrationTests (AddSharedKernelCaching, CachePolicy) -->
    <ProjectReference Include="..\..\SharedKernel.Caching.FusionCache\SharedKernel.Caching.FusionCache.csproj" />
    <!-- SharedKernel.Testing provides FakeCacheService, FakeDistributedLockService, FakeRenewableLock -->
    <ProjectReference Include="..\..\..\16.Testing\SharedKernel.Testing\SharedKernel.Testing.csproj" />
  </ItemGroup>

</Project>
