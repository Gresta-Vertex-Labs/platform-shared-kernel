<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Version>1.0.0</Version>
    <Description>FusionCache L1 provider implementation for SharedKernel caching. Provides ICacheService backed by ZiggyCreatures.FusionCache with stampede protection, background eager-refresh, fail-safe stale serving, and tag-based eviction. L1-only by default; Redis distributed backplane is added via SharedKernel.Caching.Redis. AOT-compatible.</Description>
    <PackageTags>shared-kernel;caching;fusioncache;l1-cache;stampede-protection;aot</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- DI abstractions â€” required for IServiceCollection extension signatures -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Options validation via data annotations (ValidateDataAnnotations, ValidateOnStart) -->
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <!-- Hosting abstractions â€” required for BackgroundService (CacheWarmupHostedService) and IHostedLifecycleService -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- L1 in-process cache powered by FusionCache -->
    <PackageReference Include="ZiggyCreatures.FusionCache" />
    <!-- AOT-safe STJ serialization for FusionCache entries -->
    <PackageReference Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" />
  </ItemGroup>
  <ItemGroup>
    <!-- Caching contracts: ICacheService, CachePolicy, ICacheKeyProvider, ICachingBuilder -->
    <ProjectReference Include="..\SharedKernel.Caching.Abstractions\SharedKernel.Caching.Abstractions.csproj" />
    <!-- LoggingEventIdRanges.Caching — this domain's reserved EventId block base (Phase 37, WO-041) -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <!-- ISymmetricEncryptionService — opt-in AES-GCM cache-value encryption (Phase 42, WO-065) -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Cryptography\SharedKernel.Cryptography.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Expose internals to the nested test project -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Caching.FusionCache.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
