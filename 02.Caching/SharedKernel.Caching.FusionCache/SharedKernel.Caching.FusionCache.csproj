<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- NuGet packaging metadata -->
    <PackageId>SharedKernel.Caching.FusionCache</PackageId>
    <Version>1.0.0</Version>
    <Authors>Gresta-Vertex-Labs</Authors>
    <Company>Gresta-Vertex-Labs</Company>
    <Product>Platform.SharedKernel</Product>
    <Description>FusionCache L1 provider implementation for SharedKernel caching. Provides ICacheService backed by ZiggyCreatures.FusionCache with stampede protection, background eager-refresh, fail-safe stale serving, and tag-based eviction. L1-only by default; Redis distributed backplane is added via SharedKernel.Caching.Redis. AOT-compatible.</Description>
    <PackageTags>shared-kernel;caching;fusioncache;l1-cache;stampede-protection;aot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</PackageProjectUrl>
    <Copyright>Copyright © 2026 Gresta-Vertex-Labs</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- DI abstractions — required for IServiceCollection extension signatures -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1" />
    <!-- Options validation via data annotations (ValidateDataAnnotations, ValidateOnStart) -->
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.0" />
    <!-- Hosting abstractions — required for BackgroundService (CacheWarmupHostedService) and IHostedLifecycleService -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <!-- L1 in-process cache powered by FusionCache -->
    <PackageReference Include="ZiggyCreatures.FusionCache" Version="2.6.0" />
    <!-- AOT-safe STJ serialization for FusionCache entries -->
    <PackageReference Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Caching contracts: ICacheService, CachePolicy, ICacheKeyProvider, ICachingBuilder -->
    <ProjectReference Include="..\SharedKernel.Caching.Abstractions\SharedKernel.Caching.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internals to the nested test project -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Caching.FusionCache.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude nested test project from main project compilation -->
    <Compile Remove="SharedKernel.Caching.FusionCache.Tests\**" />
    <EmbeddedResource Remove="SharedKernel.Caching.FusionCache.Tests\**" />
    <None Remove="SharedKernel.Caching.FusionCache.Tests\**" />
  </ItemGroup>

</Project>
