<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Description>Redis implementation of IDistributedLockService: locks kept alive until released and reported when lost, self-expiring leases, and fencing tokens issued atomically with each acquisition by server-side Lua scripts. Works on a single Redis primary or Redis Cluster. Depends on SharedKernel.Caching.Redis.Core for connection management.</Description>
    <PackageTags>shared-kernel;caching;redis;distributed-lock;lease;fencing-token</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- DI abstractions — required for IServiceCollection extension signatures -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Caching abstractions — ICachingBuilder, IDistributedLockService, IDistributedLock -->
    <ProjectReference Include="..\SharedKernel.Caching.Abstractions\SharedKernel.Caching.Abstractions.csproj" />
    <!-- Redis connection core — AddRedisConnection (IConnectionMultiplexer registration) -->
    <ProjectReference Include="..\SharedKernel.Caching.Redis.Core\SharedKernel.Caching.Redis.Core.csproj" />
    <!-- LoggingEventIdRanges.Caching — this domain's reserved EventId block base (Phase 37, WO-041) -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Allow internal types to be accessed from the test project -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Caching.Redis.DistributedLocking.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
