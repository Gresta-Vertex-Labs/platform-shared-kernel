<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Description>Structured Redis Hash storage (IRedisHashService, ITypedHashStore&lt;T&gt;). Depends on SharedKernel.Caching.Redis.Core for connection management — does not transitively reference SharedKernel.Caching.Redis (L2), distributed locking, or pub/sub packages.</Description>
    <PackageTags>shared-kernel;caching;redis;hash;structured-storage;aot</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- DI abstractions — required for ICachingBuilder extension signatures -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Optional Polly circuit breaker pipeline injection -->
    <PackageReference Include="Polly.Core" />
    <!-- Redis client — hash commands -->
    <PackageReference Include="StackExchange.Redis" />
    <!-- Caching abstractions — ICachingBuilder, IRedisHashService, ITypedHashStore<T> -->
    <ProjectReference Include="..\SharedKernel.Caching.Abstractions\SharedKernel.Caching.Abstractions.csproj" />
    <!-- Redis connection core — AddRedisConnection (IConnectionMultiplexer registration) -->
    <ProjectReference Include="..\SharedKernel.Caching.Redis.Core\SharedKernel.Caching.Redis.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Allow internal types (TypedHashStore<T>) to be accessed from the test project -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Caching.Redis.HashStore.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
