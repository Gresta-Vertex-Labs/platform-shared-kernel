<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- NuGet packaging metadata -->
    <PackageId>SharedKernel.Caching.Redis.Core</PackageId>
    <Version>1.0.0</Version>
    <Authors>Gresta-Vertex-Labs</Authors>
    <Company>Gresta-Vertex-Labs</Company>
    <Product>Platform.SharedKernel</Product>
    <Description>Foundational Redis connection layer for SharedKernel.Caching: IConnectionMultiplexer registration (AddRedisConnection), ConnectionHealthState tracking (RedisConnectionHealthTracker), and an opt-in Polly v8 ResiliencePipeline factory (AddRedisCircuitBreaker). Dependency root for SharedKernel.Caching.Redis, .DistributedLocking, .HashStore, and .PubSub. AOT-compatible.</Description>
    <PackageTags>shared-kernel;caching;redis;connection;resilience;circuit-breaker;aot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</PackageProjectUrl>
    <Copyright>Copyright © 2026 Gresta-Vertex-Labs</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- DI abstractions — required for IServiceCollection extension signatures -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1" />
    <!-- Redis client — IConnectionMultiplexer registration and connection health events -->
    <PackageReference Include="StackExchange.Redis" Version="2.13.1" />
    <!-- Polly v8 resilience pipeline for the opt-in circuit breaker -->
    <PackageReference Include="Polly.Core" Version="8.5.2" />
    <!-- RedisConnectionOptions.ValidateDataAnnotations() fail-fast validation (Phase 45) -->
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.0" />
    <!-- RedisConnectionOptions.ValidateOnStart() host-startup validation (Phase 45) -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <!-- Caching abstractions — ConnectionHealthState (Phase 26) -->
    <ProjectReference Include="..\SharedKernel.Caching.Abstractions\SharedKernel.Caching.Abstractions.csproj" />
    <!-- LoggingEventIdRanges.Caching — this domain's reserved EventId block base (Phase 37, WO-041) -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude nested test project from main project compilation -->
    <Compile Remove="SharedKernel.Caching.Redis.Core.Tests\**" />
    <EmbeddedResource Remove="SharedKernel.Caching.Redis.Core.Tests\**" />
    <None Remove="SharedKernel.Caching.Redis.Core.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Allow internal types (RedisConnectionHealthTracker event handlers) to be accessed from the test project -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Caching.Redis.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
