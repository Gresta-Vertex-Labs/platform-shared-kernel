<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Description>Foundational Redis connection layer for SharedKernel.Caching: IConnectionMultiplexer registration (AddRedisConnection), ConnectionHealthState tracking (RedisConnectionHealthTracker), and an opt-in Polly v8 ResiliencePipeline factory (AddRedisCircuitBreaker). Dependency root for SharedKernel.Caching.Redis, .DistributedLocking, .HashStore, and .PubSub.</Description>
    <PackageTags>shared-kernel;caching;redis;connection;resilience;circuit-breaker</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- DI abstractions — required for IServiceCollection extension signatures -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Redis client — IConnectionMultiplexer registration and connection health events -->
    <PackageReference Include="StackExchange.Redis" />
    <!-- Polly v8 resilience pipeline for the opt-in circuit breaker -->
    <PackageReference Include="Polly.Core" />
    <!-- RedisConnectionOptions.ValidateDataAnnotations() fail-fast validation (Phase 45) -->
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <!-- RedisConnectionOptions.ValidateOnStart() host-startup validation (Phase 45) -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- LoggingEventIdRanges.Caching — this domain's reserved EventId block base (Phase 37, WO-041) -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Allow internal types (RedisConnectionHealthTracker event handlers) to be accessed from the test project -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Caching.Redis.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
