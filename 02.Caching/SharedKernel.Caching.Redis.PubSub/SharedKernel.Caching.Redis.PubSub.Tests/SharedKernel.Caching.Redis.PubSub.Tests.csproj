<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" />
    <!-- Testcontainers Redis for integration tests -->
    <PackageReference Include="Testcontainers.Redis" />
    <!-- DI host for integration-style DI registration tests -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Logging null provider and capturing logger helpers for tests -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <!-- Hosting abstractions — required for BackgroundService (CacheInvalidationReceiver) tests -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- StackExchange.Redis — required for IConnectionMultiplexer in test assertions -->
    <PackageReference Include="StackExchange.Redis" />
    <!-- Optional Polly circuit breaker pipeline injection tests -->
    <PackageReference Include="Polly.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Caching.Redis.PubSub.csproj" />
    <!-- SharedKernel.Caching.Redis.Core provides AddRedisConnection (IConnectionMultiplexer registration) and AddRedisCircuitBreaker -->
    <ProjectReference Include="..\..\SharedKernel.Caching.Redis.Core\SharedKernel.Caching.Redis.Core.csproj" />
    <!-- SharedKernel.Testing provides FakeCacheService (ICacheService double for CacheInvalidationReceiver tests) -->
    <ProjectReference Include="..\..\..\16.Testing\SharedKernel.Testing\SharedKernel.Testing.csproj" />
  </ItemGroup>
</Project>
