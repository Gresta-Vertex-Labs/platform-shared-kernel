<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Adapter</SharedKernelTier>
    <SharedKernelAllowedAdapterReferences>SharedKernel.Caching.Redis.Core</SharedKernelAllowedAdapterReferences>
    <!-- NuGet packaging metadata -->
    <Description>Redis Pub/Sub over the shared connection from SharedKernel.Caching.Redis.Core, for loss-tolerant signals: text or JSON messages, several independent subscriptions per channel that handle messages one at a time in delivery order and end when disposed, and subscriptions restored automatically after a reconnect. At most once and not durable; not a substitute for SharedKernel.Messaging.</Description>
    <PackageReleaseNotes>First release.</PackageReleaseNotes>
    <PackageTags>shared-kernel;caching;redis;pubsub;signals</PackageTags>
    <!--
      Set per-project, not inherited: the SDK assigns GenerateDocumentationFile=false before
      Directory.Build.targets' '== empty'-guarded default is evaluated. CS1591 below makes an
      undocumented public member a build error.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API tracking: an addition, removal or signature change fails the build until PublicAPI.*.txt is updated. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
    <!-- RS0026/RS0027: text and JSON overloads of PublishAsync and SubscribeAsync share the optional CancellationToken. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- IServiceCollection extension signatures -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared IConnectionMultiplexer -->
    <ProjectReference Include="..\SharedKernel.Caching.Redis.Core\SharedKernel.Caching.Redis.Core.csproj" />
    <!-- LoggingEventIdRanges.Caching -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Caching.Redis.PubSub.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
