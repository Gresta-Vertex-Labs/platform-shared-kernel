<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Description>Ephemeral Redis Pub/Sub signaling (IRedisChannelService). At-most-once delivery, no durability guarantees — not a substitute for SharedKernel.Messaging.* (07.Messaging). Cache entries are synchronized across instances by the FusionCache backplane of SharedKernel.Caching.Redis, not by this package. Depends on SharedKernel.Caching.Redis.Core for connection management.</Description>
    <PackageTags>shared-kernel;caching;redis;pubsub</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- DI abstractions — required for ICachingBuilder extension signatures -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Optional Polly circuit breaker pipeline injection -->
    <PackageReference Include="Polly.Core" />
    <!-- Redis client — Pub/Sub commands -->
    <PackageReference Include="StackExchange.Redis" />
    <!-- Caching abstractions — ICachingBuilder -->
    <ProjectReference Include="..\SharedKernel.Caching.Abstractions\SharedKernel.Caching.Abstractions.csproj" />
    <!-- Redis connection core — AddRedisConnection (IConnectionMultiplexer registration) and AddRedisCircuitBreaker (Polly v8 ResiliencePipeline) -->
    <ProjectReference Include="..\SharedKernel.Caching.Redis.Core\SharedKernel.Caching.Redis.Core.csproj" />
    <!-- LoggingEventIdRanges.Caching — this domain's reserved EventId block base (Phase 37, WO-041) -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Allow internal types (RedisChannelService, OnConnectionRestored/Failed) to be accessed from the test project -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Caching.Redis.PubSub.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
