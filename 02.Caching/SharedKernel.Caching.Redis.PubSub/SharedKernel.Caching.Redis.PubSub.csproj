<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Version>1.0.0</Version>
    <Description>Ephemeral Redis Pub/Sub signaling and cache invalidation (IRedisChannelService, ICacheInvalidationBus, CacheInvalidationReceiver). At-most-once delivery, no durability guarantees — not a substitute for SharedKernel.Messaging.* (07.Messaging). Depends on SharedKernel.Caching.Redis.Core for connection management — does not transitively reference SharedKernel.Caching.Redis (L2), distributed locking, or hash store packages.</Description>
    <PackageTags>shared-kernel;caching;redis;pubsub;cache-invalidation;aot</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- DI abstractions — required for ICachingBuilder extension signatures -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Hosting abstractions — required for BackgroundService (CacheInvalidationReceiver) -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- Optional Polly circuit breaker pipeline injection -->
    <PackageReference Include="Polly.Core" />
    <!-- Redis client — Pub/Sub commands -->
    <PackageReference Include="StackExchange.Redis" />
    <!-- Caching abstractions — ICachingBuilder, IRedisChannelService, ICacheInvalidationBus, CachingCoreOptions -->
    <ProjectReference Include="..\SharedKernel.Caching.Abstractions\SharedKernel.Caching.Abstractions.csproj" />
    <!-- Redis connection core — AddRedisConnection (IConnectionMultiplexer registration) and AddRedisCircuitBreaker (Polly v8 ResiliencePipeline) -->
    <ProjectReference Include="..\SharedKernel.Caching.Redis.Core\SharedKernel.Caching.Redis.Core.csproj" />
    <!-- LoggingEventIdRanges.Caching — this domain's reserved EventId block base (Phase 37, WO-041) -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Allow internal types (RedisChannelService, OnConnectionRestored/Failed) to be accessed from the test project -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Caching.Redis.PubSub.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
