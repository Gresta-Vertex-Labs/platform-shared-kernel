<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Abstractions</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>Provider-neutral caching and distributed-locking contracts for SharedKernel services: ICacheService (hybrid memory and distributed cache with stampede protection, fail-safe, eager refresh and factory-controlled caching), ITenantCacheService with collision-free tenant keys and tags, CachePolicy, the canonical cache key format, and IDistributedLockService with fencing tokens, locks kept alive until released, and self-expiring leases. No FusionCache, Redis or RedLock dependency.</Description>
    <PackageReleaseNotes>First release.</PackageReleaseNotes>
    <PackageTags>shared-kernel;caching;hybrid-cache;distributed-lock;multi-tenancy;abstractions</PackageTags>
    <!--
      Set per-project, not inherited: the SDK assigns GenerateDocumentationFile=false before
      Directory.Build.targets' '== empty'-guarded default is evaluated. CS1591 below makes an
      undocumented public member a build error.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API tracking: an addition, removal or signature change fails the build until PublicAPI.*.txt is updated. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
    <!-- RS0026/RS0027: the two GetOrSetAsync overloads (plain and context-aware factory) share the optional CancellationToken, the .NET convention. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- ICachingBuilder exposes IServiceCollection so provider packages can chain registrations. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- TenantId: tenant-scoped keys, tags and ITenantCacheService take the one tenant identifier type. -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Execution\SharedKernel.Execution.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
