<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Optimize>true</Optimize>

    <!-- AOT compatibility -->    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <!-- NuGet metadata -->
    <PackageId>SharedKernel.Caching.Abstractions</PackageId>
    <Version>1.0.0</Version>
    <Authors>Gresta-Vertex-Labs</Authors>
    <Description>Zero-infrastructure caching abstractions for Platform.SharedKernel. Contains ICacheService, CachePolicy, ICacheKeyProvider, IDistributedLockService, IRedisChannelService, IRedisHashService, ICacheInvalidationBus, CacheInvalidationMessage, and ICachingBuilder. No FusionCache, StackExchange.Redis, or RedLock.net transitive dependencies.</Description>
    <PackageTags>caching;abstractions;SharedKernel;FusionCache;AOT</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- IServiceCollection only â€” zero infrastructure references -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1" />
    <!-- services.Configure<T> used by AddCachingCoreOptions â€” not transitively available from DI.Abstractions -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>

</Project>
