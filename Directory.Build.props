<Project>

  <!--
    Platform.SharedKernel — centralized build configuration (DV-002/WO-devops-001).

    Import order matters: MSBuild auto-imports Directory.Build.props BEFORE the project body and
    Directory.Build.targets AFTER it. Properties set here are therefore *defaults* — any later
    <PropertyGroup> in the project file itself (or in Directory.Build.targets) wins.

    Exactly one copy of this file exists, at the repository root. A per-domain copy would stop
    MSBuild's upward directory walk and silently drop this file for everything below it — see
    eng/README.md "Root build files".
  -->

  <!--
    Build output lives outside the source tree: artifacts/{bin,obj}/{project}/{pivot}/. The length of
    an output path then depends on the project name only, never on how deep the project sits in the
    folder tree, so moving or nesting folders cannot push a build over Windows' 260-character
    MAX_PATH. This replaces the per-project %TEMP% redirects the deepest 15.Integration test
    projects used to need. PackageOutputPath (nupkgs/) is set explicitly below and is unaffected.

    ArtifactsProjectName must be unique per project. Nine harnesses share the project name
    "consumer-verify", so each one is suffixed with the name of the folder that contains it.
  -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <ArtifactsProjectName Condition="'$(MSBuildProjectName)' == 'consumer-verify'">consumer-verify.$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($(MSBuildProjectDirectory)))))</ArtifactsProjectName>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Computed identity. Nested *.Tests projects (e.g. src/Infrastructure/Storage/SharedKernel.Storage.Abstractions/
      SharedKernel.Storage.Abstractions.Tests/) are detected by project-name suffix. This does NOT
      catch every non-shipping project in the repo (the *Consumer harnesses under
      tools/Governance/_verification and the consumer-verify/ folders inside capability folders do
      not end in ".Tests") — those already declare
      <IsPackable>false</IsPackable> explicitly in their own project body, which always wins over
      anything set here because Directory.Build.props is imported first. This property only drives
      the mechanical, low-risk defaults below; it is never the sole gate on IsPackable.
    -->
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
    <IsTestProject Condition="'$(IsTestProject)' == ''">false</IsTestProject>
  </PropertyGroup>

  <!--
    A test that reads its package's own files (csproj, README, shipped config) needs the source folder,
    and with artifacts output (above) the test binary no longer sits inside it. Every test assembly
    records its project directory as AssemblyMetadata("SharedKernel.TestProjectDirectory"); tests walk
    up from there instead of from AppContext.BaseDirectory. The path is never packed: test projects
    are not packable.
  -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SharedKernel.TestProjectDirectory</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Language / compilation — every project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!--
      TreatWarningsAsErrors is deliberately NOT centralized here (Rule 7: a property that is not
      genuinely uniform must stay per-project). 64 of the 253 csproj files set it (October 2026).
      A first attempt at centralizing it turned ~60 dormant warnings (CS1574 unresolved
      &lt;see cref&gt; references, RS1041 analyzer-project compat warnings) into build errors in source
      owned by the domain implementers, so it stays a per-project opt-in, like
      Description/PackageTags. Each project that opts in declares
      &lt;TreatWarningsAsErrors&gt;true&lt;/TreatWarningsAsErrors&gt; itself.
    -->
    <!--
      .NET 10 defaults NuGetAuditMode to "all" (was "direct"). Combined with a project's own
      TreatWarningsAsErrors=true (see above), a newly-disclosed CVE in ANY transitive dependency
      would break that project's build with no code change. Demote NU1901-NU1904 to non-fatal
      warnings locally; CI escalates them back to hard errors via a dedicated
      `dotnet restore -warnaserror` step (see .github/workflows/verify.yml) so the audit signal is never silently lost,
      only relocated to where it can be triaged deliberately.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <!-- Nested-test exclusion — shipping/non-test projects only.
       Replaces the hand-written <Compile Remove="*.Tests\**"/><EmbeddedResource Remove=.../><None Remove=.../>
       trio duplicated in ~45 production csproj files: DefaultItemExcludes feeds the SDK's default
       item globs and covers all three item types in one line. -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <DefaultItemExcludes>$(DefaultItemExcludes);*.Tests\**;*.ConsumerVerify\**;consumer-verify\**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    Documentation — shipping library projects only. NOTE: the actual <GenerateDocumentationFile>
    default is set in Directory.Build.targets, not here — OutputType is set inside each project's
    own body, which is imported AFTER Directory.Build.props, so a condition on $(OutputType) here
    would always see it unset/empty and never correctly exclude the Exe consumer-verify harnesses.
    Directory.Build.targets runs after the project body, where $(OutputType) is genuinely resolved.
  -->

  <!-- Determinism / Source Link. SDK-built-in Source Link has been on by default since .NET 8 —
       never add the legacy Microsoft.SourceLink.GitHub package alongside this. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <!-- Only stamp CI-deterministic paths in CI: doing this locally breaks IDE "go to source" debugging. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!--
    Versioning — repo-wide lockstep: every packable project ships at one version (DV-007), and one
    v* tag publishes all of them together (the release train, .github/workflows/release.yml). The
    set of packable projects is derived by eng/PackageInventory.proj, so no count is kept here.

    MinVer (declared as a GlobalPackageReference in Directory.Packages.props) computes Version from
    the newest reachable git tag matching MinVerTagPrefix. There is deliberately no <Version> or
    <VersionPrefix> anywhere in this repo (CI fails on one): MinVer's target overwrites $(Version)
    unconditionally, so re-adding one to a csproj would be dead XML rather than a working escape
    hatch. A package therefore CANNOT be versioned independently of its siblings.

    Why lockstep and not per-package or per-domain: dotnet pack converts a ProjectReference into a
    PackageReference at the referenced project's version, and nearly every package depends,
    directly or transitively, on the Foundation-tier packages (SharedKernel.Primitives above all).
    Any rule of the form "bump a dependency, bump its dependents" therefore reaches almost every
    package anyway; lockstep is that rule stated honestly, minus the per-dependency tag resolver the
    alternative would need. The accepted cost is publishing no-op version bumps for untouched
    packages. See eng/README.md "Versioning (MinVer)" and CONTRIBUTING.md "Versioning and releases".

    MinVerMinimumMajorMinor=1.0 sets the floor: with no v* tag reachable (the state of this repo
    until the first release tag is pushed) MinVer stamps 1.0.0-alpha.0 rather than 0.0.0-alpha.0.
    MinVerAutoIncrement=patch means commits after tag v1.2.3 build as 1.2.4-alpha.0.N.

    HARD CI REQUIREMENT: actions/checkout must use fetch-depth: 0. Its default shallow clone carries
    no tags, and MinVer's response to finding no tag is not to fail — it silently stamps the
    MinVerMinimumMajorMinor floor as a prerelease, so a green build would publish mislabelled
    packages. verify.yml sets fetch-depth: 0 on every job that runs dotnet, and eng/verify-packages.sh
    additionally asserts that all packed .nupkg files carry one identical version (the tag's, on a
    release) and that none is missing.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
    <MinVerAutoIncrement>patch</MinVerAutoIncrement>
  </PropertyGroup>

  <!-- Packaging identity — shipping projects only. Every property here was previously hand-duplicated
       in ~45 production csproj files (Authors, Company, Product, Copyright, license, repo URLs,
       symbol format). Description and PackageTags are NOT here: they are the two properties that
       genuinely vary per package (Rule 7) and stay declared in each project's own csproj. -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <Authors>Gresta-Vertex-Labs</Authors>
    <Company>Gresta-Vertex-Labs</Company>
    <Product>Platform.SharedKernel</Product>
    <Copyright>Copyright © 2026 Gresta-Vertex-Labs</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</PackageProjectUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!--
      Single consolidated pack output location (DV-004): replaces the six scattered locations found
      on disk (nupkgs/, artifacts/nupkg/, local-feed/, src/Infrastructure/Persistence/nupkg/, src/Infrastructure/Caching/nupkgs/,
      and seven per-project bin/Release/ dirs). Matches NuGet.Config's "local-shared-kernel" feed.
    -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)nupkgs</PackageOutputPath>
  </PropertyGroup>

  <!-- README packaging item — shipping projects only, guarded so a project without a README does not
       fail restore/pack outright (SKPKG003 in Directory.Build.targets turns that into a hard error
       instead, so the failure is explicit rather than a silently-missing file). -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true' and Exists('README.md')">
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Non-shipping defaults. Only applied when the project has not already declared IsPackable
       itself (Directory.Build.props is imported first, so an explicit value in the project body
       always wins regardless of this condition) — every existing *.Tests/consumer-verify/*Consumer
       project already sets IsPackable=false explicitly; this is a safety net for future ones. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true' and '$(IsPackable)' == ''">
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

</Project>
