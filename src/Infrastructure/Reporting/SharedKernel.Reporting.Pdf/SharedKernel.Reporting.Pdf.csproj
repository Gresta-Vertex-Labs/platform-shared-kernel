<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Adapter</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>Tabular PDF exports for SharedKernel.Reporting — statements, lists and extracts: an optional title, one table whose columns always fit the page (widths by relative weight), a header row repeated on every page, numbers right-aligned, alternating row shading and "page / pages" numbering. Fonts are embedded (Roboto, Apache-2.0), so output is identical on Windows and Linux containers. Built on PDFsharp/MigraDoc (MIT). The document is built in memory, so exports are capped by MaxRows; use CSV or Excel for bulk data, and SharedKernel.Reporting.Gotenberg for free-form HTML documents. Register with services.AddSharedKernelReporting().AddPdf(configuration).</Description>
    <PackageReleaseNotes>First release.</PackageReleaseNotes>
    <PackageTags>shared-kernel;reporting;export;pdf;pdfsharp;migradoc</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Publish bar: ship XML docs, and fail the build on an undocumented or untracked public member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;RS0016;RS0017;RS0024;RS0025</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Never references .Csv, .Spreadsheet or .Gotenberg: sibling providers stay independent. -->
    <ProjectReference Include="..\SharedKernel.Reporting.Abstractions\SharedKernel.Reporting.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Foundation\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      MIT. "PDFsharp-MigraDoc" bundles the MigraDoc.DocumentObjectModel/MigraDoc.Rendering namespaces and depends on
      "PDFsharp" at the identical version; both are pinned explicitly so PDFsharp never rides in unpinned.
    -->
    <PackageReference Include="PDFsharp" />
    <PackageReference Include="PDFsharp-MigraDoc" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Embedded so rendering never depends on the host having a font installed — PDFsharp 6.x enumerates no OS fonts.
      Roboto is Apache License 2.0 (Fonts/LICENSE.txt), compatible with this MIT package.
    -->
    <EmbeddedResource Include="Fonts\Roboto-Regular.ttf" />
    <EmbeddedResource Include="Fonts\Roboto-Bold.ttf" />
    <None Include="Fonts\LICENSE.txt" Pack="true" PackagePath="Fonts\" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.Reporting.Pdf.Tests" />
  </ItemGroup>
</Project>
