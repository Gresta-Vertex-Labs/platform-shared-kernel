<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Adapter</SharedKernelTier>
    <Description>The PostgreSQL connection layer shared by SharedKernel's EF Core and Dapper packages: one options-bound NpgsqlDataSource per connection name (ConnectionStrings:{name}), migration, read-replica and cross-tenant data sources, TLS VerifyFull by default, transaction-local tenant binding for row-level security with a startup check against roles that bypass it, the canonical database role script, namespaced advisory locks and SQLSTATE-to-Error classification. No EF Core dependency.</Description>
    <PackageTags>persistence;postgresql;npgsql;row-level-security;multi-tenancy;tls;advisory-lock;shared-kernel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!--
      P-557/W1: Abstractions-only — no EF Core reference. NpgsqlConnectionFactory implements
      IDbConnectionFactory (SharedKernel.Persistence.Abstractions) directly over a plain Npgsql
      NpgsqlDataSource; nothing here depends on Microsoft.EntityFrameworkCore or
      Npgsql.EntityFrameworkCore.PostgreSQL.
    -->
    <ProjectReference Include="..\SharedKernel.Persistence.Abstractions\SharedKernel.Persistence.Abstractions.csproj" />
    <!-- Options-bound configuration (ISectionBoundOptions/AddValidatedOptions) — 01.Core, within the
         06.Persistence -> 01-05 layering ceiling. -->
    <ProjectReference Include="..\..\..\Foundation\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <!-- P-558/W1b: ADO-level pgvector type mapping on the shared data source (NpgsqlPersistenceOptions.UseVector). -->
    <PackageReference Include="Pgvector" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- P-558/W2-N: the row-level security startup check is an IHostedService; IHostEnvironment relaxes the TLS rule in Development. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <!-- P-557/W7: AdvisoryLockKeyHasher (and other implementation detail) is internal, reached by
         consumers only through NpgsqlAdvisoryMigrationLock/NpgsqlAdvisoryTransactionLock — this grant
         lets the Tests project exercise it directly. -->
    <InternalsVisibleTo Include="SharedKernel.Persistence.Npgsql.Tests" />
    <!--
      P-558/R2: the SQL contract of tenant row-level security (TenantSessionSql: the setting name, the bind statement,
      the policy predicate) and the catalog reads of the RLS startup checks (RowLevelSecurityCatalog) are internal;
      SharedKernel.Persistence.EfCore (RLS interceptor, migration helpers, model-driven RLS check) reaches them here.
      EfCore pins this package to its own exact version in its nuspec, so the internal contract cannot be mixed across versions.
    -->
    <InternalsVisibleTo Include="SharedKernel.Persistence.EfCore" />
    <InternalsVisibleTo Include="SharedKernel.Persistence.Dapper.Tests" />
    <InternalsVisibleTo Include="SharedKernel.Persistence.EfCore.Integration.Tests" />
  </ItemGroup>
</Project>
