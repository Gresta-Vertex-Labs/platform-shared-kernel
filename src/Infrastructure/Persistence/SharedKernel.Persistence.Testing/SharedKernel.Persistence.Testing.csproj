<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Testing</SharedKernelTier>
    <Description>Test helpers for services built on the SharedKernel persistence packages — reference from test projects only. In-memory fakes that follow the production rules (specification evaluation, paging and cursors, a unit of work that rolls back and replays like the retrying strategy), a test IRequestContext, and a Testcontainers PostgreSQL fixture that provisions the production database roles and applies the row-level security, audit-ledger and encryption migration helpers.</Description>
    <PackageTags>persistence;testing;test-doubles;fakes;testcontainers;postgresql;integration-testing;shared-kernel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A test-helper LIBRARY, not a test project: dotnet test must not try to run it. -->
    <IsTestProject>false</IsTestProject>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- TestRequestContext, the IRequestContext double every testing package shares, lives in the lightweight core
         package (P-571); this package builds on it. -->
    <ProjectReference Include="..\..\..\Testing\SharedKernel.Testing\SharedKernel.Testing.csproj" />
    <!-- IRepository/IReadRepository, IDbConnectionFactory, ICrossTenantScope; IUnitOfWork, IRequestContext and
         IAuditTrailWriter arrive through SharedKernel.Execution. -->
    <ProjectReference Include="..\SharedKernel.Persistence.Abstractions\SharedKernel.Persistence.Abstractions.csproj" />
    <!-- PostgresTestDatabase: the migration helpers it applies (row-level security, audit ledger, tenant keys) and
         the EF Core SQL generator that turns them into statements. -->
    <ProjectReference Include="..\SharedKernel.Persistence.EfCore\SharedKernel.Persistence.EfCore.csproj" />
    <ProjectReference Include="..\SharedKernel.Persistence.EfCore.Auditing\SharedKernel.Persistence.EfCore.Auditing.csproj" />
    <ProjectReference Include="..\SharedKernel.Persistence.EfCore.Encryption\SharedKernel.Persistence.EfCore.Encryption.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!--
      Testcontainers 4.13.0 depends on SSH.NET 2025.1.0 (CVE-2026-48798, GHSA-q939-rpr3-3284, GHSA-mggc-4xg6-vcxf).
      The repo-wide SSH.NET GlobalPackageReference (Directory.Packages.props) is PrivateAssets="all" and never reaches
      a consumer; this project, the one packable project that brings Testcontainers to consumers, is excluded from it
      and ships the patched version as a real .nuspec dependency instead.
    -->
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
