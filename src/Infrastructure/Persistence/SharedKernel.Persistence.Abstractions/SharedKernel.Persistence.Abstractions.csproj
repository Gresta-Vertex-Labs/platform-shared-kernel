<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Abstractions</SharedKernelTier>
    <Description>ORM-free persistence contracts for SharedKernel services: IRepository (always tracks) and IReadRepository (never tracks) over domain specifications with offset, keyset and projected paging; EntityVersion for ETag/If-Match optimistic concurrency; set-based bulk updates and deletes; ICrossTenantScope for explicit, logged cross-tenant work; IDbConnectionFactory. No EF Core, Npgsql or Dapper dependency. Implemented by SharedKernel.Persistence.EfCore.</Description>
    <PackageTags>persistence;repository;specification;optimistic-concurrency;etag;multi-tenancy;abstractions;shared-kernel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Foundation\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\..\Model\Domain\SharedKernel.Domain\SharedKernel.Domain.csproj" />
    <!--
      Deliberate design decision (P-080, Cap 3): SharedKernel.Contracts (04.Contracts) is
      referenced to expose PagedList<T> as the return type of IReadRepository.ListPagedAsync.
      An Abstractions-tier package may reference Model-tier packages (root CLAUDE.md "Tiers &amp;
      Dependency Rules"). It widens
      the Abstractions dependency surface from [Primitives, Domain] to [Primitives, Domain,
      Contracts]. No ORM NuGet references are introduced by this change.
    -->
    <ProjectReference Include="..\..\..\Model\Contracts\SharedKernel.Contracts\SharedKernel.Contracts.csproj" />
    <!--
      P-558: the single copy of IUnitOfWork, IRequestContext and IAuditTrailWriter/AuditEntry/AuditOutcome.
      MediatR-free by design; the ONLY 05.Application package 06.Persistence may reference (never
      SharedKernel.Application, .Behaviors or MediatR — locked by 00.Governance).
    -->
    <ProjectReference Include="..\..\..\Foundation\SharedKernel.Execution\SharedKernel.Execution.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- P-558/W2: the default ICrossTenantScope (scoped, logged) and its registration helper live here, so a
         Dapper-only service gets one without referencing EF Core. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
