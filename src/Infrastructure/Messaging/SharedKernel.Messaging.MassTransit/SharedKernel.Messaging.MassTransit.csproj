<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Adapter</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>MassTransit 8.5.x wiring for Platform.SharedKernel microservices: MassTransitMessageBus, MassTransitEventPublisher, ConsumerBase, MessagingBusBuilder, configurable retry and circuit breaker, transport-native delayed delivery, atomic consumer idempotency and payload compression/encryption. Transports (RabbitMQ, Azure Service Bus) and the EF Core outbox are separate packages. CloudEvents-compliant envelope publishing; dispatch failures are returned as messaging.* Result codes. Pinned to the 8.5.x line because that is the last Apache-2.0 MassTransit release.</Description>
    <PackageTags>messaging;masstransit;cloud-events;consumer-base;shared-kernel</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Set per-project, not inherited: the SDK assigns GenerateDocumentationFile=false before
      Directory.Build.targets' "== empty"-guarded default is evaluated. CS1591 below makes an
      undocumented public member a build error.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API tracking: an addition, removal or signature change fails the build until PublicAPI.*.txt is updated. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
    <!-- RS0026/RS0027: optional CancellationToken and configure-callback parameters, the .NET convention. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Project references:
        SharedKernel.Messaging.Abstractions — IMessageBus, IEventPublisher, IMessagingBuilder, MessagingOptions
        SharedKernel.Contracts             — EventEnvelope<TEvent> used by MassTransitEventPublisher
        SharedKernel.Compression           — IPayloadCompressor, used by WithPayloadTransform() (P-346)
        SharedKernel.Cryptography          — ISynchronousSymmetricEncryptionService, used by WithPayloadTransform() (P-346)
      Both SharedKernel.Compression and SharedKernel.Cryptography are Foundation-tier packages,
      which an Adapter-tier package may always reference.
      NO reference to any 06.Persistence.* package is permitted, and no broker client or EF Core:
      those live in the .RabbitMq, .AzureServiceBus and .EfCore satellite packages (P-570).
    -->
    <ProjectReference Include="..\SharedKernel.Messaging.Abstractions\SharedKernel.Messaging.Abstractions.csproj" />
    <!-- IIdempotencyStore (keyed by IdempotencyPurpose.Message), consumed by IdempotentConsumerBehavior. -->
    <ProjectReference Include="..\..\Idempotency\SharedKernel.Idempotency.Abstractions\SharedKernel.Idempotency.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Model\Contracts\SharedKernel.Contracts\SharedKernel.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Foundation\SharedKernel.Compression\SharedKernel.Compression.csproj" />
    <ProjectReference Include="..\..\..\Foundation\SharedKernel.Cryptography\SharedKernel.Cryptography.csproj" />
    <!--
      SharedKernel.Configuration — AddValidatedOptions, the platform's only sanctioned options
      registration (P-561). Deliberately referenced here and NOT from
      SharedKernel.Messaging.Abstractions: that package is pure contracts, and a service that
      consumes IMessageBus without composing a bus should not inherit a configuration binder.
      AddSharedKernelMessaging(IConfiguration) reads MessagingOptions.SectionName itself, so no
      call site names the section either way — the ISectionBoundOptions form would buy nothing
      here and cost every downstream consumer a dependency.
    -->
    <ProjectReference Include="..\..\..\Foundation\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      MassTransit core only, pinned to the 8.5.x line in Directory.Packages.props because it is the
      last Apache-2.0 release; 9.x is commercially licensed (P-560). Do not bump without a recorded
      licensing decision.

      No transport and no EF Core (P-570): RabbitMQ is SharedKernel.Messaging.MassTransit.RabbitMq,
      Azure Service Bus (with Azure.Identity) is SharedKernel.Messaging.MassTransit.AzureServiceBus and the
      EF Core outbox is SharedKernel.Messaging.MassTransit.EfCore. Each plugs into MessagingBusBuilder
      (UseTransport / ConfigureMassTransit), so a service pulls only the broker it runs on.
    -->
    <PackageReference Include="MassTransit" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!--
      MassTransit.Quartz was removed by P-560. Deferred delivery now runs entirely on the
      transport's own scheduled-delivery feature (WithDelayedDelivery() -> the RabbitMQ
      delayed-message exchange, or Azure Service Bus native scheduled enqueue), which is
      broker-side and already survives a process restart. The Quartz path duplicated that
      guarantee at the cost of a second relational database, its schema and its migrations,
      inside a messaging package. Recurring/cron scheduling belongs to 19.Scheduling, which
      deliberately reuses only Quartz's CronExpression parser and never its IScheduler/JobStore.
    -->
    <!--
      Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions — HealthCheckContext/
      HealthCheckResult/HealthStatus/HealthCheckRegistration types only, used by
      MassTransitMessageBusProbe (P-347) to invoke MassTransit's own MassTransit.Monitoring.
      BusHealthCheck. Deliberately the Abstractions-only package, not the full
      Microsoft.Extensions.Diagnostics.HealthChecks package (that package's AddHealthChecks()/
      HealthCheckService/publisher-hosted-service machinery is 13.ServiceDefaults's concern —
      this domain ships no IHealthCheck implementation and no AddHealthChecks() wiring.
    -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Allow test project to access internal types (MassTransitMessageBus, MassTransitEventPublisher) -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Messaging.MassTransit.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- P-570: the outbox round-trip tests moved with the outbox and publish through MassTransitEventPublisher. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.Messaging.MassTransit.EfCore.Tests</_Parameter1>
    </AssemblyAttribute>
    <!--
      P-566: the cross-transport propagation tests host the consume filter and the bus on MassTransit's in-memory
      transport, which the public builder (RabbitMQ / Azure Service Bus only) does not offer.
    -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SharedKernel.ServiceDefaults.Security.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <!--
      Public API tracking: an addition, removal or signature change fails the build until
      PublicAPI.*.txt is updated, so a breaking change to a package hundreds of services consume
      is a reviewed diff rather than something noticed after publish (P-561).
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
