<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Testing</SharedKernelTier>
    <Description>In-memory test doubles for SharedKernel.Messaging.Abstractions, for test projects only. InMemoryMessageBus and InMemoryEventPublisher record every publish and send with assertion helpers (ShouldHavePublished, ShouldHaveSent, ShouldNotHavePublished), so a handler can be tested without a broker.</Description>
    <PackageTags>messaging;testing;test-doubles;in-memory;shared-kernel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A test-helper LIBRARY, not a test project: dotnet test must not try to run it. -->
    <IsTestProject>false</IsTestProject>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Messaging.Abstractions\SharedKernel.Messaging.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Model\Contracts\SharedKernel.Contracts\SharedKernel.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
