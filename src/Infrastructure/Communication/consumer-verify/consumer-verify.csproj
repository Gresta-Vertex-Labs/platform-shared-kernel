<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Not shipped — verification harness only -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- The two packages a service references; SharedKernel.Communication comes with them. -->
    <ProjectReference Include="..\SharedKernel.Communication.Rest\SharedKernel.Communication.Rest.csproj" />
    <ProjectReference Include="..\SharedKernel.Communication.Grpc\SharedKernel.Communication.Grpc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- A real generic host, so ValidateOnStart runs the way it does in a service. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>
