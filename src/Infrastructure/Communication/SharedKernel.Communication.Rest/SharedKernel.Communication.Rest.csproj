<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Adapter</SharedKernelTier>
    <SharedKernelAllowedAdapterReferences>SharedKernel.Communication</SharedKernelAllowedAdapterReferences>
    <!-- NuGet packaging metadata -->
    <Description>Typed REST clients for SharedKernel services: AddSharedKernelCommunication(configuration).AddRestClient&lt;IClient, Client&gt;("name") with the address, timeouts, retries and credentials bound from SharedKernel:Communication:Clients:{name}. Microsoft.Extensions.Http.Resilience (retry with jitter, per-attempt and total timeouts, circuit breaker, or hedging), and retries never repeat a POST or PATCH unless it carries an Idempotency-Key. The caller's correlation id, tenant, actor and client travel on every call from any host (HTTP, message consumer, job). Results, not exceptions: GetResultAsync/PostResultAsync read a platform ProblemDetails back into the same Error the other service returned and turn an unreachable service, a timeout or an open circuit into Error values.</Description>
    <PackageReleaseNotes>First release.</PackageReleaseNotes>
    <PackageTags>shared-kernel;http-client;rest;resilience;polly;problem-details;idempotency-key;correlation-id</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Publish bar: ship XML docs, and fail the build on an undocumented or untracked public member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;RS0016;RS0017;RS0024;RS0025</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The declared adapter edge: the shared client base. No ASP.NET Core: the caller is IRequestContextAccessor's. -->
    <ProjectReference Include="..\SharedKernel.Communication\SharedKernel.Communication.csproj" />
    <ProjectReference Include="..\..\..\Foundation\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\..\Foundation\SharedKernel.Execution\SharedKernel.Execution.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.Communication.Rest.Tests" />
  </ItemGroup>
</Project>
