<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Testing</SharedKernelTier>
    <Description>Test helpers for SharedKernel's REST and gRPC clients, for test projects only. StubHttpMessageHandler answers a typed client's requests (JSON, platform ProblemDetails, a status, a thrown failure) and records what it was sent; UseStubHttpMessageHandler puts it under a client registered with AddRestClient. GrpcCalls fakes a generated client's unary calls — a response, or a failure carrying the rich status a platform service sends — for mocking. TestServerCallContext builds a ServerCallContext for gRPC service tests.</Description>
    <PackageTags>communication;http-client;grpc;testing;test-doubles;shared-kernel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A test-helper LIBRARY, not a test project: dotnet test must not try to run it. -->
    <IsTestProject>false</IsTestProject>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Communication\SharedKernel.Communication.csproj" />
    <ProjectReference Include="..\..\..\Foundation\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Core.Testing" />
    <PackageReference Include="Grpc.StatusProto" />
    <PackageReference Include="Google.Api.CommonProtos" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
