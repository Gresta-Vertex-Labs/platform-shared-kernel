<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Adapter</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>FluentValidation rules for the SharedKernel.Validation identifier types: MustBeValidIban, MustBeValidCardNumber, MustBeValidVatNumber, MustBeValidNationalId and more, plus MustBeValid&lt;T, TValue&gt; for any identifier. Each failure carries the identifier's specific error code, its translatable message values and the field path, never the rejected value, so card and national ID numbers stay out of validation results and logs. Also bridges FluentValidation into the kernel request pipeline: AddFluentValidationRequestValidators() runs every IValidator&lt;T&gt; registered for a request as SharedKernel.Application's IRequestValidator&lt;T&gt;, so SharedKernel.Application.Pipeline's ValidationBehavior needs no FluentValidation dependency. A separate package so code that does not use FluentValidation never depends on it.</Description>
    <PackageReleaseNotes>First release.</PackageReleaseNotes>
    <PackageTags>shared-kernel;validation;fluentvalidation;iban;card-number;vat;national-id</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Publish bar: ship XML docs, and fail the build on an undocumented or untracked public member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;RS0016;RS0017;RS0024;RS0025</WarningsAsErrors>
    <!-- Optional parameters are intentional. RS0041: the rule signatures are deliberately nullable-oblivious, like FluentValidation's own. -->
    <NoWarn>$(NoWarn);RS0026;RS0027;RS0041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <ProjectReference Include="..\SharedKernel.Validation\SharedKernel.Validation.csproj" />
    <!-- IRequestValidator<T>, bridged by AddFluentValidationRequestValidators() (Adapter -> Abstractions). -->
    <ProjectReference Include="..\..\Application\SharedKernel.Application\SharedKernel.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
