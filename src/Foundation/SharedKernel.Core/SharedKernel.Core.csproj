<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Foundation</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>Core building blocks for .NET services built on SharedKernel.Primitives: railway extensions for Result and Result&lt;T&gt; (Map, Bind, Ensure, Tap, Match, with Task and ValueTask overloads), exception boundaries (ResultTry), multi-result aggregation (ResultCombine), a base exception hierarchy that always carries a structured Error, and two-path guard clauses (Guard.Against returns an Error, Guard.Throw throws). No third-party dependencies.</Description>
    <PackageReleaseNotes>First release.</PackageReleaseNotes>
    <PackageTags>shared-kernel;result;railway-oriented;guard-clauses;exceptions;ddd</PackageTags>
    <!--
      Ship the XML documentation alongside the assembly. Not redundant with Directory.Build.targets: the SDK
      assigns GenerateDocumentationFile=false early, so that file's empty-string-guarded default never applies,
      and the nupkg would otherwise contain the .dll and no .xml. CS1591 below makes an undocumented public
      member a build error.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API tracking: an addition, removal or signature change fails the build until PublicAPI.*.txt is updated. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
    <!-- RS0026/RS0027 discourage optional parameters on overloads. Every guard ends with an optional
         [CallerArgumentExpression] paramName, which must be optional to work, as in ArgumentNullException.ThrowIfNull. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
