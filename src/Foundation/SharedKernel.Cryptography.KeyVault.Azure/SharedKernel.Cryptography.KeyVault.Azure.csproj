<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Adapter</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>Azure Key Vault for SharedKernel.Cryptography. Encryption: AES-256 data keys wrapped by a Key Vault master key (RSA or managed-HSM AES) and stored as versions of one Key Vault secret, so every replica shares the same current key and rotation is a single call; implements IEncryptionKeyProvider, IEnvelopeEncryptionProvider and a readiness probe, with keys cached in memory and untrusted key ids never able to trigger unbounded Key Vault calls. Signing: RSA and ECDSA keys that never leave Key Vault, signing remotely through asynchronous calls and verifying locally with the public key, for PS256–PS512, RS256–RS512 and ES256–ES512. Master key material never leaves Key Vault.</Description>
    <PackageReleaseNotes>First release.</PackageReleaseNotes>
    <PackageTags>shared-kernel;cryptography;azure;key-vault;kms;envelope-encryption;key-rotation;signing;rsa;ecdsa</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API tracking: an addition, removal or signature change fails the build until PublicAPI.*.txt is updated. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Security.KeyVault.Keys" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Cryptography\SharedKernel.Cryptography.csproj" />
    <ProjectReference Include="..\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- One single-flight cache implementation, shared as source with SharedKernel.Cryptography. -->
    <Compile Include="..\SharedKernel.Cryptography\Internal\SingleFlightCache.cs" Link="Internal\SingleFlightCache.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
