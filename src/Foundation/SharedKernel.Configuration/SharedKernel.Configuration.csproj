<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Foundation</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>Options-pattern registration that fails at host startup, not at first use. AddValidatedOptions binds a configuration section, validates it with Data Annotations or a caller-supplied IValidateOptions (such as an [OptionsValidator]-generated one), and enforces it via ValidateOnStart. ISectionBoundOptions lets an options type declare its own section path, and OptionsStrictness opts in to rejecting a missing section or an unrecognised key. Supports named options. No SharedKernel dependencies. Not trim- or AOT-safe: configuration binding is reflective, and every overload declares it.</Description>
    <PackageReleaseNotes>First release.</PackageReleaseNotes>
    <PackageTags>shared-kernel;options;configuration;validation;dependency-injection;options-pattern</PackageTags>
    <!--
      Set per-project, not inherited: the SDK assigns GenerateDocumentationFile=false before
      Directory.Build.targets' '== empty'-guarded default is evaluated, so the central default
      never applies and the package would ship without its XML docs. CS1591 below makes an
      undocumented public member a build error.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API tracking: an addition, removal or signature change fails the build until PublicAPI.*.txt is updated. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
    <!-- RS0026/RS0027 discourage optional parameters on overloads. The four AddValidatedOptions overloads differ by
         section source and validator, and each ends in the same optional name/strictness pair, so callers name the
         arguments they set instead of every overload spelling out every combination. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
