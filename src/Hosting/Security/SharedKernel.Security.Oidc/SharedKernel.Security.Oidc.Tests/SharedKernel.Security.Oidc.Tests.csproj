<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Security.Oidc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      SharedKernel.Testing (16.Testing), for InMemoryLogger<TCategoryName>/LoggerAssertions used to
      prove structured security-audit logging (T-17, WO-057/P-371) — every .Tests project references
      16.Testing per the root CLAUDE.md Test Project Rules.
    -->
    <ProjectReference Include="..\..\..\..\Testing\SharedKernel.Testing\SharedKernel.Testing.csproj" />
    <ProjectReference Include="..\..\..\..\Testing\SharedKernel.Security.Testing\SharedKernel.Security.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="NSubstitute" />
    <!--
      Pinned to 10.0.9, not 9.0.5 — SharedKernel.Testing (referenced above) already pulls
      Microsoft.Extensions.DependencyInjection >= 10.0.9 transitively; a lower explicit pin here is
      an NU1605 downgrade error (mirrors SharedKernel.Security.ApiKey.Tests's identical pin).
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>
