  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Presentation.SignalR.csproj" />
    <!-- The edge-mapper conformance catalogue every protocol suite of this domain asserts (P-612). -->
