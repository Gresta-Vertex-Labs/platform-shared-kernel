<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Host</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>OpenAPI for SharedKernel HTTP APIs in one call (AddSharedKernelOpenApi, MapSharedKernelOpenApi, bound from SharedKernel:Presentation:OpenApi): API versioning by URL segment and X-Api-Version header, one native OpenAPI document per API version and a Scalar reference listing them all, served in Development only unless exposed explicitly, with a startup warning when exposed without authorization. Every operation documents the platform's RFC 9457 application/problem+json error shape; protected operations carry their security requirement (Bearer, API key, mutual TLS) with 401 and 403; required Idempotency-Key and If-Match headers, whether a convention, an attribute or an IdempotencyKey or IfMatch&lt;TVersion&gt; parameter requires them, are documented with 400, and If-Match with 412 and 428. Sunset and deprecation policies emit RFC 9745 Deprecation, RFC 8594 Sunset and Link headers.</Description>
    <PackageTags>shared-kernel;openapi;scalar;api-versioning;aspnetcore;problemdetails;rfc9457;rfc9745;rfc8594;sunset;deprecation</PackageTags>
    <!--
      Set per-project, not inherited: the SDK assigns GenerateDocumentationFile=false before
      Directory.Build.targets' '== empty'-guarded default is evaluated. CS1591 below makes an
      undocumented public member a build error.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API tracking: an addition, removal or signature change fails the build until PublicAPI.*.txt is updated. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Host tier: an add-on of the WebApi core in the same domain. It documents what the core enforces
      (the problem shape, authorization metadata, required headers) and never changes a response; every
      third-party dependency of the HTTP boundary lives here, so the core stays dependency-free.
      SharedKernel.Presentation.Core (P-579) holds the authorization attributes and policy names it documents.
    -->
    <ProjectReference Include="..\SharedKernel.Presentation.WebApi\SharedKernel.Presentation.WebApi.csproj" />
    <ProjectReference Include="..\SharedKernel.Presentation.Core\SharedKernel.Presentation.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Asp.Versioning.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.Presentation.OpenApi.Tests" />
  </ItemGroup>
</Project>
