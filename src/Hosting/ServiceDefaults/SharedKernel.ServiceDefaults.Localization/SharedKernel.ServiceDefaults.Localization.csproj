<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Host</SharedKernelTier>
    <Description>Request-culture resolution for Platform.SharedKernel microservices: AddSharedKernelLocalization wraps ASP.NET Core request localization with a StrategyOrder of user-preference claim, then tenant default culture via SharedKernel.MultiTenancy ITenantCatalog, then the Accept-Language header. Split out of SharedKernel.ServiceDefaults (WO-084).</Description>
    <PackageTags>shared-kernel;service-defaults;localization;culture;multi-tenancy</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Per-project: the SDK assigns false before the Directory.Build.targets default is evaluated. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.ServiceDefaults\SharedKernel.ServiceDefaults.csproj" />
    <ProjectReference Include="..\SharedKernel.MultiTenancy\SharedKernel.MultiTenancy.csproj" />
    <ProjectReference Include="..\..\Security\SharedKernel.Security.Abstractions\SharedKernel.Security.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.ServiceDefaults.Localization.Tests" />
  </ItemGroup>
</Project>
