<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\..\Testing\SharedKernel.Testing\SharedKernel.Testing.csproj" />
    <!--
      Test-only reference to the sibling SharedKernel.MultiTenancy package, used solely by
      AmbientLoggingEnrichmentAcceptanceTests to prove TenantResolutionMiddleware's Activity
      baggage and BaggageLogRecordProcessor compose correctly end-to-end (WO-041/P-251, T-28).
      Both packages live under 13.ServiceDefaults — this is a same-domain sibling reference, not a
      layering violation.
    -->
    <ProjectReference Include="..\..\SharedKernel.MultiTenancy\SharedKernel.MultiTenancy.csproj" />
    <!--
      D-28 (WO-063/P-419, rewritten for P-562) gating-proof-only — mirrors the T-43/WO-056
      Grpc.AspNetCore/Polly.Core precedent above: RateLimitRejectionRecipeTests proves that
      AddSharedKernelRateLimiting() composed with SharedKernel.Presentation.WebApi's
      AddSharedKernelWebApi()/UseSharedKernelWebApi() answers a rejection with the platform's 429
      application/problem+json body, as this domain's README documents. NEVER referenced by the
      production SharedKernel.ServiceDefaults.csproj — 13.ServiceDefaults's layering ceiling (01-12
      plus individually-named exceptions) deliberately excludes 14.Presentation, and D-28 reaffirms
      rather than reopens that boundary. Test-only.
    -->
    <ProjectReference Include="..\..\..\Presentation\SharedKernel.Presentation.WebApi\SharedKernel.Presentation.WebApi.csproj" />
    <!-- P-579: the HTTP edge that refuses inbound baggage is UseSharedKernelRequestContext() (test-only reference). -->
    <ProjectReference Include="..\..\SharedKernel.ServiceDefaults.Security\SharedKernel.ServiceDefaults.Security.csproj" />
    <!-- EventIdUniquenessTests reads every [LoggerMessage] of the domain's production assemblies (test-only references). -->
    <ProjectReference Include="..\..\SharedKernel.ServiceDefaults.Security.Mtls\SharedKernel.ServiceDefaults.Security.Mtls.csproj" />
    <ProjectReference Include="..\..\SharedKernel.ServiceDefaults.Localization\SharedKernel.ServiceDefaults.Localization.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!--
      T-43 (WO-056/P-365) gating proof only — never referenced by the production
      SharedKernel.ServiceDefaults.csproj. Grpc.AspNetCore (server + Grpc.Tools codegen +
      Google.Protobuf) and Grpc.Net.Client (client) host a real, minimal in-process gRPC service
      (GrpcFixtures/greeter.proto) so CommunicationTelemetryExtensionsTests can prove
      WithCommunicationTelemetry()'s .AddGrpcClientInstrumentation() wiring against a genuine
      outbound call, not merely that the extension didn't throw.
    -->
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Net.Client" />
    <!--
      T-43 (WO-056/P-365) gating proof only. C-47 confirmed (by decompiling the installed
      assemblies) that Microsoft.Extensions.Http.Resilience 10.7.0 — the real production
      dependency chain WithCommunicationTelemetry()'s Polly meter wiring targets — transitively
      pins Polly.Core/Polly.Extensions 8.4.2. This test project cannot pin that exact version
      itself: central package management (Directory.Packages.props) pins Polly.Core at 8.7.0
      repo-wide. 8.7.0 is a same-major (v8) release of the identical package this
      finding targets — the "Polly"-named Meter this test proves against is a stable, documented
      public surface of Polly's own resilience telemetry, not a version-specific implementation
      detail.
    -->
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Polly.Extensions" />
    <!-- SK.13.ServiceDefaultsConformance C-08, test-only: a faulting typed HttpClient through the standard resilience handler. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <!--
      T-43 (WO-056/P-365) gating proof only. In-memory metric exporter — the metrics-signal
      analogue of this file's existing BaseProcessor&lt;Activity&gt; tracing-capture idiom
      (T-39/T-40 precedent) — used to prove the "Polly" meter's measurements actually flow through
      a built MeterProvider.
    -->
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
    <!--
      SK.13.WildcardTelemetry T-03, test-only: WithWorkflowTelemetry() is proven against the Temporal SDK's own
      TracingInterceptor source objects, so an upstream rename fails the test. Never referenced by the base.
    -->
    <PackageReference Include="Temporalio.Extensions.OpenTelemetry" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Telemetry\GrpcFixtures\greeter.proto" GrpcServices="Both" />
  </ItemGroup>
</Project>
