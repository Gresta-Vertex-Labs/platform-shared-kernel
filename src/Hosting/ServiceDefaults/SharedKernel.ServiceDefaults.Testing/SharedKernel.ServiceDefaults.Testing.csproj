<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Testing</SharedKernelTier>
    <Description>Test helpers for the SharedKernel host packages, for test projects only. An in-memory ITenantCatalog, a configurable tenant-resolution strategy and health-check result assertions.</Description>
    <PackageTags>servicedefaults;multitenancy;health-checks;testing;test-doubles;shared-kernel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A test-helper LIBRARY, not a test project: dotnet test must not try to run it. -->
    <IsTestProject>false</IsTestProject>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
    <!-- RS0027: FakeTenantResolutionStrategy keeps its original constructor pair (an optional fixed result, or a
         resolver function); reshaping it only to satisfy the public-API overload rule would break existing callers. -->
    <NoWarn>$(NoWarn);RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.MultiTenancy\SharedKernel.MultiTenancy.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
