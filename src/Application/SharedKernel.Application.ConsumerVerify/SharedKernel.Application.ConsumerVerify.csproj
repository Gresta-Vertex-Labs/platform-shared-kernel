<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <!--
    Consumer verification: resolves SharedKernel.Application, .Pipeline and .Mediator.MediatR (plus the FluentValidation bridge) as packages, never
    as projects, to confirm the packed dependency graph and public API work for a real consumer. Point restore at the
    feed under test, and pin the version with -p:SharedKernelPackageVersion=<version>.
  -->
  <ItemGroup>
    <PackageReference Include="SharedKernel.Application" />
    <PackageReference Include="SharedKernel.Application.Pipeline" />
    <PackageReference Include="SharedKernel.Application.Mediator.MediatR" />
    <PackageReference Include="SharedKernel.Idempotency.Abstractions" />
    <PackageReference Include="SharedKernel.Validation.FluentValidation" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
