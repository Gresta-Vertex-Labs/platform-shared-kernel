<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Testing</SharedKernelTier>
    <Description>Test doubles for SharedKernel.Cryptography, for test projects only. Fakes that run the real algorithms with call recording and failure simulation: symmetric and envelope encryption, rotatable key providers, signing, HMAC, one-way hashing, content hashing, a seedable secure random generator and a TOTP replay guard, registered with AddFakeCryptography().</Description>
    <PackageTags>cryptography;encryption;testing;test-doubles;fakes;shared-kernel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A test-helper LIBRARY, not a test project: dotnet test must not try to run it. -->
    <IsTestProject>false</IsTestProject>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
    <!-- RS0026/RS0027 (several public overloads with optional parameters): a test double mirrors the overload set of
         the interface it implements, so the rule cannot be satisfied without breaking the contract it fakes. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Testing\SharedKernel.Testing.csproj" />
    <ProjectReference Include="..\..\Foundation\SharedKernel.Cryptography\SharedKernel.Cryptography.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
