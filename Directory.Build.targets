<Project>

  <!--
    Evaluated AFTER the project body, so these targets can observe what the csproj itself set
    (Description, PackageTags, IsPackable) and fail the pack step if a shipping project forgot one.
    Mechanical enforcement of "Description/PackageTags stay per-project" (Rule 7 / PLATFORM.md
    "Build Configuration Map").
  -->

  <!--
    Documentation — shipping library projects only. Deliberately placed here, not in
    Directory.Build.props: OutputType is set inside each project's own body, which is imported
    AFTER Directory.Build.props but BEFORE Directory.Build.targets, so only here is $(OutputType)
    actually resolved to "Exe" for the consumer-verify/*Consumer harnesses. Excludes test projects
    (no public API to document) and Exe harnesses (a console Program.cs is not a public library
    surface; generating docs for it produces CS1591 errors on every harness that also has its own
    TreatWarningsAsErrors=true, which most consumer-verify projects do) — and only applies when the
    project has not already set GenerateDocumentationFile itself.
  -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true' and '$(OutputType)' != 'Exe' and '$(GenerateDocumentationFile)' == ''">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <Target Name="SKPKG001_RequireDescription" BeforeTargets="Pack" Condition="'$(IsPackable)' == 'true'">
    <Error Condition="'$(Description)' == ''"
           Text="SKPKG001: $(MSBuildProjectName) is packable but has no &lt;Description&gt;. Every shipped package needs a real, per-project description." />
  </Target>

  <Target Name="SKPKG002_RequirePackageTags" BeforeTargets="Pack" Condition="'$(IsPackable)' == 'true'">
    <Error Condition="'$(PackageTags)' == ''"
           Text="SKPKG002: $(MSBuildProjectName) is packable but has no &lt;PackageTags&gt;. Every shipped package needs per-project tags." />
  </Target>

  <Target Name="SKPKG003_RequireReadme" BeforeTargets="Pack" Condition="'$(IsPackable)' == 'true'">
    <Error Condition="!Exists('README.md')"
           Text="SKPKG003: $(MSBuildProjectName) is packable but has no adjacent README.md. PackageReadmeFile is centrally set and will fail Pack without one." />
  </Target>

  <!-- Package tiers and their dependency matrix (WO-086 / P-563). -->
  <Import Project="$(MSBuildThisFileDirectory)eng/SharedKernelTiers.targets" />

  <Target Name="SKPKG004_TestsNeverPack" BeforeTargets="Pack" Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <Error Condition="'$(IsPackable)' == 'true'"
           Text="SKPKG004: $(MSBuildProjectName) ends in .Tests and must never be packable, even if IsPackable=true was set by hand." />
  </Target>

  <!--
    The release train's expected package set (WO-086 / P-572). Queried for every csproj in the
    repository by eng/PackageInventory.proj, which eng/verify-packages.sh compares against what
    `dotnet pack` actually produced. Returns nothing for a project that does not pack, so the set is
    derived from the same evaluated IsPackable/PackageId that Pack uses, never from a hand-kept list.
    Evaluation only: builds nothing, needs no restore.
  -->
  <Target Name="GetSharedKernelPackageIdentity" Returns="@(_SkPackageIdentity)">
    <ItemGroup>
      <_SkPackageIdentity Include="$(PackageId)" Condition="'$(IsPackable)' == 'true'" Tier="$(SharedKernelTier)" />
    </ItemGroup>
  </Target>

</Project>
