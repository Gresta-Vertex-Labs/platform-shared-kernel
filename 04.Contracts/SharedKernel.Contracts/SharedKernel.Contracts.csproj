<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Model</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>Cross-service wire contracts for .NET services: integration events carried in a CloudEvents 1.0 JSON envelope with stable, attribute-declared event names and versions; offset-paged and cursor-paged result lists; validated page and cursor requests; and an opaque keyset cursor codec. Depends only on SharedKernel.Primitives.</Description>
    <PackageReleaseNotes>First release.</PackageReleaseNotes>
    <PackageTags>shared-kernel;contracts;integration-events;cloudevents;event-envelope;pagination;cursor-pagination;keyset-pagination;dto</PackageTags>
    <!--
      Ship the XML documentation alongside the assembly. Not redundant with Directory.Build.targets: the SDK
      assigns GenerateDocumentationFile=false early, so that file's empty-string-guarded default never applies.
      CS1591 below makes an undocumented public member a build error.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API tracking: an addition, removal or signature change fails the build until PublicAPI.*.txt is updated. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
    <!-- RS0026/RS0027 discourage optional parameters on overloads. The request factories and the cursor codec take
         optional limits and serializer options, which read better at call sites than a second overload per method. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Error and ValidationResult for request validation and cursor decoding. No other reference is permitted. -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
