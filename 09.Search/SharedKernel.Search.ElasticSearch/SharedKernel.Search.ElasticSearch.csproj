<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Root policy: <IsAotCompatible>true</IsAotCompatible> is never added to any 09.Search .csproj —
      the tag activates trim/AOT analyzers globally and forces AOT compliance on the entire project,
      which is too coarse-grained. This package simply inherits an already-annotated dependency
      (Elastic.Clients.Elasticsearch sets IsAotCompatible for net8+ on its own project).
    -->
    <!-- NuGet packaging metadata -->
    <!--
      WO-055 P-09/P-10 version-bump decision (recorded per the phase's own instruction not to silently
      collapse two distinct bumps): P-353's internal-only bulk double-serialization fix is PATCH-shaped
      in isolation, and P-354's new SearchBulkWriteOptions overloads are MINOR-shaped in isolation, but
      both land in the SAME work order and the SAME re-pack session with no intervening published
      release ever consuming a standalone PATCH artifact — a real 1.0.1 pack would be immediately
      superseded by 1.1.0 with zero consumer ever depending on the intermediate version. The two bumps
      are therefore folded into a single MINOR release, 1.1.0, covering both fixes in one pack. This is
      a deliberate decision, not an oversight — see 09.Search/state-map.md Phase: Published P-09/P-10.
    -->
    <Description>ElasticSearch (analytics/heavy) implementation of SharedKernel.Search.Abstractions: ElasticSearchIndex&lt;TDocument&gt;, ElasticSearchIndexProvisioner (alias-based cutover), ElasticSearchProviderDescriptor, ElasticSearchFilterCompiler, plus the ElasticSearch-exclusive IAnalyticsSearch&lt;TDocument&gt; (terms/cardinality/stats/date-histogram/range aggregations) and ICursorSearch&lt;TDocument&gt; (PIT + search_after deep pagination). Register via AddSharedKernelElasticSearchSearch(IConfiguration).</Description>
    <PackageTags>search;full-text-search;elasticsearch;analytics;shared-kernel</PackageTags>
    <!--
      CS8509/CS8524 are DELIBERATELY downgraded back to non-fatal warnings — never fully suppressed
      (NoWarn) and never masked with a discard (`_ =>`) arm — on the three closed-hierarchy switches
      this package owns (the SearchFilter translation switch and the SearchValueKind rendering switch
      in ElasticSearchFilterCompiler, and the AggregationRequest naming switch in
      ElasticSearchAnalytics&lt;TDocument&gt;.GetName). See 09.Search/CLAUDE.md, "Reconciling switch
      exhaustiveness with TreatWarningsAsErrors", for the full, empirically-verified reasoning: the C#
      compiler cannot perform closed-world exhaustiveness analysis over a sealed-subtype hierarchy or a
      fully-covered enum, so these two diagnostics fire unconditionally regardless of how completely the
      switch is written, and remain visible in every build log rather than being hidden.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS8509;CS8524</WarningsNotAsErrors>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Search.Abstractions\SharedKernel.Search.Abstractions.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
    <!--
      SIBLING-PACKAGE RULE: SharedKernel.Search.ElasticSearch must NEVER reference
      SharedKernel.Search.Meilisearch, directly or transitively. Shared implementation shape
      (options-validation flow, the SearchFilter walker skeleton, receipt mapping, probe sequencing)
      is duplicated deliberately across the two provider packages — see 09.Search/CLAUDE.md's
      "Provider role note".
    -->
  </ItemGroup>
  <ItemGroup>
    <!--
      ElasticSearch engine SDK. Apache-2.0, ships a real net10.0 target. NEST and Elasticsearch.Net
      are EOL and PROHIBITED (SK0025) — never referenced here or anywhere in the platform.
    -->
    <PackageReference Include="Elastic.Clients.Elasticsearch" />
    <!--
      Microsoft.Extensions.* set — required for DI extension (DependencyInjection.Abstractions),
      Options-pattern binding (Options), and [LoggerMessage] source-generated logging
      (Logging.Abstractions — not pulled in transitively by the ElasticSearch client or by
      SharedKernel.Configuration).
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Allows the nested test project to white-box test internal implementation details
      (ElasticSearchFilterCompiler, ElasticSearchRequestValidator, ElasticSearchProviderDescriptor,
      ElasticSearchRawClientAccessor) without expanding the public API surface — mirrors the
      06.Persistence.EfCore / 13.ServiceDefaults / 15.Integration.Webhooks precedent.
    -->
    <InternalsVisibleTo Include="SharedKernel.Search.ElasticSearch.Tests" />
  </ItemGroup>
</Project>
