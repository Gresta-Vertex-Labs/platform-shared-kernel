<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Not shipped — verification harness only -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Deliberately references BOTH provider packages — this project exists solely to demonstrate the
      P-07 "registering both providers against the same TDocument is a hard violation" scenario, which
      genuinely requires both compilation closures at once. It is NOT part of the P-06
      capability-segregation proof (that proof requires each provider referenced in ISOLATION — see
      consumer-verify.Meilisearch and consumer-verify.ElasticSearch instead).
    -->
    <ProjectReference Include="..\..\SharedKernel.Search.Abstractions\SharedKernel.Search.Abstractions.csproj" />
    <ProjectReference Include="..\..\SharedKernel.Search.Meilisearch\SharedKernel.Search.Meilisearch.csproj" />
    <ProjectReference Include="..\..\SharedKernel.Search.ElasticSearch\SharedKernel.Search.ElasticSearch.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>
