<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Not shipped — verification harness only -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      DELIBERATELY references ONLY SharedKernel.Search.Abstractions + SharedKernel.Search.Meilisearch
      — never SharedKernel.Search.ElasticSearch. This compilation closure is the P-06 build-time proof:
      IAnalyticsSearch<> and ICursorSearch<> (declared only in SharedKernel.Search.ElasticSearch) cannot
      be named from this project. See Program.cs's header comment for the verified negative-compile
      evidence (CS0246) recorded when that reference was deliberately and temporarily added.
    -->
    <ProjectReference Include="..\..\SharedKernel.Search.Abstractions\SharedKernel.Search.Abstractions.csproj" />
    <ProjectReference Include="..\..\SharedKernel.Search.Meilisearch\SharedKernel.Search.Meilisearch.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generic host — lets this harness exercise the real IHost.StartAsync() eager
         ValidateOnStart() path (P-07), not just BuildServiceProvider(). -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
  </ItemGroup>

</Project>
