<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NuGet packaging metadata -->
    <PackageId>SharedKernel.Search.Abstractions</PackageId>
    <!-- WO-055/P-354 (P-10): MINOR bump — new public SearchBulkWriteOptions type, additive only -->
    <Version>1.1.0</Version>
    <PackageVersion>1.1.0</PackageVersion>
    <Authors>Gresta-Vertex-Labs</Authors>
    <Company>Gresta-Vertex-Labs</Company>
    <Product>Platform.SharedKernel</Product>
    <Description>Full-text search abstraction contracts for Platform.SharedKernel microservices: ISearchIndex&lt;TDocument&gt; (index/delete/bulk/search/get/count/enumerate), ISearchIndexProvisioner (ensure/exists/delete/cutover/probe), ISearchProviderDescriptor (ceilings + zero-I/O pre-flight validation), IQueryBuilder&lt;TDocument&gt; over the closed 8-node SearchFilter AST and the closed five-kind SearchValue scalar union, plus the Result-valued SearchErrors factory. Zero third-party NuGet dependencies — references only SharedKernel.Primitives and SharedKernel.Contracts. Implemented by SharedKernel.Search.Meilisearch and SharedKernel.Search.ElasticSearch.</Description>
    <PackageTags>search;full-text-search;meilisearch;elasticsearch;shared-kernel</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</PackageProjectUrl>
    <Copyright>Copyright © 2026 Gresta-Vertex-Labs</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Zero third-party NuGet dependencies (the seam rule) — the only references are
      SharedKernel.Primitives (Result<T>/Result/Error) and SharedKernel.Contracts (PagedList<T>, for
      the guarded SearchResults<T>.ToPagedList() bridge only). No engine SDK, no
      Microsoft.Extensions.* package (not even DependencyInjection.Abstractions — no DI extension
      lives here), and no hashing package may ever be added here: System.Security.Cryptography
      (SHA-256 for SearchIndexDefinition.Fingerprint) and System.Text.Json are in-box on net10.0.
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\04.Contracts\SharedKernel.Contracts\SharedKernel.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude the nested test project from the main project's compilation -->
    <Compile Remove="SharedKernel.Search.Abstractions.Tests\**" />
    <EmbeddedResource Remove="SharedKernel.Search.Abstractions.Tests\**" />
    <None Remove="SharedKernel.Search.Abstractions.Tests\**" />
  </ItemGroup>

</Project>
