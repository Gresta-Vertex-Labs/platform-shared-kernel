<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Description>First shipping email provider for SharedKernel.Integration.Notifications.Abstractions — direct SendGrid v3 Mail Send REST API integration (no vendor SDK) via IHttpClientFactory + Microsoft.Extensions.Http.Resilience. Registers a keyed INotificationSender for NotificationChannel.Email via AddSendGridEmailNotifications(). Streams object-storage attachment content through a base64 transform, never materializing the full attachment as a byte[]. Propagates NotificationDeliveryId via SendGrid's custom_args field (correlation-only — SendGrid's API offers no request-level dedup guarantee).</Description>
    <PackageTags>shared-kernel;notifications;email;sendgrid;outbound-integration</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Layering boundary (15.Integration/CLAUDE.md, WO-072): this provider references only its own
      .Abstractions contract plus SharedKernel.Storage.Abstractions (attachment resolution) — never
      the sibling .Sms.Twilio package, and never SharedKernel.Integration.Webhooks. No vendor SDK
      (SendGrid NuGet package) is referenced — see the "why not the vendor SDK" rationale in
      15.Integration/CLAUDE.md's Technology Stack section.
    -->
    <ProjectReference Include="..\SharedKernel.Integration.Notifications.Abstractions\SharedKernel.Integration.Notifications.Abstractions.csproj" />
    <ProjectReference Include="..\..\08.Storage\SharedKernel.Storage.Abstractions\SharedKernel.Storage.Abstractions.csproj" />
    <!-- LoggingEventIdRanges.Integration (15000-15999 domain block, 15200-15299 sub-block) -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Outbound HTTP delivery (IHttpClientFactory) and Polly v8 standard resilience handler — the
      same already-pinned packages SharedKernel.Integration.Webhooks uses. No new
      Directory.Packages.props entry required.
    -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <!-- [LoggerMessage] source-generated logging (ILogger&lt;T&gt;, LogLevel, LoggerMessage attribute). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.Integration.Notifications.Email.SendGrid.Tests" />
  </ItemGroup>
</Project>
