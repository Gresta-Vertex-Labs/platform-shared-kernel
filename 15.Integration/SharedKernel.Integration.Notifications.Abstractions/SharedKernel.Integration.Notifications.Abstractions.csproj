<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Abstractions</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>Provider-neutral human-facing notification delivery contracts for SharedKernel microservices: NotificationChannel, NotificationMessage&lt;TTemplateModel&gt;, NotificationAttachment (an object-storage FileReference, never inline bytes), INotificationSender (keyed-DI resolved, no router type), NotificationDeliveryResult, the delivery-observation and per-tenant sender-identity seams (INotificationDeliveryObserver, INotificationSenderIdentityResolver) implemented by the consuming service, NotificationDeliveryOptions (shared across every provider package), and DI registration (AddSharedKernelNotifications/WithNotificationDeliveryObserver). Zero I/O, zero concrete sender — implemented by SharedKernel.Integration.Notifications.Email.SendGrid and .Sms.Twilio.</Description>
    <PackageTags>shared-kernel;notifications;email;sms;outbound-integration;abstractions</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Layering boundary (15.Integration/CLAUDE.md, WO-072): exactly these three ProjectReferences
      are permitted. SharedKernel.Primitives is referenced for future-proofing, mirroring
      SharedKernel.Integration.Webhooks' D-01 precedent. SharedKernel.Storage.Abstractions (08 < 15,
      an ordinary downward reference — no exception/grant needed) backs NotificationAttachment's
      FileReference handle; that package itself carries zero third-party NuGet dependency, so this
      reference introduces no transitive third-party surface. No reference to 06.Persistence,
      11.Communication.*, or SharedKernel.Messaging.MassTransit is permitted.
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
    <ProjectReference Include="..\..\08.Storage\SharedKernel.Storage.Abstractions\SharedKernel.Storage.Abstractions.csproj" />
  </ItemGroup>
</Project>
