<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Temporal workflow readiness health check for Platform.SharedKernel microservices: AddWorkflowReadinessCheck, probing IWorkflowServiceProbe. Registered on /health/ready only. Holds the WO-047 13-to-17 layering grant, which permits reaching IWorkflowServiceProbe and WorkflowServiceHealth and no other SharedKernel.Workflows.Temporal type. Split out of SharedKernel.ServiceDefaults (WO-084) so a service with no workflows does not restore Temporalio.</Description>
    <PackageTags>shared-kernel;service-defaults;health-checks;readiness;temporal;workflows</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Per-project: the SDK assigns false before the Directory.Build.targets default is evaluated. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.ServiceDefaults\SharedKernel.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\17.Workflows\SharedKernel.Workflows.Temporal\SharedKernel.Workflows.Temporal.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.ServiceDefaults.Workflows.Temporal.Tests" />
  </ItemGroup>
</Project>
