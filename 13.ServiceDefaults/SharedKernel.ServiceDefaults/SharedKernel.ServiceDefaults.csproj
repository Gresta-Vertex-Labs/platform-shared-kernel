<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NuGet packaging metadata -->
    <PackageId>SharedKernel.ServiceDefaults</PackageId>
    <Version>1.0.0</Version>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>Gresta-Vertex-Labs</Authors>
    <Company>Gresta-Vertex-Labs</Company>
    <Product>Platform.SharedKernel</Product>
    <Description>Host composition layer for Platform.SharedKernel microservices: AddServiceDefaults (OpenTelemetry + health check wiring), liveness/readiness health check endpoint mappings, StartupGate, and opt-in dependency-specific health check adapters (database, Redis, messaging).</Description>
    <PackageTags>shared-kernel;service-defaults;opentelemetry;health-checks;kubernetes;observability</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Gresta-Vertex-Labs/platform-shared-kernel</PackageProjectUrl>
    <Copyright>Copyright © 2026 Gresta-Vertex-Labs</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      NU5104: a stable package release must not depend on a prerelease package. This package
      depends on OpenTelemetry.Instrumentation.EntityFrameworkCore, which as of this writing has
      never shipped a stable (non-beta) release upstream — there is no stable version to pin to.
      Suppressed at pack time only; re-evaluate and remove this suppression once OpenTelemetry
      ships a stable EFCore instrumentation release.
    -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\02.Caching\SharedKernel.Caching.Abstractions\SharedKernel.Caching.Abstractions.csproj" />
    <ProjectReference Include="..\..\06.Persistence\SharedKernel.Persistence.Abstractions\SharedKernel.Persistence.Abstractions.csproj" />
    <ProjectReference Include="..\..\06.Persistence\SharedKernel.Persistence.EfCore\SharedKernel.Persistence.EfCore.csproj" />
    <ProjectReference Include="..\..\07.Messaging\SharedKernel.Messaging.Abstractions\SharedKernel.Messaging.Abstractions.csproj" />
    <ProjectReference Include="..\..\07.Messaging\SharedKernel.Messaging.MassTransit\SharedKernel.Messaging.MassTransit.csproj" />
    <ProjectReference Include="..\..\08.Storage\SharedKernel.Storage.Abstractions\SharedKernel.Storage.Abstractions.csproj" />
    <ProjectReference Include="..\..\09.Search\SharedKernel.Search.Abstractions\SharedKernel.Search.Abstractions.csproj" />
    <ProjectReference Include="..\..\10.Intelligence\SharedKernel.AI.Abstractions\SharedKernel.AI.Abstractions.csproj" />
    <!--
      WO-047 layering exception: this is the ONLY 17.Workflows reference permitted anywhere in
      13.ServiceDefaults, and it exists solely so AddWorkflowReadinessCheck (Core phase, C-42) can
      resolve IWorkflowServiceProbe/WorkflowServiceHealth. No other SharedKernel.Workflows.Temporal
      type (TemporalOptions, ITemporalClient, WorkflowBase/ActivityBase, IWorkflowDispatcher,
      ITemporalRawClientAccessor, ...) may be referenced through this ProjectReference — see root
      CLAUDE.md's Layering Rules -> Hard rules for the ratified grant.
    -->
    <ProjectReference Include="..\..\17.Workflows\SharedKernel.Workflows.Temporal\SharedKernel.Workflows.Temporal.csproj" />
    <!--
      WO-058/P-378: referenced solely so AddMtlsClientCertificate/AddMtlsForwardedHeaderCertificate
      (Core phase, C-48) can resolve SharedKernel.Security.Mtls.Validation.IMtlsCertificateValidator.
      12.Security is already inside this domain's granted 01-12 composition-root range, so unlike
      the 17.Workflows reference above, no separate named layering exception is required.
      13.ServiceDefaults never reimplements X.509 chain/revocation validation itself.
    -->
    <ProjectReference Include="..\..\12.Security\SharedKernel.Security.Mtls\SharedKernel.Security.Mtls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.11.0-beta.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <!--
      OpenTelemetry.Instrumentation.GrpcNetClient 1.15.1-beta.1: gRPC client OTel instrumentation,
      activated by WithCommunicationTelemetry() (S-18/C-47, WO-056/P-365) — never by
      AddSharedKernelTelemetry()'s base wiring. Still in beta but the only available net10.0-
      compatible version of this package today; version-aligned with
      11.Communication.Grpc/SharedKernel.Communication.Grpc.csproj's existing pin so the two
      packages never silently diverge onto different beta builds within a single consuming
      service's dependency graph. Contributes no new NU5104 exposure beyond what this project's
      NoWarn suppression above (added for OpenTelemetry.Instrumentation.EntityFrameworkCore) already
      covers. No PackageReference is needed for Polly's own "Polly"-named Meter — reached by bare
      string name only (AddMeter("Polly")), requiring no compile-time dependency. NOTE: this
      comment originally also named an AddSource("Polly") ActivitySource; C-47 later established by
      decompiling the actually-installed assemblies that Polly 8.4.2 (the version pinned
      transitively by Microsoft.Extensions.Http.Resilience 10.7.0) creates a "Polly" Meter but no
      ActivitySource anywhere, so WithCommunicationTelemetry() wires the meter only — corrected here
      so the two do not drift.
    -->
    <PackageReference Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.15.1-beta.1" />
    <!--
      Microsoft.Extensions.Diagnostics.HealthChecks and Microsoft.Extensions.Hosting are NOT
      referenced as explicit PackageReferences — both ship as part of the
      Microsoft.AspNetCore.App shared framework (see FrameworkReference above), and NuGet's
      asset-pruning (NU1510) flags an explicit reference to an already-framework-provided
      package as redundant. Removing them avoids a build error under TreatWarningsAsErrors.
    -->
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.41" />
    <!--
      Azure.Extensions.AspNetCore.Configuration.Secrets / Azure.Identity: required so
      AddSharedKernelKeyVaultConfiguration (Core phase, C-56, WO-061/P-398) can call
      builder.Configuration.AddAzureKeyVault(vaultUri, credential ?? new DefaultAzureCredential()).
      Deliberate re-addition, not a silent restore: S-17/WO-054/P-351 previously removed
      Azure.Identity 1.21.0 as a dead transitive dependency of the retired
      AzureServiceBusHealthCheck. This is an unrelated, independently-justified reference for an
      opt-in secrets-manager configuration source — entirely additive to this package's own
      dependency graph; AddServiceDefaults() itself gains no new mandatory dependency, since
      AddSharedKernelKeyVaultConfiguration is never called from it. Floor versions confirmed
      against the live NuGet feed at implementation time (2026-08-19), not carried forward from any
      stale prior pin: Azure.Extensions.AspNetCore.Configuration.Secrets's latest stable is 1.5.2;
      Azure.Identity's latest stable is 1.21.0 (unchanged from the version S-17 removed).
    -->
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude the nested test project from the main project's compilation -->
    <Compile Remove="SharedKernel.ServiceDefaults.Tests\**" />
    <EmbeddedResource Remove="SharedKernel.ServiceDefaults.Tests\**" />
    <None Remove="SharedKernel.ServiceDefaults.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.ServiceDefaults.Tests" />
  </ItemGroup>

</Project>
