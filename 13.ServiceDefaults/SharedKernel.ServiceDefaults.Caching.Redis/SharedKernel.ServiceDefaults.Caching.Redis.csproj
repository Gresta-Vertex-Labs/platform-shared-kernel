<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Redis connectivity health check for Platform.SharedKernel microservices: AddRedisHealthCheck(connectionString), built on AspNetCore.HealthChecks.Redis. Registered on /health/ready only. Kept apart from SharedKernel.ServiceDefaults.Caching because it alone brings StackExchange.Redis, which a service using only an in-memory cache must not restore. Split out of SharedKernel.ServiceDefaults (WO-084).</Description>
    <PackageTags>shared-kernel;service-defaults;health-checks;readiness;redis</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Per-project: the SDK assigns false before the Directory.Build.targets default is evaluated. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.ServiceDefaults\SharedKernel.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.ServiceDefaults.Caching.Redis.Tests" />
  </ItemGroup>
</Project>
