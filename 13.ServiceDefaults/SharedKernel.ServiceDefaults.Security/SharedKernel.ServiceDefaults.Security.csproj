<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Host</SharedKernelTier>
    <Description>The HTTP request context for Platform.SharedKernel microservices: AddSharedKernelRequestContext() registers an IRequestContext (SharedKernel.Execution) over 12.Security's IUserContext, and UseSharedKernelRequestContext() resolves the request's X-Correlation-Id and runs the request inside a RequestContextScope, so the authorization behavior, persistence audit columns, tenant filters, the audit trail and every outbound REST, gRPC, message and workflow call read the same caller, tenant and correlation id.</Description>
    <PackageTags>shared-kernel;service-defaults;security;request-context;correlation-id;identity;multi-tenancy</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Per-project: the SDK assigns false before the Directory.Build.targets default is evaluated. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- HttpContext and the middleware pipeline (UseSharedKernelRequestContext). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!--
      WO-084 integration package: the base plus exactly what this integration needs — 12.Security's
      identity contracts and the shared IRequestContext. Never another integration package.
    -->
    <ProjectReference Include="..\SharedKernel.ServiceDefaults\SharedKernel.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\12.Security\SharedKernel.Security.Abstractions\SharedKernel.Security.Abstractions.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Execution\SharedKernel.Execution.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.ServiceDefaults.Security.Tests" />
  </ItemGroup>
</Project>
