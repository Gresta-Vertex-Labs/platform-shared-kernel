<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Host</SharedKernelTier>
    <Description>Scheduler readiness health check for Platform.SharedKernel microservices: AddSchedulerReadinessCheck, probing ISchedulerServiceProbe. Registered on /health/ready only. Holds the P-466 13-to-19 layering grant, which permits reaching ISchedulerServiceProbe and SchedulerServiceHealth and no other SharedKernel.Scheduling type. Split out of SharedKernel.ServiceDefaults (WO-084) so a service with no scheduled jobs does not restore Quartz.</Description>
    <PackageTags>shared-kernel;service-defaults;health-checks;readiness;scheduling</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Per-project: the SDK assigns false before the Directory.Build.targets default is evaluated. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.ServiceDefaults\SharedKernel.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\19.Scheduling\SharedKernel.Scheduling\SharedKernel.Scheduling.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.ServiceDefaults.Scheduling.Tests" />
  </ItemGroup>
</Project>
