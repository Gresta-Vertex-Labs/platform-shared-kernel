<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Database readiness health checks for Platform.SharedKernel microservices: AddDatabaseReadinessCheck&lt;TContext&gt; for EF Core (via SharedKernel.Persistence.EfCore) and AddDapperDatabaseReadinessCheck for connection-factory based access (via SharedKernel.Persistence.Abstractions). Registered on /health/ready only, never /health/live. Split out of SharedKernel.ServiceDefaults (WO-084) so a service without a database does not restore the persistence stack.</Description>
    <PackageTags>shared-kernel;service-defaults;health-checks;readiness;persistence;efcore;dapper</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Per-project: the SDK assigns false before the Directory.Build.targets default is evaluated. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.ServiceDefaults\SharedKernel.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\06.Persistence\SharedKernel.Persistence.Abstractions\SharedKernel.Persistence.Abstractions.csproj" />
    <ProjectReference Include="..\..\06.Persistence\SharedKernel.Persistence.EfCore\SharedKernel.Persistence.EfCore.csproj" />
    <!--
      P-557/W1: this package now also hosts the IUserContext/ITenantProvider -> ICurrentActorContext
      bridge (06.Persistence's local seam) and the 05.Application.Behaviors.Transaction.IUnitOfWork
      adapter that used to live inside SharedKernel.Persistence.EfCore itself. Legal under existing
      layering rules — 13.ServiceDefaults may reference 01-12 through its integration packages.
    -->
    <ProjectReference Include="..\..\12.Security\SharedKernel.Security.Abstractions\SharedKernel.Security.Abstractions.csproj" />
    <ProjectReference Include="..\..\05.Application\SharedKernel.Application.Behaviors\SharedKernel.Application.Behaviors.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.ServiceDefaults.Persistence.Tests" />
  </ItemGroup>
</Project>
