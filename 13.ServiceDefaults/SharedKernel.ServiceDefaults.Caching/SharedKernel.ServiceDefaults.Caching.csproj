<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Cache readiness health check for Platform.SharedKernel microservices: AddCacheReadinessCheck, probing the registered SharedKernel.Caching.Abstractions ICacheService. Registered on /health/ready only. Carries no Redis client; for a Redis connectivity check add SharedKernel.ServiceDefaults.Caching.Redis. Split out of SharedKernel.ServiceDefaults (WO-084).</Description>
    <PackageTags>shared-kernel;service-defaults;health-checks;readiness;caching</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Per-project: the SDK assigns false before the Directory.Build.targets default is evaluated. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.ServiceDefaults\SharedKernel.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\02.Caching\SharedKernel.Caching.Abstractions\SharedKernel.Caching.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.ServiceDefaults.Caching.Tests" />
  </ItemGroup>
</Project>
