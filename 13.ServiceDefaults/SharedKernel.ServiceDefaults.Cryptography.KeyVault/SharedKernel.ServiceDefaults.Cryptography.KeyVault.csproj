<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Azure Key Vault encryption-key-provider composition for Platform.SharedKernel microservices: AddSharedKernelKeyVaultKeyProvider registers SharedKernel.Cryptography.KeyVault.Azure as the IEncryptionKeyProvider, and AddKeyVaultKeyProviderReadinessCheck probes vault reachability with a cheap, non-cryptographic metadata read. Distinct from SharedKernel.ServiceDefaults.Configuration.KeyVault, which uses Key Vault as a configuration source. Split out of SharedKernel.ServiceDefaults (WO-084).</Description>
    <PackageTags>shared-kernel;service-defaults;azure-key-vault;kms;encryption;health-checks</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Per-project: the SDK assigns false before the Directory.Build.targets default is evaluated. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.ServiceDefaults\SharedKernel.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Cryptography.KeyVault.Azure\SharedKernel.Cryptography.KeyVault.Azure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.ServiceDefaults.Cryptography.KeyVault.Tests" />
  </ItemGroup>
</Project>
