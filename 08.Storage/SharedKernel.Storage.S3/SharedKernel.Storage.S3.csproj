<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Description>AWS S3 / MinIO implementation of SharedKernel.Storage.Abstractions: S3FileStorage (TransferUtility-backed streaming upload, server-side copy, chunked batch delete, streaming list, connectivity probe) and S3BlobUriGenerator (presigned upload/download URLs). MinIO is served through the same code path via ServiceUrl + ForcePathStyle configuration — no separate package needed. Register via AddSharedKernelS3Storage(IConfiguration).</Description>
    <PackageTags>storage;blob;s3;aws;minio;object-storage;shared-kernel</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Storage.Abstractions\SharedKernel.Storage.Abstractions.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      AWS S3 / MinIO client SDK. Pinned 4.0.101.1 (latest stable on nuget.org at implementation
      time) — also the version SharedKernel.Storage.Obs pins, since both packages sit on the same
      S3-compatible SDK surface but never reference each other (sibling-package rule).
    -->
    <PackageReference Include="AWSSDK.S3" />
    <!-- [LoggerMessage] source-generated logging (ILogger<T>, LogLevel, LoggerMessage attribute). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
