<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Description>Huawei Cloud OBS for SharedKernel.Storage.Abstractions, over OBS's S3-compatible API and the SharedKernel.Storage.S3 implementation. Adds OBS endpoint, region and AK/SK configuration and a compatibility profile verified against a live OBS region: conditional writes and SHA-256 checksums, which OBS silently ignores, are refused with storage.not_supported instead of overwriting data or storing unchecked bytes, and downloads of encrypted objects work despite OBS ETags that are not content MD5s. Register with AddSharedKernelStorage().AddObs(configuration).AddStore("name").</Description>
    <PackageReleaseNotes>First release.</PackageReleaseNotes>
    <PackageTags>shared-kernel;storage;object-storage;obs;huawei-cloud;s3-compatible</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API tracking: an addition, removal or signature change fails the build until PublicAPI.*.txt is updated. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!--
      OBS is served by the S3 implementation (its S3-compatible API, through AWSSDK.S3). This package adds
      only OBS configuration and its compatibility profile; the native Huawei SDK was rejected (stale,
      .NET Standard 2.0, maintained from a personal account).
    -->
    <ProjectReference Include="..\SharedKernel.Storage.S3\SharedKernel.Storage.S3.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.Storage.Obs.Tests" />
  </ItemGroup>
</Project>
