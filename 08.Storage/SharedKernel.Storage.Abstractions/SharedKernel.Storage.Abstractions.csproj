<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Abstractions</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>Provider-neutral object-storage contracts for .NET services. Application code injects a named store (IFileStorage, resolved by name) or a tenant store (ITenantFileStorage.ForTenant) whose keys can never leave the tenant's prefix, and gets streaming upload and download, byte ranges, create-only and ETag-conditional writes, SHA-256 verification, server-side copy between stores, batch delete, folder listing with paging, presigned download and upload URLs, presigned browser forms with size and content-type limits, and presigned multipart uploads. Every request is validated before it is sent, and expected failures are Result values with stable storage.* error codes instead of exceptions. No cloud SDK dependency; providers: SharedKernel.Storage.S3 and SharedKernel.Storage.Obs.</Description>
    <PackageReleaseNotes>First release.</PackageReleaseNotes>
    <PackageTags>shared-kernel;storage;object-storage;blob;s3;presigned-url;multi-tenancy;abstractions</PackageTags>
    <!--
      Set per-project, not inherited: the SDK assigns GenerateDocumentationFile=false before
      Directory.Build.targets' '== empty'-guarded default is evaluated. CS1591 below makes an
      undocumented public member a build error.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API tracking: an addition, removal or signature change fails the build until PublicAPI.*.txt is updated. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
    <!-- RS0026/RS0027: optional options + CancellationToken parameters on several members, the .NET convention. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Result<T>/Error. No cloud SDK, no SharedKernel.Configuration (StorageTopologyRules). -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Execution\SharedKernel.Execution.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- IStorageBuilder exposes IServiceCollection so provider packages can register named stores. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.Storage.Abstractions.Tests" />
  </ItemGroup>
</Project>
