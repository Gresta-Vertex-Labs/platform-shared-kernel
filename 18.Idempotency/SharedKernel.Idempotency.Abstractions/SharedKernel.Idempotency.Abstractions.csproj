<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Abstractions</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>One reservation contract for every idempotency guard in a SharedKernel service: IIdempotencyStore reserves a key atomically, reports whether it is new, in flight, completed (with the stored response to replay) or reused for a different request, and completes or releases it only for the caller that holds the reservation. The same contract serves in-process commands (IdempotencyPurpose.Request) and message consumers (IdempotencyPurpose.Message); stores are registered keyed by purpose, so each purpose can use a different backend. Keys are scoped by the tenant of the ambient request context. No Redis, EF Core or messaging dependency.</Description>
    <PackageReleaseNotes>First release. Replaces SharedKernel.Application.Pipeline's IRequestIdempotencyStore and SharedKernel.Messaging.Abstractions' IIdempotencyStore.</PackageReleaseNotes>
    <PackageTags>shared-kernel;idempotency;deduplication;abstractions</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keyed registration helpers (AddIdempotencyStore, HasIdempotencyStore). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- IRequestContextAccessor and TenantId: the tenant every key is scoped by. -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Execution\SharedKernel.Execution.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
