<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Adapter</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>Durable Temporal workflow orchestration for Platform.SharedKernel microservices: IWorkflowDispatcher/IWorkflowHandle/IWorkflowHandle&lt;TResult&gt;/IWorkflowIdFactory (tenant-scoped durable dispatch), WorkflowBase/ActivityBase/CommandActivity&lt;TCommand&gt; (deterministic workflow authoring plus the sole 05.Application ISender bridge), ITemporalWorkflowsBuilder (worker hosting), Result&lt;T&gt;-to-Temporal-failure mapping, AES-256-GCM payload encryption, tenant/correlation header propagation, and a readiness-probe primitive — all over the official Temporalio .NET SDK. A deliberate single package: no SharedKernel.Workflows.Abstractions split exists, because durable execution's determinism/replay/versioning programming model IS the abstraction.</Description>
    <PackageTags>workflows;temporal;durable-execution;orchestration;shared-kernel</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Execution\SharedKernel.Execution.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Cryptography\SharedKernel.Cryptography.csproj" />
    <!--
      SharedKernel.Application is the SOLE justification for this reference — it exists only so
      CommandActivity<TCommand>/CommandActivity<TCommand,TResult> can resolve the kernel ISender (SharedKernel.Application) and
      constrain against ICommand/ICommand<TResponse>. If CommandActivity<> is ever dropped, this
      reference must be dropped with it (17.Workflows/CLAUDE.md, S-02).

      NO SharedKernel.Contracts (04.Contracts) reference: the recommended contract-shaped workflow
      argument/result shape is a documentation recommendation to CONSUMERS, not something any type
      shipped by this package needs on its own signature — adding it would be a dead reference of the
      exact kind 11.Communication.Grpc removed under P-163 (S-02).
    -->
    <ProjectReference Include="..\..\05.Application\SharedKernel.Application\SharedKernel.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Temporalio SDK family — verified against nuget.org 2026-07-23: 1.17.0 is latest stable
      (published 2026-07-13, MIT, "temporalio" org). All four packages pinned to the SAME version
      (17.Workflows/CLAUDE.md, D-02/S-05).
    -->
    <PackageReference Include="Temporalio" />
    <PackageReference Include="Temporalio.Extensions.Hosting" />
    <PackageReference Include="Temporalio.Extensions.OpenTelemetry" />
    <PackageReference Include="Temporalio.Extensions.DiagnosticSource" />
    <!--
      Microsoft.Extensions.* set — pinned to 10.0.9, matching the version already pinned by the most
      recently implemented sibling capability packages (09.Search, 10.Intelligence), re-verified on
      disk rather than floated to nuget.org's newest (S-01).
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Allows the nested test project to white-box test internal implementation details
      (WorkflowFailureMapper, WorkflowPropagationInterceptor, EncryptionPayloadCodec) without
      expanding the public API surface — mirrors the 06.Persistence.EfCore / 13.ServiceDefaults /
      15.Integration.Webhooks / 09.Search precedent (S-04).
    -->
    <InternalsVisibleTo Include="SharedKernel.Workflows.Temporal.Tests" />
    <!--
      P-08/WO-081: a second, deliberately narrow grant to the Published-phase consumer-verify harness
      — NOT a general relaxation of the internal-type boundary an ordinary downstream consumer has.
      Surface 5 needs direct access to EncryptionPayloadCodec to prove the AAD cross-WorkflowId
      rejection against REAL captured Temporal history bytes (not a synthetic Payload, as the unit
      tests use) — a proof no black-box IWorkflowDispatcher-only consumer could ever construct,
      precisely because the SDK always resolves the correct WorkflowId context for whichever
      execution it is decoding. consumer-verify remains "not shipped, verification harness only"
      (see its own csproj) — this grant exists solely to verify an internal guarantee end to end,
      never to demonstrate a capability a real consumer is meant to have.
    -->
    <InternalsVisibleTo Include="consumer-verify" />
  </ItemGroup>
</Project>
