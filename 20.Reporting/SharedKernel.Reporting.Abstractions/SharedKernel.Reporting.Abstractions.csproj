<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Description>Streaming, memory-bounded report/data export contracts for Platform.SharedKernel microservices: IReportExporter&lt;TRow&gt; (IAsyncEnumerable&lt;TRow&gt;-only, storage-delivered + direct-stream convenience), the ReportColumn/ReportDefinition/ReportDestination/ReportExportOutcome model, the culture-aware ReportValueFormatting default formatter, and StorageStreamingWriter — the Pipe-based delivery primitive that streams encoded bytes to IFileStorage as they are produced. Zero third-party NuGet dependencies — references only SharedKernel.Primitives and SharedKernel.Storage.Abstractions. Implemented by SharedKernel.Reporting.Csv, .Spreadsheet, and .Pdf.</Description>
    <PackageTags>reporting;export;csv;streaming;shared-kernel</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Layering (20.Reporting/CLAUDE.md): this domain may reference only 01.Core and
      SharedKernel.Storage.Abstractions. SharedKernel.Configuration supplies AddValidatedOptions,
      used by StorageStreamingWriter's own optional wiring today and by every provider package.
      Any format-library type (ClosedXML.*/PdfSharp.*/MigraDoc.*) referenced from this project is a
      hard violation — stop and flag it, never add one here.
    -->
    <ProjectReference Include="..\..\01.Core\SharedKernel.Primitives\SharedKernel.Primitives.csproj" />
    <ProjectReference Include="..\..\08.Storage\SharedKernel.Storage.Abstractions\SharedKernel.Storage.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Microsoft.Extensions.Logging.Abstractions is the platform's standard first-party framework
      package, not a "format-library"/third-party vendor dependency — the same treatment
      SharedKernel.Caching.Abstractions and SharedKernel.Messaging.Abstractions already give
      Microsoft.Extensions.DependencyInjection.Abstractions. ILogger&lt;T&gt; backs
      StorageStreamingWriter's [LoggerMessage] entries (D-11) — the only reason this project takes
      any PackageReference at all.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
