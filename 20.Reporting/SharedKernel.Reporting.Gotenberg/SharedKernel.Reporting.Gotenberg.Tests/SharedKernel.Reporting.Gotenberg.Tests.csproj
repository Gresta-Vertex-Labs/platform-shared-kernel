<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Integration lane: the converter against a stub HTTP handler (every form field and error mapping) and against a real
    Gotenberg container (Testcontainers; Docker required).
  -->
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel.Reporting.Gotenberg.csproj" />
    <ProjectReference Include="..\..\..\16.Testing\SharedKernel.Storage.Testing\SharedKernel.Storage.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Testcontainers" />
    <!-- An independent reader: every PDF Gotenberg returns is opened back with PDFsharp. -->
    <PackageReference Include="PDFsharp" />
  </ItemGroup>
</Project>
