<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SharedKernelTier>Adapter</SharedKernelTier>
    <!-- NuGet packaging metadata -->
    <Description>HTML-to-PDF for SharedKernel.Reporting through Gotenberg (MIT), a stateless Docker service that renders with headless Chromium. IHtmlToPdfConverter sends an HTML string — with optional header, footer and assets — and streams the PDF to object storage or any stream; full CSS, web fonts and page-number footers. Chromium runs in its own container, so the service image stays small and a browser exploit cannot reach it. Retries and timeouts through Microsoft.Extensions.Http.Resilience, the correlation id as Gotenberg-Trace, optional basic authentication, and a "gotenberg" readiness probe. Register with services.AddSharedKernelReporting().AddGotenberg(configuration). No vendor SDK.</Description>
    <PackageReleaseNotes>First release.</PackageReleaseNotes>
    <PackageTags>shared-kernel;reporting;pdf;html-to-pdf;gotenberg;chromium</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Publish bar: ship XML docs, and fail the build on an undocumented or untracked public member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;RS0016;RS0017;RS0024;RS0025</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Never references .Csv, .Spreadsheet or .Pdf: sibling providers stay independent. -->
    <ProjectReference Include="..\SharedKernel.Reporting.Abstractions\SharedKernel.Reporting.Abstractions.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Execution\SharedKernel.Execution.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.Reporting.Gotenberg.Tests" />
  </ItemGroup>
</Project>
