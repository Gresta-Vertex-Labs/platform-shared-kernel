<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet packaging metadata -->
    <Description>PdfSharp/MigraDoc-backed PDF report/data export for Platform.SharedKernel microservices, scoped to simple tabular/statement layouts only (no multi-section documents, images, charts, or headers/footers beyond one optional title). PdfReportExporter&lt;TRow&gt; builds a single MigraDoc table row-by-row from the streamed IAsyncEnumerable&lt;TRow&gt; source and renders it via PdfDocumentRenderer; MigraDoc's own table renderer paginates automatically across page breaks. IMPORTANT: MigraDoc/PdfSharp materialize the full document object model in memory before rendering — this provider is NOT memory-bounded, mitigated by its deliberately narrow scope rather than by any streaming capability (see this package's README). Register via AddPdfReportExporter&lt;TRow&gt;(IConfiguration).</Description>
    <PackageTags>reporting;export;pdf;pdfsharp;migradoc;shared-kernel</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Sibling-package rule (20.Reporting/CLAUDE.md): never references .Csv or .Spreadsheet. -->
    <ProjectReference Include="..\SharedKernel.Reporting.Abstractions\SharedKernel.Reporting.Abstractions.csproj" />
    <ProjectReference Include="..\..\01.Core\SharedKernel.Configuration\SharedKernel.Configuration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Unconditional MIT — ratified in 20.Reporting/CLAUDE.md's licensing table. "PDFsharp-MigraDoc"
      is the current, actively-maintained bundle of the MigraDoc.DocumentObjectModel/
      MigraDoc.Rendering namespaces (the original Design phase named those as separate package IDs
      that no longer exist on nuget.org — verified directly, see Directory.Packages.props comment);
      it depends on the separate "PDFsharp" core package at the identical pinned version, so both
      are pinned explicitly rather than letting PDFsharp ride in transitively unpinned.
    -->
    <PackageReference Include="PDFsharp" />
    <PackageReference Include="PDFsharp-MigraDoc" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Embedded so PDF rendering never depends on the host OS having any particular font installed —
      PdfSharp 6.x performs no implicit OS font enumeration on any platform (see
      Fonts/EmbeddedRobotoFontResolver.cs). Roboto is Apache License 2.0 (Fonts/LICENSE.txt),
      permissive and redistribution-friendly, compatible with this MIT-licensed package.
    -->
    <EmbeddedResource Include="Fonts\Roboto-Regular.ttf" />
    <EmbeddedResource Include="Fonts\Roboto-Bold.ttf" />
    <None Include="Fonts\LICENSE.txt" Pack="true" PackagePath="Fonts\" />
  </ItemGroup>
</Project>
