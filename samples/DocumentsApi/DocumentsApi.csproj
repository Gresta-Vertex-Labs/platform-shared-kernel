<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <!-- Sample code is held to the same bar as shipped code. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Deliberately PackageReference, not ProjectReference: this service proves the *packed* storage packages work
    for an outside consumer. Excluded from Platform.SharedKernel.slnx and built after `dotnet pack`
    (see samples/README.md).
  -->
  <ItemGroup>
    <!-- 08.Storage: two S3 connections (different IAM users) and one OBS connection -->
    <PackageReference Include="SharedKernel.Storage.S3" />
    <PackageReference Include="SharedKernel.Storage.Obs" />
    <!-- 13.ServiceDefaults: host, storage telemetry, and AddSharedKernelReadiness (one probe per store) -->
    <PackageReference Include="SharedKernel.ServiceDefaults" />
    <!-- 13.ServiceDefaults.Security: UseSharedKernelRequestContext() - the request context and its X-Correlation-Id -->
    <PackageReference Include="SharedKernel.ServiceDefaults.Security" />
    <!-- 05.Application: the endpoints send commands and queries through the kernel ISender; the pipeline and its
         MediatR adapter are Host packages -->
    <PackageReference Include="SharedKernel.Application.Pipeline" />
    <PackageReference Include="SharedKernel.Application.Mediator.MediatR" />
    <!-- 14.Presentation: Result -> ProblemDetails -->
    <PackageReference Include="SharedKernel.Presentation.WebApi" />
  </ItemGroup>

</Project>
