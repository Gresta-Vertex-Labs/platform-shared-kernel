{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SharedKernel": {
    "Storage": {
      "S3": {
        "Public": { "Region": "eu-central-1" },
        "Private": { "Region": "eu-central-1" }
      },
      "Obs": { "Endpoint": "https://obs.tr-west-1.myhuaweicloud.com" },
      "Stores": {
        "assets": { "Bucket": "replace-me-assets", "KeyPrefix": "sharedkernel-samples/assets/" },
        "documents": { "Bucket": "replace-me-documents", "KeyPrefix": "sharedkernel-samples/documents/", "Encryption": "S3Managed", "MaxPresignExpiry": "00:15:00" },
        "archive": { "Bucket": "replace-me-archive", "KeyPrefix": "sharedkernel-samples/archive/" }
      }
    },
    "Reporting": {
      "Gotenberg": { "BaseUrl": "http://localhost:3000" }
    }
  }
}
