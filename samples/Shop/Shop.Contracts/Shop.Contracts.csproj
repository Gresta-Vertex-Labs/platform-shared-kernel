<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The contracts between Shop services: the gRPC services (server bases and clients generated from Protos/) and the
    integration events. A service references this project, never another service's projects.
  -->
  <ItemGroup>
    <Protobuf Include="Protos\*.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharedKernel.Contracts" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>
</Project>
