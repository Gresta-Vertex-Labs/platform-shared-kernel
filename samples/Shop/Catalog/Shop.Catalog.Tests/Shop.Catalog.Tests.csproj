    rules on the Catalog's assemblies, and the use cases through the real kernel pipeline over the kernel's fakes.
    Infrastructure behaviour against the real engines is Shop.E2E's job.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Shop.Catalog.Api\Shop.Catalog.Api.csproj" />
    <ProjectReference Include="..\..\Shop.TestSupport\Shop.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharedKernel.Testing" />
    <PackageReference Include="SharedKernel.Application.Testing" />
    <PackageReference Include="SharedKernel.Persistence.Testing" />
    <PackageReference Include="SharedKernel.Caching.Testing" />
    <PackageReference Include="SharedKernel.Search.Testing" />
    <PackageReference Include="SharedKernel.AI.Testing" />
    <PackageReference Include="SharedKernel.Storage.Testing" />
    <PackageReference Include="SharedKernel.FeatureManagement.Testing" />
    <PackageReference Include="SharedKernel.ArchitectureTests" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
