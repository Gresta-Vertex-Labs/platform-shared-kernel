{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Connection strings, endpoints and keys come from the AppHost as environment variables
  // (ConnectionStrings__catalog, SharedKernel__Caching__Redis__ConnectionString, Search__Meilisearch__Url, ...).
  "SharedKernel": {
    "Caching": { "ServiceName": "catalog" },
    "Security": {
      "Oidc": {
        "Audiences": [ "shop-api" ],
        "Claims": { "PermissionClaimTypes": [ "permissions" ] }
      }
    }
  },

  // Tenant groups: Contoso (6c1d7e1a-…) sees the new-arrival badge, Fabrikam does not.
  "feature_management": {
    "feature_flags": [
      {
        "id": "NewArrivalBadge",
        "enabled": true,
        "conditions": {
          "client_filters": [
            {
              "name": "Microsoft.Targeting",
              "parameters": {
                "Audience": {
                  "Groups": [ { "Name": "6c1d7e1a-3b52-4f8e-9a41-2f6b8c0d9e11", "RolloutPercentage": 100 } ],
                  "DefaultRolloutPercentage": 0
                }
              }
            }
          ]
        }
      }
    ]
  }
}
