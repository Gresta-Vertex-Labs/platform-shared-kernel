{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
  },
  "AllowedHosts": "*",

  // Connections, keys, the Temporal and RabbitMQ endpoints and the Inventory client come from the AppHost.
  "SharedKernel": {
    "Security": {
      "Oidc": {
        "Audiences": [ "shop-api" ],
        "Claims": { "PermissionClaimTypes": [ "permissions" ] }
      }
    },
    "MultiTenancy": { "StrategyOrder": [ "Claim" ] },
    "Messaging": { "ServiceName": "ordering" },
    "Persistence": {
      "audit-sealer": { "ConnectionStringName": "audit-sealer" },
      "Auditing": {
        "CurrentKeyId": "k1",
        "Sealer": { "DataSourceName": "audit-sealer", "Interval": "00:00:02" },
        "SelfCheck": "Fail"
      }
    }
  },
  "Workflows": { "Temporal": { "Namespace": "default" } }
}
