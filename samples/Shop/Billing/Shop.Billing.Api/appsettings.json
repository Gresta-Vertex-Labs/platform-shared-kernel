{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
  },
  "AllowedHosts": "*",

  // Connections, the vault address and the merchants' webhook URLs come from the AppHost; secrets from Key Vault.
  "SharedKernel": {
    "Security": {
      "Oidc": {
        "Audiences": [ "shop-api" ],
        "Claims": { "PermissionClaimTypes": [ "permissions" ] }
      }
    },
    // A signed claim (a merchant's token, or a key bound to a tenant) first; the X-Tenant-Id header only from a key.
    "MultiTenancy": { "StrategyOrder": [ "Claim", "ServiceHeader" ] },
    "Cryptography": {
      "KeyVault": {
        "Azure": {
          "Signing": { "Keys": { "invoices": { "KeyName": "invoice-signing", "Algorithm": "PS256" } } },
          "Encryption": { "MasterKeyName": "billing-master", "DataKeySecretName": "billing-data-key" }
        }
      }
    },
    "Integration": { "Webhooks": { "MaxAttempts": 3 } },
    "Messaging": { "ServiceName": "billing" }
  },
  "Billing": {
    "InvoiceSigningKeyId": "invoices",
    // Who each API key is; its hash is the Key Vault secret Billing--ApiKeys--{keyId}--Hash.
    "ApiKeys": {
      "X7UObhVO08jo8ioj": {
        "ClientId": "ordering-service",
        "Permissions": [ "payments.charge", "payments.refund" ]
      },
      "YvP7MCgN3pJZnM6K": {
        "ClientId": "payment-provider",
        "TenantId": "6c1d7e1a-3b52-4f8e-9a41-2f6b8c0d9e11",
        "Permissions": [ "payments.callback" ]
      }
    }
  }
}
