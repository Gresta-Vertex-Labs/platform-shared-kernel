{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",

  // Connections, certificates and the trusted client thumbprints come from the AppHost.
  "SharedKernel": {
    "Persistence": { "inventory": { "RowLevelSecurity": { "Enabled": true } } },
    "Security": {
      "Oidc": {
        "Audiences": [ "shop-api" ],
        "Claims": { "PermissionClaimTypes": [ "permissions" ] }
      }
    },
    // A signed claim first; the X-Tenant-Id header only from a caller authenticated by its certificate.
    "MultiTenancy": { "StrategyOrder": [ "Claim", "ServiceHeader" ] },
    "Scheduling": { "TickInterval": "00:00:01" }
  },
  "Inventory": {
    "Reconciliation": { "Cron": "0/2 * * * * ?" }
  }
}
