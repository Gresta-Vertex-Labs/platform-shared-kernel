{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",

  // Connections, object storage, the bus and Gotenberg come from the AppHost.
  "SharedKernel": {
    "Persistence": { "reports": { "RowLevelSecurity": { "Enabled": true } } },
    "Security": {
      "Oidc": {
        "Audiences": [ "shop-api" ],
        "Claims": { "PermissionClaimTypes": [ "permissions" ] }
      }
    },
    "MultiTenancy": { "StrategyOrder": [ "Claim" ] },
    "Messaging": { "ServiceName": "reports" },
    "Reporting": { "Pdf": { "Landscape": true } }
  }
}
