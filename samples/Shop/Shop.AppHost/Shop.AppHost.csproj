<Project Sdk="Aspire.AppHost.Sdk/13.6.0">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>shop-apphost</UserSecretsId>
    <!-- The dashboard and orchestrator come from their NuGet packages; the Aspire CLI bundle is not used. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <!-- The services the AppHost runs; Aspire generates Projects.* from these references. -->
  <ItemGroup>
    <ProjectReference Include="..\Catalog\Shop.Catalog.Api\Shop.Catalog.Api.csproj" />
    <ProjectReference Include="..\Inventory\Shop.Inventory.Api\Shop.Inventory.Api.csproj" />
    <ProjectReference Include="..\Ordering\Shop.Ordering.Api\Shop.Ordering.Api.csproj" />
    <ProjectReference Include="..\Billing\Shop.Billing.Api\Shop.Billing.Api.csproj" />
    <ProjectReference Include="..\Merchant\Shop.Merchant.Api\Shop.Merchant.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Ollama" />
    <!-- Creates the MinIO buckets once MinIO is ready. -->
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>
</Project>
