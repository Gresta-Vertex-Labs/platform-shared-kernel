{
  "realm": "shop",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "customer" },
      { "name": "merchant" },
      { "name": "operator" }
    ]
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\":\"ADMIN_EDIT\",\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "shop-web",
      "name": "Shop storefront and end-to-end tests",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [ "http://localhost/*" ],
      "webOrigins": [ "+" ],
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "audience shop-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "shop-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "permissions",
            "claim.name": "permissions",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "multivalued": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "multivalued": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@contoso.example",
      "firstName": "Alice",
      "lastName": "Contoso",
      "enabled": true,
      "emailVerified": true,
      "credentials": [ { "type": "password", "value": "Shop-dev-1!", "temporary": false } ],
      "realmRoles": [ "merchant" ],
      "attributes": {
        "tenant_id": [ "6c1d7e1a-3b52-4f8e-9a41-2f6b8c0d9e11" ],
        "permissions": [
          "catalog.read",
          "catalog.manage",
          "orders.place",
          "orders.read",
          "orders.cancel",
          "reports.export",
          "inventory.read",
          "inventory.manage",
          "billing.read",
          "billing.manage"
        ]
      }
    },
    {
      "username": "bruno",
      "email": "bruno@fabrikam.example",
      "firstName": "Bruno",
      "lastName": "Fabrikam",
      "enabled": true,
      "emailVerified": true,
      "credentials": [ { "type": "password", "value": "Shop-dev-1!", "temporary": false } ],
      "realmRoles": [ "merchant" ],
      "attributes": {
        "tenant_id": [ "b2f4a6c8-1d3e-4a5b-8c7d-9e0f1a2b3c4d" ],
        "permissions": [ "catalog.read", "catalog.manage", "orders.place", "orders.read", "inventory.read", "inventory.manage", "billing.read", "billing.manage" ]
      }
    },
    {
      "username": "carol",
      "email": "carol@contoso.example",
      "firstName": "Carol",
      "lastName": "Contoso",
      "enabled": true,
      "emailVerified": true,
      "credentials": [ { "type": "password", "value": "Shop-dev-1!", "temporary": false } ],
      "realmRoles": [ "customer" ],
      "attributes": {
        "tenant_id": [ "6c1d7e1a-3b52-4f8e-9a41-2f6b8c0d9e11" ],
        "permissions": [ "catalog.read", "orders.place", "orders.read" ]
      }
    }
  ]
}
