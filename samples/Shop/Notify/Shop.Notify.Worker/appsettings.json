{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",

  // The bus, the providers' addresses and credentials come from the AppHost.
  "SharedKernel": {
    "Messaging": { "ServiceName": "notify" },
    "Integration": { "Notifications": { "MaxAttempts": 3 } }
  },
  "Notify": {
    "Sender": { "Address": "receipts@shop.example", "DisplayName": "Shop" },
    "ReceiptTemplateId": "d-shop-receipt",
    "MerchantTextTemplateId": "HXshoppaidorder"
    // MerchantPhones:{tenantId}: who to text when one of a tenant's orders is paid (set by the AppHost).
  }
}
