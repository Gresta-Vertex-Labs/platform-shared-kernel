<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Sample code is held to the same bar as shipped code. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Domain: the aggregate, its value objects, ids and events. It references ONE kernel package,
    SharedKernel.Domain (Model tier), which brings the Foundation packages it is built on
    (Primitives, Core, Execution). No other project of this service, no application contracts, no
    adapter, no host package, no ASP.NET Core. OrderApi.Tests/ArchitectureTests asserts exactly this.

    Deliberately PackageReference, not ProjectReference: the samples prove the *packed* packages work
    for an outside consumer. See samples/README.md.
  -->
  <ItemGroup>
    <PackageReference Include="SharedKernel.Domain" />
  </ItemGroup>

</Project>
