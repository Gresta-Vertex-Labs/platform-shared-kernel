<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <!-- Sample code is held to the same bar as shipped code. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Deliberately PackageReference, not ProjectReference. This sample exists to prove the
    *packed* SharedKernel packages work for an outside consumer resolving them from a feed.
    A ProjectReference would bypass exactly the thing under test, which is why this project
    is excluded from Platform.SharedKernel.slnx and built by CI's packaging-verify job
    after `dotnet pack` — the same pattern the consumer-verify harnesses use.
  -->
  <ItemGroup>
    <PackageReference Include="SharedKernel.Primitives" />
    <PackageReference Include="SharedKernel.Domain" />
    <PackageReference Include="SharedKernel.Application" />
    <PackageReference Include="SharedKernel.Application.Pipeline" />
    <PackageReference Include="SharedKernel.Application.Mediator.MediatR" />
    <PackageReference Include="SharedKernel.Validation.FluentValidation" />
    <PackageReference Include="SharedKernel.Presentation.WebApi" />
    <PackageReference Include="SharedKernel.ServiceDefaults" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

</Project>
