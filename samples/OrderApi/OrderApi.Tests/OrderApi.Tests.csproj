<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Tests of the OrderApi sample, in three kinds:
      - ArchitectureTests: the four-project shape (which project references which project and which
        kernel packages), read from this assembly's own deps.json, so it sees the real restore graph
        including transitive packages;
      - PlaceOrderTests: the application layer through the real kernel pipeline, with the packed
        SharedKernel.Application.Testing harness and SharedKernel.Testing's FakeClock;
      - HttpTests: the real Program over HTTP (WebApplicationFactory).
    No Docker, no database.
  -->
  <ItemGroup>
    <ProjectReference Include="..\OrderApi.Api\OrderApi.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharedKernel.Application.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
