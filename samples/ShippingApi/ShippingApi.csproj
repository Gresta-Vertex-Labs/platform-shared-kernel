<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <!-- Sample code is held to the same bar as shipped code. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Deliberately PackageReference, not ProjectReference: this service proves the *packed* messaging
    packages work for an outside consumer. Excluded from Platform.SharedKernel.slnx and built after
    `dotnet pack` (see samples/README.md).
  -->
  <ItemGroup>
    <!-- 07.Messaging: the bus itself. Abstractions arrives transitively, as it would for any consumer. -->
    <PackageReference Include="SharedKernel.Messaging.MassTransit" />
    <!-- 04.Contracts: IIntegrationEvent and the CloudEvents envelope every published event is wrapped in. -->
    <PackageReference Include="SharedKernel.Contracts" />
    <!-- 05.Application.Abstractions: IRequestContext, which the tenant/actor propagation rides on. -->
    <PackageReference Include="SharedKernel.Application.Abstractions" />
    <!-- 13.ServiceDefaults: host, messaging telemetry, the bus readiness check. -->
    <PackageReference Include="SharedKernel.ServiceDefaults" />
    <PackageReference Include="SharedKernel.ServiceDefaults.Messaging" />
    <!-- 14.Presentation: Result -> ProblemDetails at the HTTP boundary. -->
    <PackageReference Include="SharedKernel.Presentation.WebApi" />
  </ItemGroup>

</Project>
