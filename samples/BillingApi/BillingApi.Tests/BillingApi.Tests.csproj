<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    End-to-end tests of the BillingApi sample: the real Program over HTTP (WebApplicationFactory) against a real
    PostgreSQL with the production role split, provisioned by the packed SharedKernel.Persistence.Testing package.
    Docker must be running.
  -->
  <ItemGroup>
    <ProjectReference Include="..\BillingApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharedKernel.Persistence.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
