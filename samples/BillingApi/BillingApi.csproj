<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <!-- Sample code is held to the same bar as shipped code. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Deliberately PackageReference, not ProjectReference: this service proves the *packed* persistence packages
    work for an outside consumer that has only the published artifacts. It is excluded from
    Platform.SharedKernel.slnx and built after `dotnet pack` (see samples/README.md).
  -->
  <ItemGroup>
    <!-- 06.Persistence: the whole stack -->
    <PackageReference Include="SharedKernel.Persistence.EfCore" />
    <PackageReference Include="SharedKernel.Persistence.EfCore.Auditing" />
    <PackageReference Include="SharedKernel.Persistence.EfCore.Encryption" />
    <PackageReference Include="SharedKernel.Persistence.Dapper" />
    <!-- 05.Application: MediatR pipeline with transaction, auditing and authorization -->
    <PackageReference Include="SharedKernel.Application" />
    <PackageReference Include="SharedKernel.Application.Behaviors" />
    <!-- 13.ServiceDefaults: host, IRequestContext over 12.Security, persistence readiness -->
    <PackageReference Include="SharedKernel.ServiceDefaults" />
    <PackageReference Include="SharedKernel.ServiceDefaults.Security" />
    <PackageReference Include="SharedKernel.ServiceDefaults.Persistence" />
    <PackageReference Include="SharedKernel.Security.Abstractions" />
    <!-- 14.Presentation: Result -> ProblemDetails -->
    <PackageReference Include="SharedKernel.Presentation.WebApi" />
    <PackageReference Include="SharedKernel.Cryptography" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
