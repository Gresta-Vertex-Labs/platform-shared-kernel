{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Production shape. Every secret below is empty on purpose: supply it from a secret store or environment
  // variables (ConnectionStrings__billing, SharedKernel__Persistence__Auditing__Keys__k1__Material, ...).
  // Startup validation fails when one is missing.
  "ConnectionStrings": {
    "billing": "",        // app_runtime: no superuser, no BYPASSRLS, owns nothing
    "audit-sealer": ""    // app_audit_sealer: writes the audit chain links
  },
  "SharedKernel": {
    "Persistence": {
      "ServiceName": "billing-api",
      "billing": {
        "MigrationConnectionString": "",                              // app_migrator: owns the tables
        "RowLevelSecurity": { "CrossTenantConnectionString": "" }     // app_cross_tenant: back office, maintenance
      },
      "audit-sealer": { "ConnectionStringName": "audit-sealer" },
      "Auditing": {
        "CurrentKeyId": "k1",
        "Keys": { "k1": { "Material": "", "Order": 1 } },
        "Sealer": { "DataSourceName": "audit-sealer", "Interval": "00:00:02" },
        "SelfCheck": "Fail"
      },
      "Encryption": {
        "Keys": { "CurrentKeyId": "root-1", "Keys": { "root-1": "" } },
        "BlindIndexKeys": { "CurrentVersion": "v1", "Keys": { "v1": "" } }
      }
    }
  },
  "Billing": {
    "MasterKey": { "KeyId": "local-master/v1", "Material": "" }
  }
}
